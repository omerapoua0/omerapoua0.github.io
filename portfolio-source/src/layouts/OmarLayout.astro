---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/omar.css';
import '../styles/nocturne.css';
import '../styles/editorial.css';
interface Props { title: string; description?: string; home?: boolean; }
const {title, description = 'Omar Aboelella. AI product engineering, multi-agent systems, business automation and online maths and science tutoring. Based in London.', home = false} = Astro.props;
const path = Astro.url.pathname;
const links = [['Home','/index.html'],['Projects','/work.html'],['Automations','/automations.html'],['Research','/research.html'],['About & CV','/cv.html'],['Tutoring','/tutoring.html']];
const active = (href: string) => path === href || (href === '/index.html' && path === '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | Omar Aboelella</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151515" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, 'https://omerapoua0.github.io').href} />
    <meta property="og:title" content={`${title} | Omar Aboelella`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://omerapoua0.github.io/hero-editorial-poster.jpg" />
    <meta property="og:image:alt" content="Cinematic editorial film connecting technology, mathematics and London" />
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Omar Aboelella',jobTitle:'AI Product Engineer',url:'https://omerapoua0.github.io',sameAs:['https://github.com/omerapoua0'],knowsAbout:['AI product engineering','Python','LangGraph','Multi-agent systems','Business automation','Mathematics'],homeLocation:{'@type':'City',name:'London'}})} />
    <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('omar-theme')||'dark'}catch{document.documentElement.dataset.theme='dark'} document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={[home ? 'is-home' : 'is-page']}>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/index.html" aria-label="Omar Aboelella home"><span class="wordmark-name">OMAR ABOELELLA</span></a>
      <nav class="site-nav" id="site-navigation" aria-label="Main navigation">{links.map(([label, href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions"><button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Change colour theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button><a class="header-contact" href="/contact.html">Let’s talk <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-navigation"><span></span><span></span></button></div>
    </header>
    <main id="main" class:list={[home ? 'home-main' : 'page-shell']}><slot /></main>
    <footer class="site-footer"><div><a class="footer-title" href="/contact.html">Have something<br/>in mind? <span>Let’s build it.</span> ↗</a><a class="footer-email" href="mailto:omerapoua0@gmail.com">omerapoua0@gmail.com</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Omar Aboelella</span><span>London · Available worldwide</span><a href="/Omar-Aboelella-CV.pdf" target="_blank" rel="noopener">Download CV ↗</a><a href="https://github.com/omerapoua0" target="_blank" rel="noopener">GitHub ↗</a><a href="/THIRD-PARTY-NOTICES.txt">Credits</a></div></footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
