---
import '@fontsource-variable/onest/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/old-standard-tt/latin-400-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import OttoCover from '../components/OttoCover.astro';
import { site } from '../data/site';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import serifItalic from '@fontsource/old-standard-tt/files/old-standard-tt-latin-400-italic.woff2?url';

/* cover: Otto's hand-off cover for an inside tour (the homepage gets the blank one). */
interface Props { title: string; description?: string; home?: boolean; image?: string; noindex?: boolean; cover?: { id: string; name: string; media?: string } }
const { title, description = site.description, home = false, image = '/portrait-hero.jpg', noindex = false, cover } = Astro.props;
const path = Astro.url.pathname === '/' ? '/index.html' : Astro.url.pathname;
const fullTitle = home ? `${site.name} | ${title}` : `${title} | ${site.name}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'AI Product Engineer',
  worksFor: { '@type': 'Organization', name: 'Digis Squared' },
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: [site.github],
  knowsAbout: ['AI product engineering', 'Agentic systems', 'LangGraph', 'Bayesian inference', 'Time-series forecasting', 'Mathematics', 'Maths and science tutoring'],
  homeLocation: { '@type': 'City', name: 'London' },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f2ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d11" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(path, site.url).href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, site.url).href} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:image:alt" content="Portrait of Omar Aboelella" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Before first paint: theme, Pause motion, and Otto's hand-off arrival.
         html[data-arrive="portal"]: a hand-off to this tour (sessionStorage otto-handoff {id, t}, < 10 s, matching path)
         paints OttoCover at first paint; "return": "Back to Otto" (otto-return) on the homepage. The cover carries
         these page changes in every browser, so a native cross-document view transition is skipped for them. -->
    <script is:inline>
      (function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('omar-theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch(e){}
      try{var m=sessionStorage.getItem('omar-motion');if(m==='on'||m==='off')d.dataset.motion=m}catch(e){}
      try{var p=location.pathname,n=Date.now(),h=JSON.parse(sessionStorage.getItem('otto-handoff')||'null'),r=JSON.parse(sessionStorage.getItem('otto-return')||'null');sessionStorage.removeItem('otto-return');
      if(h&&n-h.t>=0&&n-h.t<10000&&p.indexOf('/inside/'+h.id)===0)d.dataset.arrive='portal';else if(r&&n-r.t>=0&&n-r.t<10000&&/^\/(index\.html)?$/.test(p))d.dataset.arrive='return'}catch(e){}
      var c=function(){return document.querySelector('[data-otto-cover][data-state]')},s=function(e){if(e.viewTransition){e.viewTransition.skipTransition();window.__ottoVT=(window.__ottoVT||'')+e.type+' '}};
      addEventListener('pagereveal',function(e){if(d.dataset.arrive||c())s(e)});addEventListener('pageswap',function(e){if(c())s(e)})})();
    </script>
  </head>
  <body class:list={[home ? 'is-home' : 'is-page']}>
    {(home || cover) && <OttoCover {...cover} />}
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader overHero={home} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <CommandPalette />
    <script>import '../scripts/site';</script>
    <script>import '../scripts/previews';</script>
    <script>import '../scripts/cursor';</script>
    <script>import '../scripts/fx';</script>
    <script>import '../scripts/hero-motion';</script>
    <script>import '../scripts/otto-stage';</script>
  </body>
</html>
