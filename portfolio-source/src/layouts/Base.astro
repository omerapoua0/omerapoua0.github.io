---
import { SHARE_CARD } from '../data/robot';
import '@fontsource-variable/onest/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/studio.css';
import '../styles/neon.css';
import '../styles/tier.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import LightGate from '../components/LightGate.astro';
import { site } from '../data/site';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';

interface Props { title: string; description?: string; home?: boolean; image?: string; noindex?: boolean }
const { title, description = site.description, home = false, image = SHARE_CARD.src, noindex = false } = Astro.props;
const path = Astro.url.pathname === '/' ? '/index.html' : Astro.url.pathname;
const fullTitle = home ? `${site.name} | ${title}` : `${title} | ${site.name}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'AI Product Engineer',
  worksFor: { '@type': 'Organization', name: 'Digis Squared' },
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: [site.github, site.linkedin],
  knowsAbout: ['AI product engineering', 'Technology selection', 'Technical & security audits', 'Business & product strategy', 'Agentic systems', 'LangGraph', 'Bayesian inference', 'Time-series forecasting', 'Mathematics', 'Maths and science tutoring'],
  homeLocation: { '@type': 'City', name: 'London' },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080b" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(path, site.url).href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, site.url).href} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:image:alt" content={image === SHARE_CARD.src ? SHARE_CARD.alt : 'Portrait of Omar Aboelella'} />
    {image === SHARE_CARD.src && <><meta property="og:image:width" content={String(SHARE_CARD.width)} /><meta property="og:image:height" content={String(SHARE_CARD.height)} /><meta property="og:image:type" content="image/png" /><meta name="twitter:image" content={SHARE_CARD.src} /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Before first paint: arrival through the light gate.
         sessionStorage omar-gate {t, path, label, m}: written by gate.ts just before
         it navigates; fresh (< 8 s) and for this path, it marks html[data-gate="in"]
         (plus data-gate-mode="quick" for ordinary links) so LightGate paints its
         opaque layer on the first frame (white after an open, dark after a quick
         change) and then dissolves it. -->
    <!-- Capability tier (v9), before first paint: html[data-tier="lite"] on a
         genuinely weak device or a data-saving/very slow connection (deviceMemory <= 2 GB,
         <= 2 cores, Save-Data, effectiveType slow-2g/2g), else "full". (v9 used
         <= 4 GB / <= 4 cores / 3g, which caught good phones: Chrome reports 4 GB
         for many, and mobile '3g' estimates are noisy.) Apple
         WebKit caps hardwareConcurrency for privacy (and has no deviceMemory),
         so the core count is not a signal there. ?tier=lite|full overrides it for
         the rest of the session (QA). Lite: no robot clips, cursor, tilt, pins,
         backdrop blur or heavy loops (see tier.css). -->
    <script is:inline>
      (function(){var d=document.documentElement,n=navigator,c=n.connection||{},q=/[?&]tier=(lite|full)\b/.exec(location.search),t=q?q[1]:'';
      try{if(q)sessionStorage.setItem('omar-tier',t);else t=sessionStorage.getItem('omar-tier')||''}catch(e){}
      if(t!=='lite'&&t!=='full')t=(n.deviceMemory&&n.deviceMemory<=2)||(!/iP(hone|ad|od)|Macintosh/.test(n.userAgent)&&n.hardwareConcurrency&&n.hardwareConcurrency<=2)||c.saveData||/^(slow-2g|2g)$/.test(c.effectiveType||'')?'lite':'full';
      d.dataset.tier=t})();
    </script>
    <script is:inline>
      (function(){var d=document.documentElement;d.classList.add('js');
      try{var g=JSON.parse(sessionStorage.getItem('omar-gate')||'null'),p=location.pathname==='/'?'/index.html':location.pathname,n=Date.now();sessionStorage.removeItem('omar-gate');
      if(g&&n-g.t>=0&&n-g.t<8000&&g.path===p){d.dataset.gate='in';if(g.m==='quick')d.dataset.gateMode='quick';d.style.setProperty('--gate-label',JSON.stringify(String(g.label||'').slice(0,40)))}}catch(e){}})();
    </script>
  </head>
  <body class:list={[home ? 'is-home' : 'is-page']}>
    <LightGate />
    <slot name="overlay" />
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <CommandPalette />
    <script>import '../scripts/site';</script>
    <script>import '../scripts/gate';</script>
    <script>import '../scripts/previews';</script>
    <script>import '../scripts/cursor';</script>
    <script>import '../scripts/fx';</script>
    <script>import '../scripts/scrub';</script>
  </body>
</html>

