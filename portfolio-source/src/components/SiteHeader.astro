---
/* Dark glass header. Contact is always one tap away: the blue pill here on
   every width, plus a floating pill on phones once the header scrolls off
   (Base.astro). Search (⌘K) opens the command menu. */
import { navigation, site } from '../data/site';
const path = Astro.url.pathname === '/' ? '/index.html' : Astro.url.pathname;
---
<header class="header" data-header>
  <div class="header__inner">
    <a class="brand" href="/index.html" aria-current={path === '/index.html' ? 'page' : undefined}>
      <span class="brand__mark" aria-hidden="true"><i></i></span>
      <span class="brand__text">
        <span class="brand__name">Omar Aboelella</span>
        <span class="brand__meta">AI · Maths · Lessons</span>
      </span>
    </a>
    <nav class="nav" id="site-nav" aria-label="Main" data-nav>
      <ol class="nav__list">
        {navigation.map((item, index) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}><span class="nav__num" aria-hidden="true">0{index + 1}</span>{item.label}</a></li>
        ))}
        <li class="nav__sheet-only"><a href="/contact.html" aria-current={path === '/contact.html' ? 'page' : undefined}><span class="nav__num" aria-hidden="true">0{navigation.length + 1}</span>Contact</a></li>
      </ol>
      <div class="nav__sheet-foot nav__sheet-only">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href="/Omar-Aboelella-CV.pdf" target="_blank" rel="noopener">CV (PDF) ↗</a>
      </div>
    </nav>
    <div class="header__actions">
      <button class="kbd-btn" type="button" data-palette-open hidden aria-label="Open command menu" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" title="Search pages and projects">
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <kbd data-palette-key aria-hidden="true">Ctrl K</kbd>
      </button>
      <a class="header__cta" href="/contact.html" data-open aria-current={path === '/contact.html' ? 'page' : undefined}><span class="header__cta-dot" aria-hidden="true"></span>Contact</a>
      <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-controls="site-nav"><span data-menu-label>Menu</span><span class="menu-btn__bars" aria-hidden="true"></span></button>
    </div>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; height: var(--header); background: color-mix(in srgb, var(--bg-2) 78%, transparent); -webkit-backdrop-filter: saturate(1.4) blur(16px); backdrop-filter: saturate(1.4) blur(16px); border-bottom: 1px solid transparent; color: var(--ink); transition: border-color var(--d-3) var(--ease-out), box-shadow var(--d-3) var(--ease-out), background-color var(--d-3); }
  .header[data-scrolled], .header[data-open] { border-color: var(--line); box-shadow: 0 8px 30px -18px #00000099; background: color-mix(in srgb, var(--bg-2) 92%, transparent); }
  .header__inner { height: 100%; max-width: var(--max); margin-inline: auto; padding-inline: var(--margin); display: flex; align-items: center; gap: var(--s-5); }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; line-height: 1.1; margin-right: auto; min-height: 44px; }
  .brand__mark { position: relative; flex: none; width: 34px; height: 34px; border-radius: 50%; background: radial-gradient(circle at 36% 28%, #4a5263 0, #1d222c 18%, #07080b 62%); box-shadow: inset 4px 0 5px -3px #ff2d46, inset -4px 0 6px -3px #2f6bff, 0 0 0 1px #ffffff1a, -4px 0 14px -6px #ff2d4699, 4px 0 14px -6px #2f6bffaa; }
  .brand__mark i { position: absolute; left: 24%; right: 24%; top: 47%; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #ff2d46, #e6eeff, #2f6bff); box-shadow: 0 0 6px #4d84ff; }
  .brand__text { display: flex; flex-direction: column; }
  .brand__name { font-weight: 660; letter-spacing: -.03em; font-size: 16.5px; }
  .brand__meta { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .nav__list { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: color-mix(in srgb, var(--surface) 70%, transparent); border: 1px solid var(--line); }
  .nav__list a { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 14px; border-radius: 999px; font-size: 14px; font-weight: 520; text-decoration: none; position: relative; transition: background-color var(--d-2), color var(--d-2); }
  .nav__list a:hover { background: var(--bg); color: var(--accent); }
  .nav__list a[aria-current='page'] { background: var(--ink); color: var(--bg); }
  .nav__list a, .brand__name { white-space: nowrap; }
  .nav__num { font-family: var(--font-mono); font-size: 10px; color: var(--muted); }
  /* Six sections plus Contact: on narrower desktops, drop the numbers, the
     brand tagline and the shortcut hint so everything stays on one line. */
  @media (min-width: 1100px) and (max-width: 1299px) {
    .nav__num, .brand__meta { display: none; }
    .kbd-btn kbd { display: none; }
    .kbd-btn { padding: 0; }
    .nav__list a { padding: 0 12px; }
  }
  .nav__list a[aria-current='page'] .nav__num { color: #4a5160; }
  .nav__sheet-only { display: none; }
  .header__actions { display: flex; align-items: center; gap: var(--s-2); }
  .kbd-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; min-width: 44px; justify-content: center; padding: 0 12px; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 70%, transparent); color: var(--ink); }
  .kbd-btn[hidden] { display: none; }
  .kbd-btn kbd { font-family: var(--font-mono); font-size: 11px; letter-spacing: .02em; color: var(--muted); }
  .kbd-btn:hover { border-color: var(--accent); color: var(--accent); }
  @media (hover: none), (max-width: 699px) { .kbd-btn kbd { display: none; } .kbd-btn { padding: 0; } }
  .header__cta { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; background: var(--accent-fill); color: #fff; font-size: 14px; font-weight: 600; text-decoration: none; box-shadow: 0 8px 22px -10px var(--accent-glow); transition: background-color var(--d-2), box-shadow var(--d-3); }
  .header__cta:hover { background: var(--accent-hover); box-shadow: 0 10px 28px -8px var(--accent-glow); }
  .header__cta-dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px #ffffff40; }
  .menu-btn { display: none; align-items: center; gap: 10px; min-height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 70%, transparent); font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .menu-btn__bars { position: relative; width: 16px; height: 8px; }
  .menu-btn__bars::before, .menu-btn__bars::after { content: ''; position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; transition: transform var(--d-3) var(--ease-out); }
  .menu-btn__bars::before { top: 0; }
  .menu-btn__bars::after { bottom: 0; }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::before { transform: translateY(3.25px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-btn__bars::after { transform: translateY(-3.25px) rotate(-45deg); }

  @media (max-width: 1099px) {
    :global(html.js) .menu-btn { display: inline-flex; }
    :global(html.js) .nav { position: fixed; inset: var(--header) 0 0; z-index: 49; display: flex; flex-direction: column; justify-content: space-between; padding: var(--s-6) var(--margin) calc(var(--s-6) + env(safe-area-inset-bottom)); background: var(--bg-2); color: var(--ink); overflow-y: auto; visibility: hidden; opacity: 0; transform: translateY(-8px); transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out), visibility 0s linear var(--d-3); }
    :global(html.js) .nav.is-open { visibility: visible; opacity: 1; transform: none; transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out); }
    :global(html.js) .nav__list { flex-direction: column; gap: 0; padding: 0; border: 0; background: none; border-radius: 0; }
    :global(html.js) .nav__list li { border-bottom: 1px solid var(--line); }
    :global(html.js) .nav__list a { width: 100%; min-height: 64px; padding: 0; border-radius: 0; font-size: clamp(28px, 8vw, 44px); font-weight: 600; letter-spacing: -.04em; gap: 14px; background: none; }
    :global(html.js) .nav__list a[aria-current='page'] { color: var(--accent); background: none; }
    :global(html.js) .nav__num { font-size: 12px; }
    :global(html.js) .nav__sheet-only { display: block; }
    :global(html.js) .nav__sheet-foot { display: grid; gap: var(--s-2); margin-top: var(--s-7); font-size: var(--step-small); }
    :global(html.js) .nav__sheet-foot a { min-height: 44px; display: inline-flex; align-items: center; }
    /* Without JavaScript the navigation stays reachable as a scrollable row. */
    :global(html:not(.js)) .header { height: auto; }
    :global(html:not(.js)) .header__inner { flex-wrap: wrap; padding-block: 8px; }
    :global(html:not(.js)) .nav { order: 3; width: 100%; overflow-x: auto; }
    :global(html:not(.js)) .nav__list { width: max-content; }
  }
  @media (max-width: 480px) { .brand__meta { display: none; } .brand__name { white-space: nowrap; } .menu-btn [data-menu-label] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .menu-btn { width: 44px; padding: 0; justify-content: center; } .brand__name { font-size: 15px; } .header__inner { gap: 10px; } .header__cta { padding: 0 14px; } .brand__mark { width: 30px; height: 30px; } }
  @media (max-width: 374px) { .brand__text { display: none; } }
</style>
