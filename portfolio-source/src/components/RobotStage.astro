---
/* The hero robot: Otto, Omar's robot (the site's mascot, not Omar; a
   glossy black humanoid with red neon contour lines and a red ring emitter
   on the side of its head, generated for Omar with Higgsfield). Media and
   timings live in src/data/robot.ts (remote on Higgsfield's CDN; files in
   public/robot/ override them at build time).

   Layers, back to front:
   - the PLACEHOLDER orb (an abstract glossy black sphere with red/blue rim
     light and neon orbit rings, CSS only). It is the fallback: it shows
     while the still loads and stays if it fails (CDN down, URL gone); the
     <img>'s inline onload/onerror set data-poster on the stage;
   - the robot (aria-hidden): the ROBOT still <img> (with JavaScript painted
     into a canvas, see below) with the gesture <video>s over it (WAVE,
     HEART, LOOK; fetched only on intent), edges
     dissolved into the page by a soft mask, plus light layers: a
     pointer-following light, the red neon and ring glow pulsing, the haze;
   - a real <button> over the figure, "Say hi to Otto, Omar's robot": each
     press plays his next move, WAVE → HEART → LOOK (0 → 1.6 s, then holds,
     facing you). Its focus ring is a HUD frame around the head (an outline
     in forced colours);
   - "Replay intro" (homepage intro, intro.ts) and the Sound switch for
     Otto's voice (v10, SoundToggle + scripts/voice.ts; default off), top
     right, shown only with JavaScript; with Sound on, WAVE says HELLO and
     HEART says THANKS, captioned in a HUD bubble by his head (aria-live).
   robot.ts: no autoplay (the homepage intro is the greeting); a breathing
   idle; fine pointers turn it toward the pointer (spring-smoothed 3D tilt),
   touch gets a slow ambient sway. No H.264 or a failed/stalled video: the
   still stays and every interaction still works on it. */
import { existsSync } from 'node:fs';
import path from 'node:path';
import { robot, gestures, ROBOT_LABEL, ROBOT_NAME, LOOK, RING } from '../data/robot';
import SoundToggle from './SoundToggle.astro';
interface Props { class?: string }
const { class: className } = Astro.props;
const local = (file: string) => existsSync(path.join(process.cwd(), 'public/robot', file));
const poster = local('robot.webp') ? '/robot/robot.webp' : robot.still.src;
const lookMp4 = local('look.mp4') ? '/robot/look.mp4' : robot.look.mp4;
const lookWebm = local('look.webm') ? '/robot/look.webm' : undefined;
/* v9 moves (src/data/robot.ts): only those with a clip (remote or local). */
const moves = (['wave', 'heart'] as const).map(name => ({
  name,
  mp4: local(`${name}.mp4`) ? `/robot/${name}.mp4` : gestures[name].mp4,
  webm: local(`${name}.webm`) ? `/robot/${name}.webm` : undefined,
  fit: gestures[name].fit,
})).filter(move => move.mp4 || move.webm);
const fitStyle = (f: { s: number; dx: number; dy: number }) => (f.s === 1 && !f.dx && !f.dy ? undefined : `transform:translate(${(f.dx / 13.44).toFixed(2)}%,${(f.dy / 7.52).toFixed(2)}%) scale(${f.s})`);
const stage = "this.closest('[data-robot-stage]')";
---
<div class:list={['robot-stage', className]} data-robot-stage data-poster="loading">
  {/* PLACEHOLDER and fallback: shown only until the poster has loaded. */}
  <div class="orb" data-orb aria-hidden="true">
    <div class="orb__tilt">
      <span class="orb__ring orb__ring--a"><i></i></span>
      <span class="orb__ring orb__ring--b"><i></i></span>
      <span class="orb__sphere">
        <span class="orb__shade"></span>
        <span class="orb__sweep"></span>
        <span class="orb__slit"></span>
        <span class="orb__spec"></span>
      </span>
    </div>
  </div>
  <div class="robot-stage__media" aria-hidden="true">
    <div class="robot__tilt" data-robot-tilt>
      <div class="robot__breath">
        <div class="robot__frame"><div class="robot__canvas">
          <img class="robot__poster" src={poster} alt="" width={robot.still.width} height={robot.still.height} loading="eager" decoding="async" fetchpriority="low" onload={`${stage}.dataset.poster='ok'`} onerror={`${stage}.dataset.poster='failed'`} />
          {moves.map(move => (
            <video class="robot__video" data-robot-video={move.name} style={fitStyle(move.fit)} muted playsinline preload="none" tabindex="-1" disablepictureinpicture disableremoteplayback>
              {move.webm && <source data-src={move.webm} type="video/webm" />}
              {move.mp4 && <source data-src={move.mp4} type="video/mp4" />}
            </video>
          ))}
          <video class="robot__video" data-robot-video="look" data-hold={LOOK.hold} muted playsinline preload="none" tabindex="-1" disablepictureinpicture disableremoteplayback>
            {lookWebm && <source data-src={lookWebm} type="video/webm" />}
            <source data-src={lookMp4} type="video/mp4" />
          </video>
          <span class="robot__beam"></span>
          <span class="robot__neon" style={`--ring-x:${RING.still.x}%;--ring-y:${RING.still.y}%`}></span>
          <span class="robot__light"></span>
        </div></div>
      </div>
    </div>
  </div>
  <button class="robot-stage__hit" type="button" aria-label={ROBOT_LABEL} data-robot-hi data-cursor-label="Say hi"><span class="robot-stage__focus" aria-hidden="true"></span></button>
  <span class="robot-stage__tag" aria-hidden="true"><b>{ROBOT_NAME}</b><span>Omar’s robot · say hi</span></span>
  <span class="sr-only" aria-live="polite" data-robot-said></span>
  <p class="robot-stage__caption" aria-live="polite" data-robot-caption></p>
  <div class="robot-stage__hud">
    <SoundToggle class="robot-stage__chip robot-stage__sound" lines="hello thanks" />
    <button class="robot-stage__chip robot-stage__replay" type="button" data-intro-replay hidden><span aria-hidden="true">↺</span> Replay intro</button>
  </div>
</div>

<script>import '../scripts/robot';</script>

<style>
  /* The stage has the media's own aspect (1344 × 752), so the overlays'
     percentages land on the robot. HomeHero sizes and places it. */
  .robot-stage { --size: 100%; position: relative; width: var(--size); aspect-ratio: 1344 / 752; isolation: isolate; }
  .robot-stage__media { position: absolute; inset: 0; pointer-events: none; transition: opacity 600ms var(--ease-out); }
  .robot__tilt, .robot__breath, .robot__frame { position: absolute; inset: 0; }
  /* Turned toward the pointer by robot.ts (--rx/--ry in degrees, spring
     smoothed), around the robot's chest. */
  .robot__tilt { transform-origin: 66% 60%; transform: perspective(1600px) rotateX(calc(var(--rx, 0) * 1deg)) rotateY(calc(var(--ry, 0) * 1deg)) translate3d(calc(var(--ry, 0) * -2px), calc(var(--rx, 0) * 1.5px), 0); }
  .robot__breath { transform-origin: 66% 100%; }
  /* Edges dissolve into the near-black page: a soft fade on every side
     (deepest at the bottom, where the figure is cut), intersected with a
     wide ellipse around the figure, so no rectangle edge ever shows. */
  .robot__frame { overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 92%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 9%, #000 62%, transparent 97%), radial-gradient(ellipse 72% 92% at 62% 40%, #000 52%, transparent 100%);
    -webkit-mask-composite: source-in, source-in;
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 92%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 9%, #000 62%, transparent 97%), radial-gradient(ellipse 72% 92% at 62% 40%, #000 52%, transparent 100%);
    mask-composite: intersect; }
  /* The canvas keeps the media's aspect, so the light layers stay on the
     robot when a narrower stage crops it (phones): it is anchored right, and
     --canvas-right shifts the crop. */
  .robot__canvas { position: absolute; top: 0; right: var(--canvas-right, 0%); height: 100%; aspect-ratio: 1344 / 752; }
  .robot__canvas :is(img, video), .robot__canvas :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* With JavaScript, robot.ts paints the decoded poster into a <canvas>
     (.robot__still) and fades that in: the third-party image is then never a
     Largest Contentful Paint candidate, so a slow CDN cannot hold the page's
     LCP back (the headline is). Without JavaScript, or if the canvas cannot
     be drawn (data-still="img"), the <img> itself shows. The canvas is made
     by script, so it has no scoped-style attribute: hence :global(). */
  .robot__poster, .robot__canvas :global(.robot__still) { opacity: 0; transition: opacity 700ms var(--ease-out); }
  :global(html:not(.js)) .robot__poster, .robot-stage[data-still='img'] .robot__poster, .robot-stage[data-still='canvas'] :global(.robot__still) { opacity: 1; }
  /* A clip is shown only while it really has frames: robot.ts sets data-on
     on it (and data-video="on" on the stage) on 'playing' (every move starts
     on the still, so the cut is invisible), and takes it away to cross-fade
     back to the still (WAVE and HEART end on it too). */
  .robot__video { opacity: 0; transition: opacity 220ms linear; }
  .robot-stage[data-video='on'] .robot__video[data-on] { opacity: 1; }
  /* Light layers, screen-blended over the robot. */
  .robot__canvas > span { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; }
  :global(html[data-tier='lite']) .robot__canvas > span { mix-blend-mode: normal; }
  /* A soft cool light that follows the pointer across the robot. */
  .robot__light { background: radial-gradient(circle 22vmax at var(--lx, 66%) var(--ly, 30%), #8fb0ff2e, #2f6bff14 40%, transparent 70%); opacity: 0; transition: opacity 600ms; }
  .robot-stage[data-pointer] .robot__light { opacity: 1; }
  /* Its neon seams (red on its left, blue on its right) and the beam from the
     top left, breathing gently. */
  .robot__neon { background: radial-gradient(circle at var(--ring-x) var(--ring-y), #ff2d4699 0, #ff2d4640 2.6%, transparent 6.5%), radial-gradient(ellipse 16% 22% at 64% 74%, #ff2d4633, transparent 70%); opacity: .5; }
  .robot__beam { background: radial-gradient(ellipse 30% 40% at 82% 48%, #ff2d4626, transparent 70%); opacity: .4; }

  /* The hit area covers the figure, not the copy beside it. */
  .robot-stage__hit { position: absolute; z-index: 2; pointer-events: auto; left: var(--hit-left, 44%); right: 4%; top: 2%; bottom: 8%; padding: 0; border: 0; border-radius: 28px; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .robot-stage__hit:focus-visible { outline: 2px solid transparent; outline-offset: -6px; }
  @media (forced-colors: active) { .robot-stage__hit:focus-visible { outline: 3px solid CanvasText; } }
  .robot-stage__focus { position: absolute; left: 20%; right: 22%; top: 0; height: 62%; background: var(--hud); --hl: 16px; --hc: var(--accent); background-repeat: no-repeat; opacity: 0; transition: opacity 200ms; filter: drop-shadow(0 0 6px #2f6bffcc); }
  .robot-stage__hit:focus-visible .robot-stage__focus { opacity: 1; }

  .robot-stage__tag { position: absolute; right: 8%; bottom: 16%; z-index: 3; display: grid; gap: 2px; padding: 10px 14px; border-radius: 4px; background: #0b0d12cc; border: 1px solid var(--line-strong); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); pointer-events: none; }
  .robot-stage__tag::after, .robot-stage__caption::after { content: ''; position: absolute; inset: -5px; background: var(--hud); --hc: #ff4d62b3; --hl: 8px; background-repeat: no-repeat; pointer-events: none; }
  /* Top right: Sound (Otto's voice) and Replay intro; 36 px chips with a
     44 px tap area. */
  .robot-stage__hud { position: absolute; z-index: 3; right: 7%; top: 5%; display: flex; gap: 8px; pointer-events: none; }
  .robot-stage__hud :global(.robot-stage__chip) { position: relative; pointer-events: auto; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: 999px; background: #0b0d12b3; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: var(--ink-2); font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: border-color 200ms, color 200ms; }
  .robot-stage__hud :global(.robot-stage__chip)::before { content: ''; position: absolute; inset: -4px; }
  .robot-stage__hud :global(.robot-stage__chip[hidden]) { display: none; }
  .robot-stage__hud :global(.robot-stage__chip:hover) { border-color: var(--accent); color: var(--ink); }
  /* What Otto says (Sound on): a HUD bubble left of his head, for the
     line's length. */
  .robot-stage__caption { position: absolute; z-index: 3; left: 18%; top: 9%; max-width: 15rem; padding: 10px 14px; border: 1px solid #ff4d6259; border-radius: 4px; background: #0b0d12e6; font: 500 12.5px/1.4 var(--font-mono); pointer-events: none; opacity: 0; transition: opacity 260ms; }
  .robot-stage__caption[data-show] { opacity: 1; }
  .robot-stage__tag b { color: var(--accent); font-weight: 600; font-size: 12px; }

  /* The fallback orb sits where the robot's head and chest are. */
  .orb { position: absolute; left: 50%; top: 4%; width: 36%; transition: opacity 600ms var(--ease-out); }
  .robot-stage[data-still] .orb, :global(html:not(.js)) .orb { opacity: 0; visibility: hidden; transition: opacity 600ms var(--ease-out), visibility 0s 600ms; }
  .robot-stage[data-poster='failed'] .robot-stage__media { opacity: 0; }

  /* "The robot opens it": when a door is chosen (gate.ts sets data-opening)
     the robot flares, in step with the gate's light (≈ 300 ms). */
  .robot-stage[data-opening] .robot__breath { filter: brightness(1.7); transition: filter 300ms ease-in; }

  /* PLACEHOLDER: a glossy black sphere. Preserve-3D lets the neon rings pass
     in front of and behind it. */
  .orb { aspect-ratio: 1; perspective: 1400px; transform: translate3d(calc(var(--mx, 0) * -12px), calc(var(--my, 0) * -9px), 0); transition: transform 700ms var(--ease-out), opacity 600ms var(--ease-out); }
  .orb__tilt { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(calc(var(--my, 0) * -9deg)) rotateY(calc(var(--mx, 0) * 13deg)); transition: transform 800ms var(--ease-out); }
  .orb__sphere { position: absolute; inset: 17%; border-radius: 50%; overflow: hidden; transform: translateZ(0);
    background: radial-gradient(circle at 36% 26%, #4a5263 0, #1d222c 14%, #0d1016 34%, #050608 62%, #000 100%);
    box-shadow:
      inset 16px 4px 22px -12px #ff2d46e6,
      inset 3px 0 2px -1px #ff6b7d,
      inset -18px -2px 26px -12px #2f6bffee,
      inset -3px 0 2px -1px #8fb0ff,
      inset 0 -30px 40px -20px #000; }
  /* The outer red/blue glow is painted on a flat layer outside the
     preserve-3d subtree: large outer shadows inside it get clipped to a hard
     rectangle by the compositor. */
  .orb::before { content: ''; position: absolute; inset: 10%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side at 30% 56%, #ff2d4652, #ff2d461a 55%, transparent), radial-gradient(closest-side at 72% 44%, #2f6bff5c, #2f6bff1f 55%, transparent); }
  /* Rim light and the cool reflection of the beam on the gloss. */
  .orb__shade { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 80% 64%, #2f6bff33, transparent 36%), radial-gradient(circle at 16% 58%, #ff2d4626, transparent 34%), radial-gradient(120% 60% at 50% 120%, #e6eeff14, transparent 50%); }
  .orb__sweep { position: absolute; inset: -20%; background: linear-gradient(112deg, transparent 40%, #e6eeff0f 46%, #e6eeff38 50%, #e6eeff0f 54%, transparent 60%); transform: translateX(var(--sweep, -30%)); }
  .orb__spec { position: absolute; left: 24%; top: 13%; width: 30%; height: 15%; border-radius: 50%; background: radial-gradient(closest-side, #e6eeffcc, #e6eeff33 55%, #e6eeff00); transform: rotate(-26deg); }
  /* The visor slit: red to cool white to blue, the one hint of a machine. */
  .orb__slit { position: absolute; left: 22%; right: 22%; top: 47%; height: 4.5%; border-radius: 999px; background: linear-gradient(180deg, #000, #0b0e15 70%, #161b26); box-shadow: inset 0 1px 3px #000, 0 1px 0 #ffffff1f; overflow: hidden; }
  .orb__slit::before { content: ''; position: absolute; left: 6%; right: 6%; top: 42%; height: 16%; border-radius: 9px; background: linear-gradient(90deg, #ff2d4600, #ff2d46 18%, #e6eeff 50%, #2f6bff 82%, #2f6bff00); opacity: .55; box-shadow: 0 0 10px #4d84ff; }
  .orb__slit::after { content: ''; position: absolute; top: 18%; bottom: 18%; left: 0; width: 26%; border-radius: inherit; background: linear-gradient(90deg, transparent, #e6eeff, transparent); box-shadow: 0 0 14px #e6eeff; transform: translateX(var(--scan, 96%)); }
  .orb__ring { position: absolute; inset: 0; border-radius: 50%; transform-style: preserve-3d; }
  .orb__ring--a { transform: rotateX(74deg) rotateY(-8deg); }
  .orb__ring--b { inset: 7%; transform: rotateX(66deg) rotateY(24deg); }
  .orb__ring i { position: absolute; inset: 0; border-radius: 50%; border: 1px solid #4d84ff8c; box-shadow: 0 0 18px #2f6bff59, inset 0 0 18px #2f6bff33;
    background: conic-gradient(from 0deg, transparent 0 60%, #2f6bff 72%, #e6eeff 74%, transparent 80%);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
            mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px)); }
  .orb__ring--b i { border-color: #ff4d6273; box-shadow: 0 0 18px #ff2d4640, inset 0 0 18px #ff2d4626; background: conic-gradient(from 180deg, transparent 0 68%, #ff2d46 80%, #ffd6db 83%, transparent 90%); }

  /* "The robot opens it": when a door is chosen (gate.ts sets data-opening),
     the rings snap shut onto the sphere and the visor flares cool white, in
     step with the gate's neon hands (≈ 300 ms). */
  .orb__ring { transition: transform 300ms cubic-bezier(.7, 0, .3, 1), opacity 300ms; }
  .orb__slit { transition: background-color 200ms, box-shadow 300ms ease-out; }
  .robot-stage:is([data-opening], [data-poster='failed'][data-hi]) .orb__ring--a { transform: rotateX(90deg) rotateY(0deg) scale(.62); }
  .robot-stage:is([data-opening], [data-poster='failed'][data-hi]) .orb__ring--b { transform: rotateX(90deg) rotateY(0deg) scale(.7); }
  .robot-stage:is([data-opening], [data-poster='failed'][data-hi]) .orb__ring i { border-color: #e6eeff; box-shadow: 0 0 30px 6px #e6eeffcc, 0 0 60px 12px #2f6bff99; }
  .robot-stage:is([data-opening], [data-poster='failed'][data-hi]) .orb__slit { background: #e6eeff; box-shadow: 0 0 18px 6px #e6eeff, 0 0 60px 22px #e6eeffd9, 0 0 120px 40px #2f6bff80; }
  .robot-stage[data-opening] .robot-stage__media { filter: brightness(1.8); transition: filter 300ms ease-in; }


  /* The living idle: only without a reduced-motion preference. */
  @media (prefers-reduced-motion: no-preference) {
    .robot__breath { animation: robot-breathe 6.4s ease-in-out infinite; }
    .robot__neon { animation: robot-neon 4.8s ease-in-out infinite alternate; }
    .robot__beam { animation: robot-beam 9s ease-in-out infinite alternate; }
    .robot-stage[data-hi] .robot__neon { animation: robot-hi 900ms ease-out; }
    /* Touch (no hovering pointer): a slow ambient sway instead of the tilt. */
    @media (hover: none), (pointer: coarse) {
      .robot__tilt { animation: robot-sway 11s ease-in-out infinite alternate; }
    }
    .orb__sphere { animation: orb-float 7s ease-in-out infinite; }
    .orb__ring--a i { animation: orb-spin 9s linear infinite; }
    .orb__ring--b i { animation: orb-spin 13s linear infinite reverse; }
    .orb__slit::after { animation: orb-scan 4.6s cubic-bezier(.65, 0, .35, 1) infinite alternate; }
    .orb__sweep { animation: orb-sweep 8s cubic-bezier(.45, 0, .25, 1) infinite; }
    /* No loops behind a loaded poster. */
    .robot-stage[data-still] .orb :is(.orb__sphere, .orb__ring i, .orb__sweep), .robot-stage[data-still] .orb__slit::after { animation: none; }
    .robot-stage[data-poster='failed'] :is(.robot__breath, .robot__neon, .robot__beam, .robot__tilt) { animation: none; }
  }
  @keyframes robot-hi { 0% { opacity: .5; } 25% { opacity: 1; } 100% { opacity: .5; } }
  @keyframes robot-breathe { 0%, 100% { scale: 1; translate: 0 0; } 50% { scale: 1.014; translate: 0 -.5%; } }
  @keyframes robot-neon { from { opacity: .25; } to { opacity: .8; } }
  @keyframes robot-beam { from { opacity: .15; } to { opacity: .6; } }
  @keyframes robot-sway { from { transform: perspective(1600px) rotateY(-3deg) rotateX(.6deg); } to { transform: perspective(1600px) rotateY(3deg) rotateX(-.6deg); } }
  @keyframes orb-float { 0%, 100% { translate: 0 -7px; } 50% { translate: 0 9px; } }
  @keyframes orb-spin { to { transform: rotate(360deg); } }
  @keyframes orb-scan { from { transform: translateX(-10%); } to { transform: translateX(290%); } }
  @keyframes orb-sweep { 0%, 15% { transform: translateX(-45%); } 70%, 100% { transform: translateX(45%); } }
</style>
