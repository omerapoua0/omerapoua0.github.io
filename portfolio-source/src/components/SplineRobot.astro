---
/* The 21st.dev 3D robot (serafimcloud's "Spline Scene", MIT wrapper; scene by
   its Spline author, hosted on prod.spline.design). Loaded lazily by
   scripts/spline-robot.ts after first paint; Otto's SVG stands in when 3D is
   unavailable, blocked, saving data or with reduced motion. */
import Robot from './Robot.astro';
---
<div class="srobot" data-spline-robot data-scene="https://prod.spline.design/kZDDjO5HuC9GJUM2/scene.splinecode" data-state="loading">
  <canvas class="srobot__canvas" aria-hidden="true"></canvas>
  <p class="srobot__loading" aria-hidden="true"><span></span>Loading the 3D robot…</p>
  <div class="srobot__fallback"><Robot size="sm" label="Otto, Omar’s robot host" id="otto-fallback" /></div>
  <span class="srobot__beam" aria-hidden="true"></span>
  <p class="srobot__credit">3D robot: <a href="https://21st.dev/community/components/serafimcloud/splite" target="_blank" rel="noopener">21st.dev</a> · Spline</p>
</div>

<style>
  .srobot { position: relative; height: clamp(300px, 46vh, 460px); margin: -8px 0 -8px -24px; border-radius: 22px; overflow: hidden; background: radial-gradient(60% 60% at 50% 45%, #d9ff3f14, transparent 70%); }
  .srobot__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 600ms ease-out; }
  .srobot[data-state='ready'] .srobot__canvas { opacity: 1; }
  .srobot__loading { position: absolute; inset: auto 0 18px; display: flex; justify-content: center; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: #7d8277; }
  .srobot__loading span { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #ffffff26; border-top-color: #d9ff3f; animation: srobot-spin .8s linear infinite; }
  .srobot:not([data-state='loading']) .srobot__loading { display: none; }
  .srobot__fallback { position: absolute; inset: 0; display: none; place-items: center; }
  .srobot__fallback :global(.robot--sm) { width: 150px; }
  .srobot[data-state='fallback'] .srobot__fallback { display: grid; }
  .srobot__credit { position: absolute; right: 12px; bottom: 8px; font-size: 10.5px; color: #7d8277; }
  .srobot__credit a { color: inherit; }
  .srobot__beam { position: absolute; left: 55%; top: 46%; width: 70vw; height: 3px; border-radius: 3px; background: linear-gradient(90deg, #d9ff3f, #f4ffc2 40%, #d9ff3f00); box-shadow: 0 0 18px 4px #d9ff3f80; transform-origin: left center; transform: scaleX(0); opacity: 0; pointer-events: none; }
  .srobot::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 55% 45%, #d9ff3f55, transparent 60%); opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .srobot[data-pose='pew'] .srobot__beam { animation: srobot-beam 520ms cubic-bezier(.2, .8, .2, 1) both; }
    .srobot[data-pose='pew']::after, .srobot[data-pose='point']::after { animation: srobot-flash 500ms ease-out; }
  }
  @keyframes srobot-spin { to { transform: rotate(360deg); } }
  @keyframes srobot-beam { 0% { transform: scaleX(0); opacity: 1; } 55% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes srobot-flash { 40% { opacity: 1; } }
  @media (max-width: 999px) { .srobot { height: 300px; margin: 0 -8px; } }
</style>

<script>import '../scripts/spline-robot';</script>
