---
/* Homepage hero: who Omar is in one line, three calls to action, the robot,
   spec chips that count up, and four big doors underneath. Every fact comes
   from src/data or the CV. Doors are plain links (no JavaScript needed);
   gate.ts plays the light-gate open on them. */
import RobotStage from './RobotStage.astro';
import { caseStudies } from '../data/projects';
import { capabilities } from '../data/capabilities';

const skillCount = capabilities.reduce((sum, group) => sum + group.skills.length, 0);
const title = [
  { words: ['I', 'build', 'AI'] },
  { words: ['that', 'reasons.'] },
  { words: ['I', 'teach', 'the'], accent: false },
  { words: ['maths', 'behind', 'it.'], accent: true },
];
let wordIndex = 0;
const chips = [
  { value: 150, prefix: '~', label: 'beta users · NOOKBASE' },
  { value: 5, prefix: '', label: 'roles · AI, data, teaching' },
  { value: 3, prefix: '', label: 'certifications · IBM, Google, Microsoft' },
  { text: 'Birkbeck', label: 'BSc CS & Maths · expected 2028' },
];
const doors = [
  { id: 'work', label: 'Work', href: '/work.html', promise: 'Network autonomy, a learning product, market models and research automation.', proof: `${caseStudies.length} case studies`, glyph: 'M4 18 18 4M8 4h10v10' },
  { id: 'skills', label: 'Skills', href: '/index.html#skills', promise: 'Every skill tied to the place I actually used it.', proof: `${skillCount} skills with evidence`, glyph: 'M3 12h4l3-8 4 16 3-8h4' },
  { id: 'lessons', label: 'Lessons', href: '/tutoring.html', promise: 'GCSE & A-level maths and science, online. Enhanced DBS checked.', proof: 'Free 15-min intro call', glyph: 'M4 6h16M4 12h10M4 18h7' },
  { id: 'contact', label: 'Contact', href: '/contact.html', promise: 'Projects, roles, research or lessons: one short message is enough.', proof: 'Email · LinkedIn · GitHub', glyph: 'M3 6h18v12H3zM3 6l9 7 9-7' },
];
---
<section class="hero" data-hero data-own-entrance aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__grid"></span>
    <span class="hero__blob hero__blob--a"></span>
    <span class="hero__blob hero__blob--b"></span>
    <span class="hero__blob hero__blob--c"></span>
    <span class="hero__mark">OMAR</span>
  </div>

  <div class="hero__inner wrap">
    <div class="hero__copy">
      <p class="hero__eyebrow"><span class="hero__live" aria-hidden="true"></span>Omar Aboelella<span class="hero__eyebrow-more"> · AI product engineer, maths student &amp; tutor</span> · London</p>
      <h1 id="hero-title" class="hero__title">
        {title.map(line => (
          <span class:list={['hero__line', { 'hero__line--accent': line.accent }]}>
            {line.words.map(word => <span class="hero__word"><span style={`--w:${wordIndex++}`}>{word}</span></span>)}
          </span>
        ))}
      </h1>
      <p class="hero__lede">AI Product Engineer at Digis Squared, founder of NOOKBASE, Computer Science &amp; Maths student at Birkbeck, and a GCSE &amp; A-level tutor.</p>
      <div class="hero__ctas">
        <a class="btn hero__cta" href="/work.html" data-open="Work" data-magnetic>See my work <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--accent hero__cta" href="/tutoring.html#lesson-enquiry" data-open="Lessons" data-magnetic>Book a lesson <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost hero__cta" href="/contact.html" data-open="Contact" data-magnetic>Contact me</a>
      </div>
    </div>

    <div class="hero__robot">
      <RobotStage />
    </div>

    <ul class="hero__chips" aria-label="At a glance">
      {chips.map((chip, index) => (
        <li class="spec" style={`--c:${index}`}>
          <span class="spec__num">{chip.text ?? <>{chip.prefix}<span data-count-to={chip.value}>{chip.value}</span></>}</span>
          <span class="spec__label">{chip.label}</span>
        </li>
      ))}
    </ul>

    <button class="hero__pause" type="button" data-motion-toggle>
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path data-motion-icon d="M4 3h3v10H4zm5 0h3v10H9z" fill="currentColor" /></svg>
      <span data-motion-label>Pause motion</span>
    </button>
  </div>
</section>

<nav class="doors wrap" aria-label="Where to next" id="doors">
  <ol class="doors__list">
    {doors.map((door, index) => (
      <li style={`--d:${index}`}>
        <a class:list={['door', `door--${door.id}`]} href={door.href} data-open={door.label} data-glow data-tilt>
          <span class="door__top">
            <span class="door__num">0{index + 1}<span>/04</span></span>
            <span class="door__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d={door.glyph} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </span>
          <span class="door__label">{door.label}</span>
          <span class="door__promise">{door.promise}</span>
          <span class="door__foot">
            <span class="door__proof">{door.proof}</span>
            <span class="door__go" aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .hero { position: relative; isolation: isolate; overflow: clip; min-height: min(100svh - var(--header), 980px); margin-top: calc(var(--header) * -1); padding-top: var(--header); background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 70%); }
  .hero__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__grid { position: absolute; inset: -40px; background:
      linear-gradient(#0a0c100d 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, #0a0c100d 1px, transparent 1px) 0 0 / 56px 56px;
    -webkit-mask: radial-gradient(75% 70% at 60% 45%, #000 20%, transparent 75%); mask: radial-gradient(75% 70% at 60% 45%, #000 20%, transparent 75%);
    transform: translate3d(calc(var(--mx, 0) * 14px), calc(var(--my, 0) * 12px), 0); transition: transform 900ms var(--ease-out); }
  .hero__blob { position: absolute; border-radius: 50%; filter: blur(60px); will-change: transform; }
  .hero__blob--a { width: 46vw; height: 46vw; right: -8vw; top: -6vw; background: radial-gradient(closest-side, #1f4bff38, #1f4bff00); }
  .hero__blob--b { width: 38vw; height: 38vw; left: -10vw; bottom: -14vw; background: radial-gradient(closest-side, #ffffff, #ffffff00); }
  .hero__blob--c { width: 26vw; height: 26vw; left: 38%; top: 30%; background: radial-gradient(closest-side, #8fa6ff40, #8fa6ff00); }
  .hero__mark { position: absolute; left: 50%; top: 52%; translate: -50% -50%; font-size: clamp(9rem, 30vw, 34rem); font-weight: 800; letter-spacing: -.07em; line-height: .8; color: transparent; -webkit-text-stroke: 1.5px #0a0c1012; white-space: nowrap; transform: translate3d(calc(var(--mx, 0) * -22px), 0, 0); transition: transform 1200ms var(--ease-out); user-select: none; }

  .hero__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: clamp(12px, 4vw, 56px); padding-bottom: clamp(36px, 4vw, 56px); }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: 10px; width: fit-content; max-width: 100%; padding: 7px 14px 7px 10px; border-radius: 999px; background: #ffffffb3; border: 1px solid #ffffff; box-shadow: var(--shadow-1); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); }
  .hero__live { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .hero__title { margin-top: 22px; font-size: clamp(2.5rem, .9rem + 6.4vw, 7.6rem); font-weight: 680; letter-spacing: -.06em; line-height: .9; text-transform: uppercase; max-width: none; }
  .hero__line { display: block; }
  .hero__line--accent { color: var(--accent); }
  .hero__word { display: inline-block; overflow: clip; overflow-clip-margin: .1em; padding-bottom: .04em; margin-right: .2em; vertical-align: top; }
  .hero__word:last-child { margin-right: 0; }
  .hero__word > span { display: inline-block; }
  .hero__lede { margin-top: 24px; max-width: 46ch; font-size: var(--step-lede); line-height: 1.45; color: var(--ink-2); letter-spacing: -.012em; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero__robot { position: relative; }
  .hero__chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .spec { display: grid; gap: 2px; align-content: start; padding: 14px 16px; border-radius: 16px; background: #ffffffc2; border: 1px solid #ffffff; box-shadow: var(--shadow-1); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .spec__num { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.2rem); font-weight: 680; letter-spacing: -.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .spec__label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); line-height: 1.4; }
  .hero__pause { justify-self: start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 1px solid var(--line); border-radius: 999px; background: #ffffffb3; color: var(--ink-2); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .05em; text-transform: uppercase; }
  .hero__pause:hover { border-color: var(--accent); color: var(--accent); }

  @media (min-width: 1000px) {
    .hero__inner { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); grid-template-rows: 1fr auto; column-gap: clamp(24px, 3vw, 56px); row-gap: 28px; align-items: center; }
    .hero__copy { grid-column: 1; grid-row: 1; }
    .hero__robot { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    .hero__chips { grid-column: 1; grid-row: 2; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hero__pause { position: absolute; right: var(--margin); bottom: clamp(36px, 4vw, 56px); }
    .hero__title { font-size: clamp(3rem, 1rem + 4.4vw, 5.6rem); }
    .hero__lede { max-width: 54ch; }
  }
  @media (max-width: 999px) {
    .hero__robot { order: -1; width: min(66vw, 340px); margin: -44px auto -40px; }
    .hero__robot :global(.robot-stage__tag) { display: none; }
    .hero__copy { order: 0; }
  }
  @media (max-width: 520px) {
    .hero__eyebrow { font-size: 10.5px; }
    .hero__eyebrow-more { display: none; }
    .hero__ctas .btn { flex: 1 1 auto; }
    .hero__ctas .btn--ghost { flex-basis: 100%; }
  }

  /* Doors: four big choices, right under the hero. */
  .doors { position: relative; z-index: 2; margin-top: clamp(-28px, -2vw, -12px); padding-bottom: clamp(56px, 7vw, 112px); }
  .doors__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .doors__list > li { display: grid; }
  .door { --gx: 50%; --gy: 50%; position: relative; display: grid; grid-template-rows: auto auto 1fr auto; gap: 10px; min-height: 100%; padding: 22px 22px 20px; border-radius: var(--radius-3); background: var(--surface); border: 1px solid #ffffff; box-shadow: var(--shadow-2); text-decoration: none; color: var(--ink); overflow: hidden; isolation: isolate; transition: box-shadow 500ms var(--ease-out), translate 500ms var(--ease-out), background-color 300ms; }
  .door::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(360px circle at var(--gx) var(--gy), #1f4bff1f, transparent 60%); opacity: 0; transition: opacity 300ms; }
  .door:hover, .door:focus-visible { box-shadow: 0 2px 6px #0a0c100d, 0 30px 70px -24px #1f4bff59; translate: 0 -4px; }
  .door:hover::before, .door:focus-visible::before { opacity: 1; }
  .door__top { display: flex; justify-content: space-between; align-items: center; }
  .door__num { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; color: var(--accent); font-weight: 600; }
  .door__num span { color: var(--muted); font-weight: 400; }
  .door__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--bg); color: var(--ink); transition: background-color 300ms, color 300ms, rotate 500ms var(--ease-out); }
  .door:hover .door__icon { background: var(--accent); color: #fff; rotate: -8deg; }
  .door__label { font-size: clamp(2.2rem, 1.4rem + 2.6vw, 3.6rem); font-weight: 680; letter-spacing: -.055em; line-height: .95; margin-top: 10px; }
  .door__promise { color: var(--muted); font-size: var(--step-small); line-height: 1.45; max-width: 34ch; }
  .door__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--line); }
  .door__proof { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); }
  .door__go { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); font-size: 16px; transition: background-color 300ms, color 300ms, border-color 300ms, transform 400ms var(--ease-out); }
  .door:hover .door__go { background: var(--ink); border-color: var(--ink); color: #fff; transform: rotate(45deg); }
  .door--contact { background: var(--accent); color: #fff; border-color: var(--accent); }
  .door--contact .door__num, .door--contact .door__num span, .door--contact .door__promise, .door--contact .door__proof { color: #e3e9ff; }
  .door--contact .door__icon { background: #ffffff26; color: #fff; }
  .door--contact .door__foot { border-color: #ffffff40; }
  .door--contact .door__go { border-color: #ffffff66; }
  .door--contact:hover .door__go { background: #fff; color: var(--accent); border-color: #fff; }
  .door--contact::before { background: radial-gradient(360px circle at var(--gx) var(--gy), #ffffff33, transparent 60%); }
  .door--contact:focus-visible { outline-color: var(--ink); }
  @media (min-width: 640px) { .doors__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .doors__list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; } .door { min-height: 300px; padding: 26px 26px 22px; } }

  /* Motion: always alive, never required. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__blob--a { animation: blob-a 22s ease-in-out infinite alternate; }
    .hero__blob--b { animation: blob-b 26s ease-in-out infinite alternate; }
    .hero__blob--c { animation: blob-c 18s ease-in-out infinite alternate; }
    :global(html.js) .hero__word > span { animation: word-up 900ms var(--ease-out) both; animation-delay: calc(var(--enter-delay, 0ms) + 120ms + var(--w) * 55ms); }
    :global(html.js) :is(.hero__eyebrow, .hero__lede, .hero__ctas) { animation: fade-up 900ms var(--ease-out) both; }
    :global(html.js) .hero__eyebrow { animation-delay: calc(var(--enter-delay, 0ms) + 40ms); }
    :global(html.js) .hero__lede { animation-delay: calc(var(--enter-delay, 0ms) + 640ms); }
    :global(html.js) .hero__ctas { animation-delay: calc(var(--enter-delay, 0ms) + 760ms); }
    :global(html.js) .hero__robot { animation: robot-up 1300ms var(--ease-out) both; animation-delay: calc(var(--enter-delay, 0ms) + 200ms); }
    :global(html.js) .spec { animation: fade-up 800ms var(--ease-out) both; animation-delay: calc(var(--enter-delay, 0ms) + 900ms + var(--c) * 90ms); }
    :global(html.js) .doors__list > li { animation: fade-up 900ms var(--ease-out) both; animation-delay: calc(var(--enter-delay, 0ms) + 1050ms + var(--d) * 90ms); }
    :global(html[data-motion='off']) :is(.hero__blob) { animation-play-state: paused; }
  }
  @keyframes word-up { from { transform: translateY(105%); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(26px); } }
  @keyframes robot-up { from { opacity: 0; transform: translateY(90px) scale(.94); } }
  @keyframes blob-a { to { transform: translate(-10vw, 8vw) scale(1.15); } }
  @keyframes blob-b { to { transform: translate(14vw, -8vw) scale(1.2); } }
  @keyframes blob-c { to { transform: translate(-12vw, 10vw) scale(.85); } }
</style>
