---
import { stats } from '../data/site';
---
<section class="stats" aria-label="Some numbers">
  <ol class="stats__list wrap" data-reveal-stagger>
    {stats.map(stat => (
      <li>
        <p class="stats__value" data-fx="drift"><span>{stat.prefix}</span><span data-count-to={stat.value}>{stat.value}</span></p>
        <p class="stats__label">{stat.label}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .stats { background: var(--plate); color: #f4f5f7; }
  .stats__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stats__list li { display: grid; gap: 6px; padding: clamp(24px, 4vw, 48px) 16px clamp(24px, 4vw, 48px) 0; border-bottom: 1px solid #262b35; }
  .stats__value { font-size: clamp(3rem, 1.6rem + 5vw, 6.5rem); font-weight: 600; letter-spacing: -.06em; line-height: .9; font-variant-numeric: tabular-nums; }
  .stats__value span:first-child { color: #b7bdff; font-weight: 400; }
  .stats__label { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: #aab2c0; max-width: 24ch; }
  @media (min-width: 900px) {
    .stats__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stats__list li { border-bottom: 0; padding-left: 24px; }
    .stats__list li:first-child { padding-left: 0; }
    .stats__list li + li { border-left: 1px solid #262b35; }
  }
</style>
