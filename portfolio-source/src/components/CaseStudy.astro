---
/* One case study on the Projects page: a white studio panel with the concept
   visual held in place (sticky, drifting slightly) while the story scrolls:
   context, what I did, stage, stack. Every fact comes from src/data. */
import ProjectMedia from './ProjectMedia.astro';
import type { Project } from '../data/projects';
import { statusLabel } from '../data/site';
interface Props { project: Project; number: number; total: number; }
const { project, number, total } = Astro.props;
const pad = (value: number) => String(value).padStart(2, '0');
const hasTour = ['katana', 'nookbase', 'inos', 'bitget', 'bp'].includes(project.id);
---
<article class="case" id={project.id} aria-labelledby={`${project.id}-title`} data-reveal="scale">
  {project.aliases.map(alias => <span id={alias} class="case__alias"></span>)}
  <div class="case__media">
    <div class="case__media-in">
      <span class="case__ghost ghost-num" aria-hidden="true" data-fx="slide-x">{pad(number)}</span>
      <div class="case__plate" data-tilt><ProjectMedia project={project} /></div>
      <p class="case__caption"><span class="idx">{pad(number)}<span>/{pad(total)}</span></span><span>{project.org} · {project.period}</span></p>
    </div>
  </div>
  <div class="case__body">
    <p class="case__top"><span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span><span class="case__role">{project.role}</span></p>
    <h2 id={`${project.id}-title`}>{project.name}</h2>
    <p class="lede">{project.summary}</p>
    <dl class="case__steps">
      <div><dt><span class="idx">A</span> Context</dt><dd>{project.context}</dd></div>
      <div><dt><span class="idx">B</span> My contribution</dt><dd><ul>{project.contribution.map(line => <li>{line}</li>)}</ul></dd></div>
      <div><dt><span class="idx">C</span> Stage</dt><dd>{project.stage}</dd></div>
      <div><dt><span class="idx">D</span> Stack</dt><dd><ul class="pills">{project.stack.map(item => <li>{item}</li>)}</ul></dd></div>
    </dl>
    <p class="note">{project.statusNote}</p>
    <div class="case__actions">
      {hasTour && <a class="btn" href={`/inside/${project.id}.html`} data-open={project.name} data-magnetic>Open the tour <span class="arrow" aria-hidden="true">↗</span></a>}
      <a class="btn btn--ghost" href={`/contact.html?topic=Project`} data-open="Contact">Ask about it</a>
      {project.external && <a class="go" href={project.external.href} target="_blank" rel="noopener noreferrer">{project.external.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
    </div>
  </div>
</article>

<style>
  .case { position: relative; display: grid; gap: clamp(24px, 3vw, 48px); padding: clamp(14px, 2vw, 28px); border-radius: var(--radius-3); background: var(--surface); border: 1px solid #ffffff; box-shadow: var(--shadow-2); scroll-margin-top: calc(var(--header) + 24px); }
  .case + :global(.case) { margin-top: clamp(20px, 3vw, 40px); }
  .case__alias { position: absolute; top: 0; }
  .case__media-in { position: relative; display: grid; gap: 14px; }
  .case__ghost { position: absolute; right: -8px; top: -.18em; z-index: 0; }
  .case__plate { position: relative; z-index: 1; border-radius: 22px; }
  .case__plate :global(.plate) { border-radius: 22px; aspect-ratio: 16 / 11; box-shadow: var(--shadow-2); }
  .case__plate :global(.plate--type svg) { width: auto; height: 84%; max-width: 92%; }
  .case__caption { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-inline: 6px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .case__body { display: grid; gap: var(--s-5); align-content: start; padding: clamp(4px, 1.4vw, 20px) clamp(8px, 1.6vw, 24px) clamp(12px, 1.6vw, 24px); }
  .case__top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .case__role { color: var(--muted); font-size: var(--step-small); }
  .case__body h2 { font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4.4rem); letter-spacing: -.055em; line-height: .95; }
  .case__body .lede { max-width: 44ch; color: var(--ink-2); }
  .case__steps { display: grid; border-top: 1px solid var(--line); }
  .case__steps > div { display: grid; gap: 8px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .case__steps dt { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .case__steps dt .idx { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent-soft); font-size: 11px; }
  .case__steps dd { margin: 0; max-width: 62ch; }
  .case__steps ul:not(.pills) { display: grid; gap: 8px; }
  .case__steps ul:not(.pills) li { position: relative; padding-left: 20px; }
  .case__steps ul:not(.pills) li::before { content: ''; position: absolute; left: 2px; top: .7em; width: 8px; height: 2px; border-radius: 2px; background: var(--accent); }
  .case__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  @media (min-width: 1024px) {
    .case { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
    .case__media { position: sticky; top: calc(var(--header) + 28px); }
    .case__steps > div { grid-template-columns: 170px minmax(0, 1fr); gap: 16px; }
  }
</style>
