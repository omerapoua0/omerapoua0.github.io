---
/* Everything below the homepage hero and doors (v6 neon): a skills marquee
   that speeds up with the scroll, "What I do" (Build / Reason / Teach) as
   sticky storytelling with a progress rail, the selected work as a pinned
   horizontal gallery driven by vertical scroll, skills with evidence,
   lessons, about (a statement that fills with light as you scroll) and the
   contact band. Facts only from src/data and the CV. */
import SectionHead from './SectionHead.astro';
import CapabilityMatrix from './CapabilityMatrix.astro';
import ProjectMedia from './ProjectMedia.astro';
import { caseStudies } from '../data/projects';
import { statusLabel, site } from '../data/site';

const pad = (value: number) => String(value).padStart(2, '0');
const skillsRow = ['LangGraph', 'Bayesian inference', 'MAPE-K', 'Python', 'Time-series forecasting', 'Feature engineering', 'Data pipelines', 'FastAPI', 'PostgreSQL', 'Docker'];
const learnRow = ['GCSE & A-level maths', 'Physics', 'Linear algebra', 'Calculus', 'Optimisation', 'Probability', 'Qiskit', 'Discrete maths'];
const chapters = [
  { id: 'build', title: 'Build', head: 'AI products, from the maths to production.', copy: 'As AI Product Engineer at Digis Squared I work on KATANA, INOS and OctiMind: I choose technologies, run technical and security audits and help shape business and product strategy, and I design the closed-loop MAPE-K reasoning for KATANA’s network autonomy. As founder of NOOKBASE I’m building an agentic study platform, pre-launch with around 150 beta users.', facts: ['LangGraph workflows', 'MAPE-K reasoning', 'Technology selection', 'Technical & security audits', 'Business & product strategy', 'iOS · Android · Web'], href: '/work.html', go: 'See the work' },
  { id: 'reason', title: 'Reason', head: 'Decisions you can explain.', copy: 'Bayesian inference to automate network decisions. Predictive models on historical and live market data at Bitget. Next, optimisation and machine learning for credit scoring at a Santander research placement (Summer 2027, upcoming).', facts: ['Bayesian inference', 'Time-series forecasting', 'Optimisation'], href: '/research.html', go: 'Research' },
  { id: 'teach', title: 'Teach', head: 'Maths and science, made clear.', copy: 'Mathematics & Physics Teaching Assistant at Southfields Academy, and one-to-one online lessons for GCSE and A-level. Enhanced DBS checked, with a free 15-minute intro call.', facts: ['GCSE & A-level', 'Maths & physics', 'Online, one-to-one'], href: '/tutoring.html', go: 'Lessons' },
];
const now = [
  { label: 'Now', title: 'AI Product Engineer', meta: 'Digis Squared · KATANA, INOS & OctiMind' },
  { label: 'Building', title: 'NOOKBASE', meta: 'Pre-launch · around 150 beta users' },
  { label: 'Teaching', title: 'Maths & Physics TA', meta: 'Southfields Academy · since Mar 2026' },
  { label: 'Studying', title: 'BSc Computer Science & Maths', meta: 'Birkbeck · expected 2028' },
  { label: 'Next', title: 'Santander research placement', meta: 'Optimisation & ML · Summer 2027 · upcoming' },
];
const promises = [
  { title: 'Enhanced DBS checked', copy: 'For parents’ peace of mind.' },
  { title: 'Free 15-minute intro call', copy: 'Meet before you commit to anything.' },
  { title: 'Parents welcome to sit in', copy: 'Join any lesson, any time.' },
  { title: 'Reply within one working day', copy: 'To every lesson enquiry.' },
];
const levels = [
  { name: 'GCSE Foundation', copy: 'Build the foundations, one clear step at a time.' },
  { name: 'GCSE Higher', copy: 'Connect concepts and tackle unfamiliar problems.' },
  { name: 'A-level', copy: 'Go deeper into reasoning, proof and exam technique.' },
];
---
<div class="marquee" aria-hidden="true">
  {[skillsRow, learnRow].map((row, r) => (
    <div class:list={['marquee__row', { 'marquee__row--rev': r === 1 }]}>
      <div class="marquee__track">
        {[0, 1].map(() => (
          <span class="marquee__set">{row.map((word, i) => <span class:list={['marquee__word', { 'marquee__word--ghost': (i + r) % 2 === 1 }]}>{word}<i></i></span>)}</span>
        ))}
      </div>
    </div>
  ))}
</div>

<section class="story" id="what" aria-labelledby="what-title" data-scrolly data-scrub="contain">
  <div class="wrap story__grid">
    <div class="story__side">
      <div class="story__sticky">
        <p class="eyebrow"><b>01</b>What I do</p>
        <h2 id="what-title" class="story__title">Build. Reason. <em class="voice">Teach.</em></h2>
        <ol class="story__rail" aria-hidden="true">
          <i class="story__rail-fill"></i>
          {chapters.map((chapter, index) => <li class={`story__tick story__tick--${index}`}><span>0{index + 1}</span>{chapter.title}</li>)}
        </ol>
        <div class="story__visual" aria-hidden="true">
          <span class="hud hud--blue"></span>
          <svg class="story__svg story__svg--0" viewBox="0 0 320 200"><g fill="none" stroke-width="1.5"><rect pathLength="1" x="20" y="70" width="72" height="60" rx="6" /><rect pathLength="1" x="124" y="70" width="72" height="60" rx="6" /><rect pathLength="1" x="228" y="70" width="72" height="60" rx="6" /><path pathLength="1" class="r" d="M92 100h32M196 100h32" /></g><g class="t"><text x="56" y="104">MATHS</text><text x="160" y="104">MODEL</text><text x="264" y="104">PRODUCT</text></g></svg>
          <svg class="story__svg story__svg--1" viewBox="0 0 320 200"><g fill="none" stroke-width="1.5"><path pathLength="1" class="r" d="M20 170C80 170 90 70 130 70S190 170 300 170" stroke-dasharray=".02 .02" /><path pathLength="1" d="M20 170C110 170 140 36 176 36S230 170 300 170" /><path pathLength="1" class="r" d="M176 36V176" /></g><g class="t"><text x="70" y="62">PRIOR</text><text x="226" y="62">POSTERIOR</text></g></svg>
          <svg class="story__svg story__svg--2" viewBox="0 0 320 200"><g fill="none" stroke-width="1.5"><path pathLength="1" class="r" d="M30 180H300M60 190V20" /><path pathLength="1" d="M70 30Q160 330 290 30" /><path pathLength="1" class="r" d="M120 150 270 60" /></g><g class="t"><text x="200" y="176">y = x²</text><text x="232" y="96">TANGENT</text></g></svg>
          <span class="story__readout"><b></b>/03</span>
        </div>
      </div>
    </div>
    <ol class="story__chapters">
      {chapters.map((chapter, index) => (
        <li class="chapter" data-scrolly-step id={`what-${chapter.id}`}>
          <span class="chapter__num">0{index + 1}<span>/03</span></span>
          <h3 class="chapter__title">{chapter.title}</h3>
          <p class="chapter__head">{chapter.head}</p>
          <p class="chapter__copy">{chapter.copy}</p>
          <ul class="chapter__facts">{chapter.facts.map(fact => <li>{fact}</li>)}</ul>
          <a class="go" href={chapter.href} data-open={chapter.go}>{chapter.go} <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="work" id="work" aria-labelledby="work-title">
  <div class="hgal" data-hgallery data-scrub="contain">
    <div class="hgal__sticky">
      <div class="wrap hgal__head">
        <SectionHead mark="02" label="Selected work" id="work-title">Real systems, <em class="voice">honestly labelled.</em>
          <p slot="aside">Network autonomy, network testing and optimisation (INOS &amp; OctiMind), my own learning product, market modelling and research automation. Each card says what I did, what the wider team did and what stage it’s at. Open any one for the tour.</p>
        </SectionHead>
      </div>
      <ol class="hgal__track" data-hgallery-track>
        {caseStudies.map((project, index) => (
          <li class="hcard" data-hgallery-item>
            {/* Named by the project and its status (not the media caption); the
                concept-visual label is still announced as the description. */}
            <a class="hcard__link" href={`/inside/${project.id}.html`} data-open={project.name} data-glow aria-labelledby={`card-${project.id}-name card-${project.id}-status`} aria-describedby={project.media ? `card-${project.id}-cap` : undefined}>
              <span class="hud"></span>
              <span class="hcard__media"><ProjectMedia project={project} video={index < 2} captionId={`card-${project.id}-cap`} /></span>
              <span class="hcard__body">
                <span class="hcard__meta"><span class="hcard__num">{pad(index + 1)}<span>/{pad(caseStudies.length)}</span></span><span class:list={['chip', `chip--${project.status}`]} id={`card-${project.id}-status`}>{statusLabel[project.status]}</span></span>
                <span class="hcard__name" id={`card-${project.id}-name`}>{project.name}</span>
                <span class="hcard__org">{project.role} · {project.org === 'Founder' ? 'NOOKBASE' : project.org} · {project.period}</span>
                <span class="hcard__summary">{project.summary}</span>
                <span class="hcard__note">{project.statusNote}</span>
                <span class="hcard__cta">Open the tour <span aria-hidden="true">↗</span></span>
              </span>
            </a>
          </li>
        ))}
        <li class="hcard hcard--all" data-hgallery-item>
          <a class="hcard__all" href="/work.html" data-open="Work">
            <span class="hud hud--red"></span>
            <span class="hcard__all-k">Index</span>
            <span class="hcard__all-t">All case studies</span>
            <span class="hcard__all-go" aria-hidden="true">↗</span>
          </a>
        </li>
      </ol>
      <div class="wrap hgal__foot" aria-hidden="true"><span class="hgal__bar"><i></i></span><span class="hgal__hint">Scroll to move · Tab through the cards</span></div>
    </div>
  </div>
</section>

<section class="section skills" id="skills" aria-labelledby="skills-title" tabindex="-1">
  <div class="wrap">
    <SectionHead mark="03" label="Skills" id="skills-title">Skills, with <em class="voice">evidence.</em>
      <p slot="aside">No star ratings. Each skill points to where my CV shows it in use. Hover a column to trace one project across the matrix.</p>
    </SectionHead>
    <div class="skills__panel" data-reveal>
      <span class="hud"></span>
      <CapabilityMatrix />
    </div>
  </div>
</section>

<section class="section lessons" id="lessons" aria-labelledby="lessons-title">
  <div class="wrap lessons__grid">
    <div class="lessons__copy" data-reveal>
      <p class="eyebrow"><b>04</b>Lessons</p>
      <h2 id="lessons-title">Maths &amp; science, <em class="voice">made clear.</em></h2>
      <p class="lede">Personal online lessons for GCSE Foundation, GCSE Higher and A-level. Build a method you understand, not just an answer you remember.</p>
      <ul class="promises">
        {promises.map(item => <li><span class="promises__tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12"><path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span><strong>{item.title}</strong> <span class="muted">{item.copy}</span></span></li>)}
      </ul>
      <div class="actions">
        <a class="btn btn--accent" href="/tutoring.html#lesson-enquiry" data-open="Lessons" data-magnetic>Book a lesson <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href="/tutoring.html" data-open="Lessons" data-magnetic>How lessons work</a>
      </div>
    </div>
    <ol class="levels" data-reveal-stagger>
      {levels.map((level, index) => (
        <li class="level" data-glow data-tilt>
          <span class="level__num">{['i', 'ii', 'iii'][index]}</span>
          <span class="level__name">{level.name}</span>
          <span class="level__copy">{level.copy}</span>
        </li>
      ))}
      <li class="level level--note">
        <span class="level__copy">I teach every lesson myself, as a Maths &amp; Physics Teaching Assistant at Southfields Academy. No payment is taken online; the enquiry form prepares an email you send yourself.</span>
      </li>
    </ol>
  </div>
</section>

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <figure class="about__photo" data-reveal="wipe">
      <picture>
        <source srcset="/portrait-hero.webp" type="image/webp" />
        <img src="/portrait-hero.jpg" alt="Portrait of Omar Aboelella" width="720" height="900" loading="lazy" decoding="async" />
      </picture>
      <span class="hud hud--red"></span>
      <figcaption><span>Omar Aboelella</span><span>London · Arabic &amp; English</span></figcaption>
    </figure>
    <div class="about__copy">
      <div data-reveal>
        <p class="eyebrow"><b>05</b>About</p>
        <h2 id="about-title" class="about__title fill-text" data-scrub="entry">Understand it. Build it. Explain it.</h2>
        <p class="lede">I build machine-learning and optimisation systems from the mathematics through to production code, and I teach the maths that makes them work.</p>
      </div>
      <ol class="now" data-reveal-stagger>
        {now.map(item => (
          <li><span class="now__label">{item.label}</span><span class="now__title">{item.title}</span><span class="now__meta">{item.meta}</span></li>
        ))}
      </ol>
      <div class="actions" data-reveal>
        <a class="btn" href="/Omar-Aboelella-CV.pdf" download data-magnetic>Download CV <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
        <a class="btn btn--ghost" href="/cv.html" data-open="About & CV" data-magnetic>About &amp; CV <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <div class="contact-band__bg" aria-hidden="true"><span></span><span></span><b class="beams"><i></i><i></i><i></i></b><i class="contact-band__grid"></i><span class="hud contact-band__hud"></span></div>
  <div class="wrap contact-band__inner">
    <p class="eyebrow eyebrow--dark"><b>06</b>Contact</p>
    <h2 id="contact-title" class="contact-band__title" data-reveal>Have something in mind? <span>Let’s talk.</span></h2>
    <p class="contact-band__lede" data-reveal>Projects, roles, research or lessons. Write a line or two; the contact form prepares an email you check and send yourself.</p>
    <div class="contact-band__row" data-reveal>
      <div class="contact-band__email">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="copy-btn" data-copy-email={site.email} hidden><svg class="copy-btn__tick" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path pathLength="1" d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span data-copy-label>Copy</span></button>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
      <div class="contact-band__actions">
        <a class="btn contact-band__primary" href="/contact.html" data-open="Contact" data-magnetic>Write to Omar <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="contact-band__social" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        <a class="contact-band__social" href={site.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Marquee of skills: two rows sliding in opposite directions; fx.ts speeds
     them up and leans them with the scroll velocity. */
  .marquee { overflow: hidden; padding: clamp(18px, 2.4vw, 32px) 0; border-block: 1px solid var(--line); background: linear-gradient(180deg, #0b0d12, #090a0e); display: grid; gap: 6px; }
  .marquee__track { display: flex; width: max-content; }
  .marquee__set { display: flex; flex: none; transform: skewX(calc(var(--scroll-vel, 0) * -12deg)); }
  .marquee__word { display: inline-flex; align-items: center; gap: .5em; padding-right: .5em; font-size: clamp(1.7rem, 1rem + 3vw, 3.8rem); font-weight: 720; letter-spacing: -.045em; line-height: 1.12; white-space: nowrap; text-transform: uppercase; }
  .marquee__word--ghost { color: transparent; -webkit-text-stroke: 1px #ffffff59; }
  .marquee__word i { width: .26em; height: .26em; rotate: 45deg; background: var(--red); box-shadow: 0 0 12px var(--red); }
  .marquee__row--rev .marquee__word i { background: var(--blue); box-shadow: 0 0 12px var(--blue); }

  /* What I do: sticky storytelling with a progress rail (--p from the scrub)
     and a HUD visual that follows the chapter in view (data-at, site.ts). */
  .story { position: relative; padding-block: clamp(80px, 9vw, 140px); background: radial-gradient(60% 50% at 20% 40%, #2f6bff14, transparent 70%), var(--bg); }
  .story__grid { display: grid; gap: 40px; }
  .story__sticky { display: grid; gap: 22px; }
  .story__title { font-size: clamp(2.6rem, 1.2rem + 5vw, 6rem); font-weight: 760; letter-spacing: -.055em; text-transform: uppercase; line-height: .92; }
  .story__rail { position: relative; display: flex; gap: 0; padding-top: 14px; border-top: 1px solid var(--line-strong); }
  .story__rail-fill { position: absolute; left: 0; top: -1px; height: 2px; width: 100%; background: linear-gradient(90deg, var(--red), var(--blue)); box-shadow: 0 0 10px #2f6bff99; transform-origin: 0 50%; transform: scaleX(1); }
  .story__tick { flex: 1; display: grid; gap: 2px; font: 600 13px/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); transition: color 400ms; }
  .story__tick span { font-weight: 400; font-size: 11px; color: var(--accent); }
  .story__visual { position: relative; display: none; aspect-ratio: 16 / 10; border-radius: 10px; background: radial-gradient(70% 70% at 50% 40%, #121a2e, #0a0c11 75%); border: 1px solid var(--line); overflow: hidden; }
  .story__visual .hud { --hud-inset: 10px; }
  .story__svg { position: absolute; inset: 12%; width: 76%; height: 76%; opacity: 0; transition: opacity 500ms var(--ease-out); }
  .story__svg g[fill='none'] > * { stroke: var(--blue); filter: drop-shadow(0 0 4px #2f6bffcc); stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1400ms var(--ease-out); }
  .story__svg g[fill='none'] > .r { stroke: var(--red); filter: drop-shadow(0 0 4px #ff2d46cc); }
  .story__svg .t { fill: var(--ink-2); font: 500 10px var(--font-mono); letter-spacing: .12em; text-anchor: middle; opacity: 0; transition: opacity 600ms 500ms; }
  .story__readout { position: absolute; right: 18px; bottom: 14px; font: 500 11px var(--font-mono); letter-spacing: .1em; color: var(--muted); }
  .story__readout b { color: var(--ink); font-weight: 600; }
  .story__readout b::before { content: '01'; }
  .story[data-at='1'] .story__readout b::before { content: '02'; }
  .story[data-at='2'] .story__readout b::before { content: '03'; }
  .story__chapters { display: grid; gap: 18px; }
  .chapter { position: relative; display: grid; gap: 12px; align-content: center; padding: clamp(24px, 3vw, 40px); border-radius: 14px; background: linear-gradient(180deg, #12151c, #0d1016); border: 1px solid var(--line); transition: border-color 500ms, box-shadow 500ms; }
  .chapter::before { content: ''; position: absolute; left: -1px; top: 18%; bottom: 18%; width: 2px; background: var(--line-strong); transition: background-color 500ms, box-shadow 500ms; }
  .chapter__num { font: 600 12px var(--font-mono); letter-spacing: .1em; color: var(--accent); }
  .chapter__num span { color: var(--muted); font-weight: 400; }
  .chapter__title { font-size: clamp(2.4rem, 1.4rem + 3vw, 4.2rem); font-weight: 760; letter-spacing: -.05em; text-transform: uppercase; line-height: .95; }
  .chapter__head { font-size: var(--step-lede); font-weight: 560; letter-spacing: -.02em; color: var(--ink); line-height: 1.3; }
  .chapter__copy { color: var(--ink-2); max-width: 52ch; }
  .chapter__facts { display: flex; flex-wrap: wrap; gap: 8px; }
  .chapter__facts li { padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: 4px; font: 500 11.5px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
  .story[data-at] .chapter[data-current] { border-color: #4d84ff59; box-shadow: 0 30px 80px -40px #2f6bff80; }
  .story[data-at] .chapter[data-current]::before { background: var(--blue); box-shadow: 0 0 12px var(--blue); }
  @media (min-width: 1000px) {
    .story__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: clamp(40px, 6vw, 110px); }
    .story__sticky { position: sticky; top: calc(var(--header) + 40px); }
    .story__visual { display: block; }
    .chapter { min-height: 72vh; }
    .story__chapters { gap: 10vh; padding-block: 8vh 14vh; }
  }
  /* Without JavaScript (no data-at) every diagram is simply drawn. */
  .story:not([data-at]) .story__svg--0, .story[data-at='0'] .story__svg--0, .story[data-at='1'] .story__svg--1, .story[data-at='2'] .story__svg--2 { opacity: 1; }
  .story:not([data-at]) .story__svg--0 :is(g > *, .t), .story[data-at='0'] .story__svg--0 :is(g > *, .t), .story[data-at='1'] .story__svg--1 :is(g > *, .t), .story[data-at='2'] .story__svg--2 :is(g > *, .t) { stroke-dashoffset: 0; opacity: 1; }
  .story[data-at='0'] .story__tick--0, .story[data-at='1'] .story__tick--1, .story[data-at='2'] .story__tick--2 { color: var(--ink); }

  /* Selected work: a horizontal gallery. On desktop with motion it pins and
     the track moves sideways as you scroll down (--p); elsewhere it is a
     native horizontal scroller with snap points (touch, keyboard, reduced motion). */
  .work { position: relative; background: radial-gradient(70% 50% at 80% 50%, #2f6bff12, transparent 70%), var(--bg); }
  .hgal { --cw: min(84vw, 520px); --gap: 16px; --n: 6; }
  .hgal__sticky { padding-block: clamp(64px, 7vw, 104px) clamp(40px, 5vw, 72px); }
  .hgal__head :global(.section-head) { margin-bottom: clamp(24px, 3vw, 40px); }
  .hgal__head :global(.section-line) { display: none; }
  .hgal__track { position: relative; display: flex; gap: var(--gap); padding-inline: var(--margin); padding-bottom: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margin); scrollbar-width: thin; scrollbar-color: #ffffff33 transparent; }
  .hcard { flex: none; width: var(--cw); scroll-snap-align: start; display: grid; }
  .hcard__link, .hcard__all { --gx: 50%; --gy: 50%; position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: 14px; background: linear-gradient(180deg, #141821, #0d1016); border: 1px solid var(--line); box-shadow: var(--shadow-2); text-decoration: none; color: var(--ink); overflow: hidden; isolation: isolate; transition: box-shadow 500ms var(--ease-out), border-color 400ms, translate 500ms var(--ease-out); }
  .hcard__link::before, .hcard__all::before { content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none; background: radial-gradient(420px circle at var(--gx) var(--gy), #2f6bff24, transparent 60%); opacity: 0; transition: opacity 300ms; }
  .hcard__link:is(:hover, :focus-visible), .hcard__all:is(:hover, :focus-visible) { border-color: #4d84ff73; box-shadow: 0 2px 6px #00000080, 0 36px 80px -28px #2f6bff80; translate: 0 -6px; }
  .hcard__link:hover::before, .hcard__all:hover::before { opacity: 1; }
  .hcard .hud { --hud-inset: 8px; --hc: #ffffff40; z-index: 4; }
  .hcard__media { display: block; padding: 10px 10px 0; }
  .hcard__media :global(.plate) { border-radius: 8px; aspect-ratio: 16 / 8.4; }
  .hcard__media :global(.plate--type svg) { width: auto; height: 86%; max-width: 92%; }
