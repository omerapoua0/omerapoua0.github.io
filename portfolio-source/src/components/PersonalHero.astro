---
import { film, intro } from '../data/site';
interface Props { showPortrait?: boolean; }
const { showPortrait = true } = Astro.props;
---
<section class:list={['phero', { 'phero--no-portrait': !showPortrait }]} aria-labelledby="hero-title">
  <div class="phero__intro">
    <p class="phero__status">
      <span class="live-dot" aria-hidden="true"></span>
      <span>London <time class="phero__clock" data-london-time></time></span>
      {intro.status.map(item => <span>{item}</span>)}
    </p>
    <div class="phero__hello">
      {showPortrait && <picture class="phero__avatar-wrap"><source srcset="/portrait-avatar.webp" type="image/webp" /><img class="phero__avatar" src="/portrait-avatar.jpg" alt="" width="160" height="160" decoding="async" /></picture>}
      <h1 id="hero-title">Hi, I’m <em class="voice">{intro.greetingName}.</em></h1>
    </div>
    <p class="phero__name">Omar Aboelella · AI product engineer · maths student · tutor</p>
    <p class="phero__lead">{intro.lead}</p>
    <p class="phero__more">{intro.more}</p>
    <div class="actions phero__actions">
      <a class="btn btn--accent" href="#work">See what I’ve built <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
      <a class="btn btn--ghost" href="/tutoring.html">Maths &amp; science lessons <span class="arrow" aria-hidden="true">↗</span></a>
      <a class="phero__hello-link" href="/contact.html?topic=Hello">Or just say hello</a>
    </div>
    <ul class="phero__facts">{intro.facts.map(fact => <li>{fact}</li>)}</ul>
  </div>

  <div class="phero__visual">
    {showPortrait && (
      <figure class="phero__portrait">
        <picture><source srcset="/portrait-hero.webp" type="image/webp" /><img src="/portrait-hero.jpg" alt={intro.portraitAlt} width="720" height="900" fetchpriority="high" decoding="async" /></picture>
        <figcaption>{intro.portraitCaption}</figcaption>
      </figure>
    )}

    <figure class="filmwin" data-film-hero>
      <div class="filmwin__frame">
        <picture>
          <source media="(max-width: 720px)" srcset="/hero-editorial-poster-mobile.webp" type="image/webp" />
          <source media="(max-width: 720px)" srcset="/hero-editorial-poster-mobile.jpg" />
          <source srcset="/hero-editorial-poster.webp" type="image/webp" />
          <img class="hero__poster" src="/hero-editorial-poster.jpg" alt="" width="1280" height="800" loading="lazy" decoding="async" />
        </picture>
        <video class="hero__video" data-hero-video data-mp4="/hero-editorial.mp4" data-webm="/hero-editorial.webm" data-mobile="/hero-editorial-mobile.mp4" data-mobile-webm="/hero-editorial-mobile.webm" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" disablepictureinpicture></video>
        <div class="filmwin__controls">
          <button class="film-toggle" type="button" data-film-toggle aria-pressed="false">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path data-film-icon d="M5 3l8 5-8 5z" fill="currentColor" /></svg>
            <span data-film-control class="sr-only">Play film</span>
          </button>
          <div class="chapters" role="group" aria-label="Film chapters" data-chapters>
            {film.chapters.map((chapter, index) => (
              <button type="button" class="chapter" data-chapter={index} data-start={chapter.start} aria-label={`Chapter ${index + 1}: ${chapter.label}`}>
                <span class="chapter__label">{chapter.label}</span>
                <span class="chapter__track"><span class="chapter__fill"></span></span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <figcaption class="filmwin__caption"><span>Things I think about</span> <a href="/THIRD-PARTY-NOTICES.txt">{film.credit} <span class="nowrap">Credits ↗</span></a></figcaption>
      <p class="sr-only" data-film-status role="status" aria-live="polite"></p>
    </figure>
  </div>
</section>

<style>
  .phero { width: 100%; max-width: var(--max); margin-inline: auto; padding: clamp(36px, 6vw, 88px) var(--margin) clamp(56px, 7vw, 104px); display: grid; gap: clamp(36px, 5vw, 64px); }
  .phero__intro { display: grid; gap: var(--s-5); align-content: center; }

  .phero__status { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .phero__status > span:not(.live-dot) + span::before { content: '·'; margin-right: 14px; color: var(--line-strong); }
  .phero__clock { display: inline-block; min-width: 5ch; color: var(--ink); font-variant-numeric: tabular-nums; margin-left: 4px; }
  :global(html:not(.js)) .phero__clock { display: none; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent); }

  .phero__hello { display: flex; align-items: center; gap: 16px; }
  .phero__hello h1 { font-size: clamp(3.4rem, 1.6rem + 7vw, 8.5rem); letter-spacing: -.06em; line-height: .9; }
  .phero__hello .voice { color: var(--accent); letter-spacing: -.035em; font-weight: 400; padding-right: .04em; }
  .phero__avatar-wrap { display: block; flex: none; line-height: 0; }
  .phero__avatar { width: 64px; height: 64px; flex: none; border-radius: 50%; object-fit: cover; border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--line-strong); }
  .phero__name { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: .03em; color: var(--muted); margin-top: -4px; }
  .phero__lead { font-size: clamp(1.3rem, 1.05rem + 1vw, 1.85rem); line-height: 1.3; letter-spacing: -.025em; font-weight: 480; max-width: 30ch; }
  .phero__more { font-size: var(--step-body); color: var(--muted); max-width: 52ch; }
  .phero__actions { margin-top: var(--s-2); }
  .phero__hello-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 6px; font-weight: 520; color: var(--ink); text-decoration-color: var(--accent); }
  .phero__hello-link:hover { color: var(--accent); }
  .phero__facts { display: flex; flex-wrap: wrap; gap: 6px 10px; }
  .phero__facts li { padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 13.5px; color: var(--muted); }

  .phero__visual { position: relative; display: grid; gap: var(--s-5); }
  .phero__portrait { display: none; }

  .filmwin { display: grid; gap: 10px; }
  .filmwin__frame { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: var(--plate); border-radius: 3px; isolation: isolate; }
  .filmwin__frame picture, .hero__poster, .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__poster, .hero__video { object-fit: cover; }
  .hero__video { opacity: 0; transition: opacity var(--d-4) var(--ease-out); }
  .filmwin[data-film-ready] .hero__video { opacity: 1; }
  .filmwin[data-film-error] .hero__video { display: none; }
  .filmwin__controls { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; align-items: end; gap: 10px; padding: 28px 10px 8px; background: linear-gradient(to top, #0b0d11d9, transparent); color: #f4f5f7; }
  .film-toggle { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border: 1px solid #ffffff66; border-radius: 50%; background: #0b0d1180; color: #f4f5f7; }
  .film-toggle:hover { border-color: #c3c8ff; color: #c3c8ff; }
  .chapters { flex: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; }
  .chapter { display: grid; gap: 6px; align-content: end; min-height: 36px; padding: 0; border: 0; background: none; color: #c9cfda; text-align: left; }
  .chapter__label { font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; visibility: hidden; }
  .chapter[aria-current='true'] .chapter__label { visibility: visible; color: #fff; overflow: visible; }
  .chapter__track { position: relative; height: 2px; background: #ffffff40; overflow: hidden; }
  .chapter__fill { position: absolute; inset: 0; background: #fff; transform-origin: left; transform: scaleX(var(--p, 0)); }
  .chapter:hover .chapter__track { background: #ffffff80; }
  .filmwin :focus-visible { outline-color: #c3c8ff; }
  .filmwin__caption { display: flex; flex-wrap: wrap; gap: 2px 10px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .03em; text-transform: uppercase; color: var(--muted); }
  .filmwin__caption > span { color: var(--ink); }
  .filmwin__caption a { text-decoration: none; display: inline-flex; flex-wrap: wrap; gap: 0 8px; min-height: 24px; align-items: center; }
  .filmwin__caption a:hover { color: var(--accent); }
  .nowrap { white-space: nowrap; }
  :global(html:not(.js)) .filmwin__controls { visibility: hidden; }

  @media (max-width: 720px) {
    .filmwin__frame { aspect-ratio: 4 / 5; }
    .phero__status { font-size: 10.5px; letter-spacing: .02em; gap: 6px 8px; }
    .phero__status > span:not(.live-dot) + span::before { margin-right: 8px; }
  }

  @media (min-width: 1024px) {
    .phero { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; min-height: min(calc(100svh - var(--header)), 960px); }
    .phero__intro { grid-column: 1 / span 7; }
    .phero__visual { grid-column: 8 / span 5; display: block; padding-bottom: clamp(120px, 12vw, 170px); }
    .phero__avatar-wrap { display: none; }
    .phero__portrait { display: block; position: relative; width: 82%; margin-left: auto; }
    .phero__portrait img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 3px; background: var(--raised); }
    .phero__portrait figcaption { position: absolute; right: 12px; top: 12px; padding: 4px 10px; border-radius: 999px; background: var(--bg); font-size: 13px; font-weight: 520; }
    .filmwin { position: absolute; left: 0; bottom: 0; width: 64%; }
    .filmwin__frame { box-shadow: 0 0 0 8px var(--bg), 0 18px 40px -12px #0b0d1159; }
    .filmwin__caption { padding-top: 8px; }
    /* Without the portrait the film window takes the column. */
    .phero--no-portrait .phero__visual { padding-bottom: 0; }
    .phero--no-portrait .filmwin { position: static; width: 100%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot { animation: pulse 2.4s var(--ease-io) infinite; }
    .phero__hello h1 { animation: hello-rise var(--d-5) var(--ease-out) both; }
    .phero__lead, .phero__more, .phero__actions, .phero__facts, .phero__name { animation: hello-fade var(--d-5) var(--ease-out) 180ms both; }
    .phero__portrait { animation: hello-fade var(--d-5) var(--ease-out) 120ms both; }
    .filmwin { animation: hello-rise var(--d-5) var(--ease-out) 320ms both; }
    @keyframes pulse { 50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--ok) 6%, transparent); } }
    @keyframes hello-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @keyframes hello-fade { from { opacity: 0; } to { opacity: 1; } }
  }
</style>

<script>import '../scripts/film';</script>
