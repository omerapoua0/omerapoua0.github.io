---
import { film, intro } from '../data/site';
interface Props { showPortrait?: boolean; }
const { showPortrait = true } = Astro.props;
const lines = intro.cycle;
---
<section class:list={['chero', { 'chero--no-portrait': !showPortrait }]} aria-labelledby="hero-title" data-film-hero>
  <div class="chero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 720px)" srcset="/hero-editorial-poster-mobile.webp" type="image/webp" />
      <source media="(max-width: 720px)" srcset="/hero-editorial-poster-mobile.jpg" />
      <source srcset="/hero-editorial-poster.webp" type="image/webp" />
      <img class="hero__poster" src="/hero-editorial-poster.jpg" alt="" width="1280" height="800" fetchpriority="high" decoding="async" />
    </picture>
    <div class="chero__stills" data-stills>
      {[1, 2, 3, 4].map(n => <img alt="" width="1280" height="800" decoding="async" data-src={`/hero-still-${n}.webp`} data-src-mobile={`/hero-still-${n}-m.webp`} />)}
    </div>
    <video class="hero__video" data-hero-video data-mp4="/hero-editorial.mp4" data-webm="/hero-editorial.webm" data-mobile="/hero-editorial-mobile.mp4" data-mobile-webm="/hero-editorial-mobile.webm" muted loop playsinline preload="none" tabindex="-1" disablepictureinpicture></video>
    <div class="chero__scrim"></div>
  </div>

  <div class="chero__inner">
    <div class="chero__copy">
      <p class="chero__status">
        <span class="live-dot" aria-hidden="true"></span>
        <span>London <time class="chero__clock" data-london-time></time></span>
        {intro.status.map(item => <span>{item}</span>)}
      </p>
      <div class="chero__hello">
        {showPortrait && <picture class="chero__avatar-wrap"><source srcset="/portrait-avatar.webp" type="image/webp" /><img class="chero__avatar" src="/portrait-avatar.jpg" alt="" width="160" height="160" decoding="async" /></picture>}
        <h1 id="hero-title"><span class="chero__hi">Hi, I’m</span> <em class="voice">{intro.greetingName}.</em></h1>
      </div>
      <p class="chero__cycle">
        <span class="sr-only">{intro.cycleSummary}</span>
        <span class="cycle" aria-hidden="true" data-cycle>
          {lines.map((line, index) => <span class:list={['cycle__item', { 'is-active': index === 0 }]}>{line}</span>)}
        </span>
      </p>
      <p class="chero__lead">{intro.heroLead}</p>
      <div class="actions chero__actions">
        <a class="btn btn--light" href="#work">See what I’ve built <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
        <a class="btn btn--outline-light" href="/tutoring.html">Maths &amp; science lessons <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
    {showPortrait && (
      <figure class="chero__portrait" data-tilt>
        <div class="chero__portrait-card">
          <picture><source srcset="/portrait-hero.webp" type="image/webp" /><img src="/portrait-hero.jpg" alt={intro.portraitAlt} width="720" height="900" decoding="async" /></picture>
          <figcaption>{intro.portraitCaption}</figcaption>
        </div>
      </figure>
    )}
  </div>

  <div class="chero__bar">
    <div class="chapters" role="group" aria-label="Film chapters" data-chapters>
      {film.chapters.map((chapter, index) => (
        <button type="button" class="chapter" data-chapter={index} data-start={chapter.start} aria-label={`Chapter ${index + 1}: ${chapter.label}`}>
          <span class="chapter__head"><span class="chapter__num">0{index + 1}</span><span class="chapter__label">{chapter.label}</span></span>
          <span class="chapter__track"><span class="chapter__fill"></span></span>
        </button>
      ))}
    </div>
    <div class="chero__controls">
      <button class="film-toggle" type="button" data-film-toggle>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path data-film-icon d="M4 3h3v10H4zm5 0h3v10H9z" fill="currentColor" /></svg>
        <span data-film-control>Pause motion</span>
      </button>
      <button class="film-retry" type="button" data-film-retry hidden>▶ Play the film</button>
      <a class="chero__credit" href="/THIRD-PARTY-NOTICES.txt">{film.credit} <span class="nowrap">Credits ↗</span></a>
    </div>
  </div>
  <p class="sr-only" data-film-status role="status" aria-live="polite"></p>
</section>

<style>
  .chero { position: relative; isolation: isolate; min-height: max(620px, 100svh); max-height: 1100px; display: grid; grid-template-rows: 1fr auto; color: #f4f5f7; background: var(--plate); overflow: hidden; }
  .chero__media, .chero__media picture, .hero__poster, .hero__video, .chero__stills, .chero__stills img, .chero__scrim { position: absolute; inset: 0; width: 100%; height: 100%; }
  .chero__media { z-index: -1; }
  .hero__poster, .hero__video, .chero__stills img { object-fit: cover; }
  .hero__video { opacity: 0; transition: opacity var(--d-4) var(--ease-out); }
  .chero[data-film-ready] .hero__video { opacity: 1; }
  .chero[data-film-stills] .hero__video { display: none; }
  .chero__stills { display: none; }
  .chero[data-film-stills] .chero__stills { display: block; }
  .chero__stills img { opacity: 0; transition: opacity 1.2s var(--ease-io); }
  .chero__stills img[data-active] { opacity: 1; }
  .chero__scrim { background:
      linear-gradient(to top, #0b0d11f5 0%, #0b0d11b8 30%, #0b0d1140 62%, #0b0d1180 100%),
      linear-gradient(to right, #0b0d11c4 0%, #0b0d1166 45%, transparent 78%); }

  .chero__inner { align-self: end; width: 100%; max-width: var(--max); margin-inline: auto; padding: calc(var(--header) + 40px) var(--margin) clamp(24px, 3vw, 40px); display: grid; gap: var(--s-7); align-items: end; }
  .chero__copy { display: grid; gap: clamp(14px, 1.8vw, 22px); }
  .chero__status { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: #c9cfda; }
  .chero__status > span:not(.live-dot) + span::before { content: '·'; margin-right: 12px; color: #6b7280; }
  .chero__clock { display: inline-block; min-width: 5ch; color: #fff; font-variant-numeric: tabular-nums; margin-left: 4px; }
  :global(html:not(.js)) .chero__clock { display: none; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #6fd3a3; box-shadow: 0 0 0 4px #6fd3a32e; }
  .chero__hello { display: flex; align-items: center; gap: 14px; }
  .chero__hello h1 { font-size: clamp(3.4rem, 1.4rem + 8vw, 9.5rem); letter-spacing: -.06em; line-height: .88; }
  .chero__hello .voice { color: #b7bdff; font-weight: 400; letter-spacing: -.035em; padding-right: .04em; }
  .chero__avatar-wrap { display: block; flex: none; line-height: 0; }
  .chero__avatar { width: 62px; height: 62px; border-radius: 50%; object-fit: cover; border: 2px solid #f4f5f7; }

  .chero__cycle { position: relative; font-size: clamp(1.45rem, 1.05rem + 1.7vw, 2.6rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.15; }
  .cycle { display: grid; height: 1.2em; overflow: hidden; }
  .cycle__item { grid-area: 1 / 1; white-space: nowrap; transform: translateY(110%); opacity: 0; transition: transform 700ms var(--ease-out), opacity 500ms var(--ease-out); }
  .cycle__item.is-active { transform: none; opacity: 1; }
  .cycle__item.is-leaving { transform: translateY(-110%); opacity: 0; }
  .cycle__item::after { content: ''; display: inline-block; width: .08em; height: .9em; margin-left: .12em; vertical-align: -.08em; background: #b7bdff; animation: caret 1s steps(1) infinite; }
  .chero__lead { font-size: var(--step-body); color: #d3d8e0; max-width: 46ch; }
  .chero__actions { margin-top: 6px; }

  .btn--light { background: #f4f5f7; border-color: #f4f5f7; color: #0b0d11; }
  .btn--light:hover { background: #b7bdff; border-color: #b7bdff; color: #0b0d11; }
  .btn--outline-light { background: #0b0d1140; border-color: #ffffff80; color: #f4f5f7; }
  .btn--outline-light:hover { background: transparent; border-color: #b7bdff; color: #b7bdff; }
  .chero :focus-visible { outline-color: #b7bdff; }

  .chero__portrait { display: none; }
  .chero__portrait-card { position: relative; border-radius: 4px; overflow: hidden; box-shadow: 0 30px 60px -20px #000000b0, 0 0 0 1px #ffffff26; transform: perspective(900px) rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg)); transition: transform 400ms var(--ease-out); }
  .chero__portrait-card img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .chero__portrait figcaption { position: absolute; left: 12px; bottom: 12px; padding: 5px 11px; border-radius: 999px; background: #f4f5f7; color: #0b0d11; font-size: 13px; font-weight: 560; }

  .chero__bar { width: 100%; max-width: var(--max); margin-inline: auto; padding: 0 var(--margin) calc(18px + env(safe-area-inset-bottom)); display: grid; gap: 10px; }
  .chapters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .chapter { display: grid; gap: 8px; min-height: 44px; padding: 8px 0 6px; border: 0; background: none; color: #aab2c0; text-align: left; }
  .chapter__head { display: flex; gap: 8px; align-items: baseline; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .04em; text-transform: uppercase; }
  .chapter__num { color: #8b93a3; }
  .chapter__track { position: relative; height: 2px; background: #ffffff33; overflow: hidden; }
  .chapter__fill { position: absolute; inset: 0; background: #f4f5f7; transform-origin: left; transform: scaleX(var(--p, 0)); }
  .chapter[aria-current='true'], .chapter:hover { color: #fff; }
  .chero__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .film-toggle, .film-retry { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 15px; border: 1px solid #ffffff59; border-radius: 999px; background: #0b0d1166; color: #f4f5f7; font-family: var(--font-mono); font-size: 11px; letter-spacing: .05em; text-transform: uppercase; }
  .film-retry { background: #f4f5f7; color: #0b0d11; border-color: #f4f5f7; }
  .film-toggle:hover { border-color: #b7bdff; color: #b7bdff; }
  .chero__credit { margin-left: auto; font-family: var(--font-mono); font-size: 10px; letter-spacing: .03em; text-transform: uppercase; color: #aab2c0; text-decoration: none; min-height: 44px; display: inline-flex; flex-wrap: wrap; gap: 0 8px; align-items: center; }
  .chero__credit:hover { color: #fff; }
  .nowrap { white-space: nowrap; }
  :global(html:not(.js)) .chapters, :global(html:not(.js)) .film-toggle { visibility: hidden; }

  @media (max-width: 720px) {
    .chapter__label { display: none; }
    .chero__status { font-size: 10.5px; gap: 6px 8px; letter-spacing: .02em; }
    .chero__status > span:not(.live-dot) + span::before { margin-right: 8px; }
    .chero__cycle { font-size: clamp(1.3rem, 5.6vw, 1.6rem); }
    .chero__credit { margin-left: 0; }
  }
  @media (min-width: 1024px) {
    .chero__inner { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .chero__copy { grid-column: 1 / span 8; }
    .chero__avatar-wrap { display: none; }
    .chero__portrait { display: block; grid-column: 10 / span 3; align-self: center; }
    .chero--no-portrait .chero__copy { grid-column: 1 / span 10; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot { animation: pulse 2.4s var(--ease-io) infinite; }
    .chero__hi, .chero__hello .voice { display: inline-block; animation: rise var(--d-5) var(--ease-out) both; }
    .chero__hello .voice { animation-delay: 120ms; }
    .chero__cycle, .chero__lead, .chero__actions, .chero__status { animation: fade var(--d-5) var(--ease-out) 260ms both; }
    .chero__portrait { animation: rise 1.1s var(--ease-out) 200ms both; }
    .chero__portrait-card { animation: float 7s var(--ease-io) 1.3s infinite; }
    .chero[data-film-stills] .chero__stills img[data-active] { animation: kenburns 6s linear both; }
    :global(html[data-motion='off']) .chero__portrait-card, :global(html[data-motion='off']) .chero__stills img, :global(html[data-motion='off']) .live-dot, :global(html[data-motion='off']) .cycle__item::after { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) { .cycle__item::after { display: none; } }
  @keyframes pulse { 50% { box-shadow: 0 0 0 8px #6fd3a30d; } }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
  @keyframes kenburns { from { transform: scale(1.02) translate(0, 0); } to { transform: scale(1.12) translate(-2%, -1.5%); } }
  @keyframes caret { 50% { opacity: 0; } }
</style>

<script>import '../scripts/film';</script>
<script>import '../scripts/hero-motion';</script>
