---
/* "Work in orbit": a 3D ring of project cards that drifts round on its own.
   Drag or swipe to spin, use the arrows, or Tab through the cards (each one
   turns to the front). Without JS it's a plain swipeable row of links. */
import Figure from './Figure.astro';
import { projects } from '../data/projects';
import { statusLabel } from '../data/site';
const insideIds = ['katana', 'nookbase', 'inos', 'bitget', 'bp'];
const cards = projects.map(project => ({
  project,
  href: insideIds.includes(project.id) ? `/inside/${project.id}.html` : project.href,
  figure: project.id === 'bitget' ? 'bitget' : project.id === 'bp' ? 'bp' : 'ai-he',
}));
---
<section class="orbit-section" aria-labelledby="orbit-title">
  <div class="wrap orbit-head">
    <p class="label"><span class="section-mark">§</span> In orbit</p>
    <h2 id="orbit-title">Spin through <em class="voice">the work.</em></h2>
    <p class="orbit-hint" aria-hidden="true">Drag to spin · tap a card to step inside</p>
  </div>
  <div class="orbit" data-orbit style={`--n:${cards.length}`}>
    <ol class="orbit__ring" data-orbit-ring aria-label="Projects">
      {cards.map(({ project, href, figure }, index) => (
        <li class="orbit__item" style={`--i:${index}`} data-orbit-item>
          <a class="ocard" href={href} data-tilt>
            <span class="ocard__media" aria-hidden="true">
              {project.media ? <img src={project.media.image} alt="" width="1600" height="900" loading="lazy" decoding="async" /> : <span class="ocard__fig"><Figure kind={figure as 'bitget' | 'bp' | 'ai-he'} /></span>}
            </span>
            <span class="ocard__body">
              <span class="ocard__meta"><span>{project.org}</span><span class="num">{project.year}</span></span>
              <span class="ocard__name">{project.name}</span>
              <span class="ocard__summary">{project.summary}</span>
              <span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <div class="orbit__controls">
      <button type="button" class="orbit__btn" data-orbit-prev aria-label="Previous project">←</button>
      <span class="orbit__count num" data-orbit-count aria-live="polite"></span>
      <button type="button" class="orbit__btn" data-orbit-next aria-label="Next project">→</button>
    </div>
  </div>
</section>

<style>
  .orbit-section { position: relative; overflow: hidden; padding: var(--s-9, 96px) 0 var(--s-8, 72px); background: #070807; color: #f2f3ee; isolation: isolate; }
  .orbit-section::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 55% at 50% 58%, #d9ff3f1c, transparent 70%), linear-gradient(#ffffff06 1px, transparent 1px) 0 0 / 100% 48px; }
  .orbit-head { display: grid; gap: 10px; text-align: center; justify-items: center; }
  .orbit-head .label { color: #a7aca0; }
  .orbit-head .section-mark { color: #d9ff3f; }
  .orbit-head h2 { font-size: var(--step-h2); letter-spacing: -.045em; line-height: 1; }
  .orbit-head .voice { color: #d9ff3f; }
  .orbit-hint { font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #7d8277; }

  .orbit { --w: clamp(230px, 22vw, 320px); --r: calc(var(--w) * 1.12); position: relative; height: calc(var(--w) * 1.42 + 120px); perspective: 1400px; perspective-origin: 50% 40%; touch-action: pan-y; user-select: none; -webkit-user-select: none; cursor: grab; }
  .orbit[data-dragging] { cursor: grabbing; }
  .orbit__ring { position: absolute; left: 50%; top: 40px; width: var(--w); height: calc(var(--w) * 1.36); margin-left: calc(var(--w) / -2); transform-style: preserve-3d; transform: translateZ(calc(var(--r) * -1)) rotateY(var(--spin, 0deg)); }
  .orbit__item { position: absolute; inset: 0; transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--r)); backface-visibility: hidden; -webkit-backface-visibility: hidden; opacity: var(--o, 1); transition: opacity 200ms linear; }
  .ocard { display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: 20px; overflow: hidden; background: #121411; border: 1px solid #ffffff1f; color: #f2f3ee; text-decoration: none; box-shadow: 0 30px 60px -30px #000; -webkit-user-drag: none; }
  .ocard:focus-visible { outline: 2px solid #d9ff3f; outline-offset: 4px; }
  .ocard__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #0b0c0a; }
  .ocard__media img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .ocard__fig { display: grid; place-items: center; height: 100%; padding: 8px; background: #f1f2ef; color: #0d1015; }
  .ocard__fig :global(svg) { width: 100%; height: 100%; }
  .ocard__body { display: grid; align-content: start; gap: 8px; padding: 16px 16px 18px; }
  .ocard__meta { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .05em; text-transform: uppercase; color: #7d8277; }
  .ocard__name { font-size: clamp(1.25rem, 1rem + .8vw, 1.6rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.05; }
  .ocard__summary { font-size: 13.5px; line-height: 1.45; color: #a7aca0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ocard .chip { justify-self: start; }
  @media (hover: hover) { .ocard:hover { border-color: #d9ff3f; } }
  .orbit__controls { position: absolute; left: 0; right: 0; bottom: 8px; display: flex; justify-content: center; align-items: center; gap: 18px; }
  .orbit__btn { width: 48px; height: 48px; border-radius: 50%; border: 1px solid #ffffff3d; background: #070807cc; color: #f2f3ee; font-size: 18px; }
  .orbit__btn:hover { border-color: #d9ff3f; color: #d9ff3f; }
  .orbit__btn:focus-visible { outline: 2px solid #d9ff3f; outline-offset: 3px; }
  .orbit__count { min-width: 5ch; text-align: center; font-size: 12px; color: #a7aca0; }

  /* No JavaScript (or no 3D): a swipeable row of the same links. */
  :global(html:not(.js)) .orbit { height: auto; perspective: none; cursor: auto; }
  :global(html:not(.js)) .orbit__ring { position: static; display: flex; gap: 16px; width: auto; height: auto; margin: 0; padding: 24px var(--margin); overflow-x: auto; transform: none; scroll-snap-type: x mandatory; }
  :global(html:not(.js)) .orbit__item { position: static; flex: none; width: var(--w); height: calc(var(--w) * 1.36); transform: none; scroll-snap-align: center; }
  :global(html:not(.js)) .orbit__controls { display: none; }
  @media (max-width: 640px) { .orbit { --w: 66vw; --r: calc(var(--w) * 1.02); } }
</style>

<script>import '../scripts/orbit';</script>
