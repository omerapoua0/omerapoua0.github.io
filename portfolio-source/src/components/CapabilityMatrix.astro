---
import { capabilities, evidence, toolbox } from '../data/capabilities';
const label = (id: string) => evidence.find(item => item.id === id);
---
<div class="matrix" data-matrix data-reveal>
  <div class="matrix__scroll">
    <table class="matrix__table">
      <caption class="sr-only">Skills, and where my CV shows each one in use</caption>
      <thead>
        <tr>
          <th scope="col" class="matrix__corner"><span class="label">Skill / evidence</span></th>
          {evidence.map(item => <th scope="col" data-col={item.id}><a href={item.href}>{item.label}</a></th>)}
        </tr>
      </thead>
      {capabilities.map(group => (
        <tbody>
          <tr class="matrix__group"><th scope="colgroup" colspan={evidence.length + 1}><span class="label">{group.group}</span></th></tr>
          {group.skills.map(skill => (
            <tr>
              <th scope="row">{skill.name}</th>
              {evidence.map(item => (
                <td data-col={item.id}>{skill.in.includes(item.id) ? <span class="dot"><span class="sr-only">Used: {item.label}</span></span> : <span class="sr-only">Not shown</span>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
  <div class="matrix__list">
    {capabilities.map(group => (
      <section>
        <h3 class="label">{group.group}</h3>
        <dl>
          {group.skills.map(skill => (
            <div><dt>{skill.name}</dt><dd>{skill.in.map((id, index) => <>{index > 0 && ', '}<a href={label(id)?.href}>{label(id)?.label}</a></>)}</dd></div>
          ))}
        </dl>
      </section>
    ))}
  </div>
  <p class="matrix__toolbox"><span class="label">Toolbox</span> {toolbox}</p>
</div>

<style>
  .matrix__table { display: none; width: 100%; border-collapse: collapse; font-size: var(--step-small); }
  .matrix__table th, .matrix__table td { border-bottom: 1px solid var(--line); padding: 12px 10px; text-align: center; transition: background-color var(--d-2); }
  .matrix__table thead th { position: sticky; top: var(--header); background: var(--surface); z-index: 1; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .03em; text-transform: uppercase; font-weight: 500; border-bottom-color: var(--line-strong); vertical-align: bottom; }
  .matrix__table thead a { display: inline-flex; min-height: 32px; align-items: end; text-decoration: none; color: var(--muted); }
  .matrix__table thead a:hover, .matrix__table thead a:focus-visible { color: var(--accent); }
  .matrix__table tbody th[scope='row'] { text-align: left; font-weight: 480; padding-left: 0; width: 34%; }
  .matrix__corner { text-align: left !important; padding-left: 0 !important; }
  .matrix__group th { text-align: left; padding: 28px 0 10px; border-bottom-color: var(--line-strong); }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); vertical-align: middle; }
  .matrix__table tbody tr:not(.matrix__group):hover > *, .matrix__table [data-hot] { background: var(--accent-soft); }
  .matrix__table thead [data-hot] a { color: var(--accent); }
  .matrix__list { display: grid; gap: var(--s-6); }
  .matrix__list dl { border-top: 1px solid var(--line-strong); margin-top: var(--s-2); }
  .matrix__list dl > div { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .matrix__list dt { font-weight: 500; }
  .matrix__list dd { margin: 0; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); }
  .matrix__list dd a { color: var(--accent); text-decoration: none; display: inline-block; min-height: 24px; }
  .matrix__toolbox { margin-top: var(--s-7); display: grid; gap: var(--s-2); color: var(--muted); max-width: 80ch; }
  @media (min-width: 900px) {
    .matrix__table { display: table; }
    .matrix__list { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-matrix]').forEach(matrix => {
    const cells = [...matrix.querySelectorAll<HTMLElement>('[data-col]')];
    const light = (col?: string) => cells.forEach(cell => cell.toggleAttribute('data-hot', !!col && cell.dataset.col === col));
    cells.forEach(cell => {
      cell.addEventListener('pointerenter', () => light(cell.dataset.col));
      cell.addEventListener('focusin', () => light(cell.dataset.col));
    });
    matrix.addEventListener('pointerleave', () => light());
    matrix.addEventListener('focusout', event => { if (!matrix.contains(event.relatedTarget as Node)) light(); });
  });
</script>
