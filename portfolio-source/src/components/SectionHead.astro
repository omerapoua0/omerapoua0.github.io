---
interface Props { mark: string; label: string; id?: string; }
const { mark, label, id } = Astro.props;
---
<svg class="neon-line section-line" data-scrub viewBox="0 0 1200 26" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 13H520l10-10h140l10 10H1200" /><path pathLength="1" d="M0 19H500l10 6h180l10-6H1200" /></svg>
<div class="section-head" data-reveal>
  <div class="section-head__title">
    <p class="eyebrow"><b>{mark}</b>{label}</p>
    <h2 id={id}><slot /></h2>
  </div>
  {Astro.slots.has('aside') && <div><slot name="aside" /></div>}
</div>
