---
interface Props { mark: string; label: string; id?: string; }
const { mark, label, id } = Astro.props;
---
<div class="section-head" data-reveal>
  <div class="section-head__title">
    <p class="eyebrow"><b>{mark}</b>{label}</p>
    <h2 id={id}><slot /></h2>
  </div>
  {Astro.slots.has('aside') && <div><slot name="aside" /></div>}
</div>
