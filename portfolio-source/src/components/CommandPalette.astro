---
/* Site-wide command menu (⌘K / Ctrl+K, or the header button): pages, case
   studies, project tours, quick links and a few actions. A native <dialog>
   with a combobox + listbox; links still work without it. */
import { navigation, site } from '../data/site';
import { projects } from '../data/projects';

type Item = { group: string; label: string; hint: string; href?: string; action?: string; keywords?: string; external?: boolean };
const items: Item[] = [
  { group: 'Quick', label: 'See my work', hint: 'Case studies', href: '/work.html', keywords: 'projects portfolio' },
  { group: 'Quick', label: 'Book a lesson', hint: 'Free 15-minute intro call', href: '/tutoring.html#lesson-enquiry', keywords: 'gcse a-level maths physics tutor book lesson' },
  { group: 'Quick', label: 'Write to Omar', hint: 'Prepare an email', href: '/contact.html', keywords: 'email message contact hire' },
  { group: 'Quick', label: 'Skills & evidence', hint: 'Capability matrix', href: '/index.html#skills', keywords: 'python stack matrix skills' },
  { group: 'Pages', label: 'Home', hint: 'index.html', href: '/index.html', keywords: 'start' },
  ...navigation.filter(item => !item.href.includes('#')).map(item => ({ group: 'Pages', label: item.label, hint: item.href.replace('/', ''), href: item.href })),
  { group: 'Pages', label: 'Contact', hint: 'contact.html', href: '/contact.html', keywords: 'email message' },
  ...projects.map(project => ({ group: 'Work', label: project.name, hint: project.org, href: project.href, keywords: `${project.stack.join(' ')} ${project.role}` })),
  ...['katana', 'nookbase', 'inos', 'bitget', 'bp'].map(id => projects.find(project => project.id === id)!).filter(Boolean).map(project => ({ group: 'Tours', label: `${project.name} tour`, hint: 'Project tour', href: `/inside/${project.id}.html`, keywords: `tour inside ${project.org}` })),
  { group: 'Actions', label: 'Copy email address', hint: site.email, action: 'copy-email', keywords: 'mail contact' },
  { group: 'Actions', label: 'Download CV (PDF)', hint: 'Opens in a new tab', href: '/Omar-Aboelella-CV.pdf', external: true, keywords: 'resume' },
  { group: 'Actions', label: 'LinkedIn', hint: 'linkedin.com/in/omaraboelella', href: site.linkedin, external: true, keywords: 'profile social' },
  { group: 'Actions', label: 'GitHub', hint: 'github.com/omerapoua0', href: site.github, external: true, keywords: 'code source' },
];
---
<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette__search">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    <input type="text" data-palette-input role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" aria-label="Search pages, projects and actions" placeholder="Search pages, projects and actions…" autocomplete="off" spellcheck="false" />
    <button type="button" class="palette__esc" data-palette-close aria-label="Close command menu">Esc</button>
  </div>
  <ul class="palette__list" id="palette-list" role="listbox" aria-label="Results" data-palette-list>
    {items.map((item, index) => (
      <li id={`palette-${index}`} role="option" aria-selected="false" class="palette__item" data-group={item.group} data-href={item.href} data-action={item.action} data-external={item.external ? '' : undefined} data-keywords={item.keywords ?? ''}>
        <span class="palette__group" aria-hidden="true">{item.group}</span>
        <span class="palette__label">{item.label}</span>
        <span class="palette__hint">{item.hint}</span>
      </li>
    ))}
  </ul>
  <p class="palette__foot" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></p>
  <p class="sr-only" role="status" data-palette-status></p>
</dialog>

<style>
  .palette { width: min(640px, calc(100vw - 24px)); max-height: min(560px, calc(100dvh - 120px)); margin: 12vh auto auto; padding: 0; border: 1px solid var(--line); border-radius: 22px; background: var(--surface); color: var(--ink); box-shadow: 0 40px 120px -30px #000000cc, 0 0 0 1px #4d84ff40, 0 0 60px -20px #2f6bff80; overflow: hidden; }
  .palette[open] { display: flex; flex-direction: column; }
  .palette::backdrop { background: #07080bb3; backdrop-filter: blur(10px); }
  .palette__search { display: flex; align-items: center; gap: 12px; padding: 0 12px 0 18px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .palette__search input { flex: 1; min-width: 0; min-height: 60px; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 17px; outline: none; }
  .palette__search input::placeholder { color: #737a86; }
  .palette__esc { min-height: 30px; padding: 0 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-2); color: var(--muted); font-family: var(--font-mono); font-size: 11px; }
  .palette__list { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 8px; scrollbar-width: thin; }
  .palette__item { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; align-items: center; gap: 12px; min-height: 46px; padding: 6px 12px; border-radius: 12px; cursor: pointer; }
  .palette__item[aria-selected='true'] { background: var(--accent-fill); color: #fff; }
  .palette__group { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .palette__item[aria-selected='true'] .palette__group, .palette__item[aria-selected='true'] .palette__hint { color: #ffffff; }
  .palette__label { font-size: 15px; font-weight: 520; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .palette__hint { font-size: 12.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 24ch; }
  .palette__foot { display: flex; gap: 18px; padding: 10px 18px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); background: var(--bg-2); }
  .palette__foot kbd { font-family: var(--font-mono); font-size: 11px; padding: 1px 5px; margin-right: 4px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); }
  .palette :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .palette__search input:focus-visible { outline: none; }
  @media (max-width: 560px) {
    .palette { margin-top: 10px; max-height: calc(100dvh - 20px); }
    .palette__item { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 8px 12px; }
    .palette__group { display: none; }
    .palette__hint { max-width: none; }
    .palette__foot { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .palette[open] { animation: palette-in 260ms cubic-bezier(.23, 1, .32, 1); }
    .palette[open]::backdrop { animation: fade 220ms ease-out; }
  }
  @keyframes palette-in { from { opacity: 0; transform: translateY(-10px) scale(.97); } }
  @keyframes fade { from { opacity: 0; } }
</style>

<script>import '../scripts/palette';</script>
