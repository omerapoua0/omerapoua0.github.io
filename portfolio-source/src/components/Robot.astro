---
/* Otto, the robot host (a humanoid: black helmet faceplate, white armour,
   mechanical neck, shoulder caps and dark hands). A hand-built SVG rig; src/scripts/robot.ts drives
   data-state (idle, wave, talk, think, confused, cheeky, point, pew, and the
   hand-off: offer, grab, pull), blinks and eye tracking. Reduced or paused
   motion keeps a still pose. `still` renders a decorative Otto that no script
   drives (the hand-off cover's flyer), holding `pose`. */
interface Props { size?: 'xl' | 'lg' | 'sm'; label?: string; id?: string; still?: boolean; pose?: string }
const { size = 'lg', label = 'Otto, Omar’s robot host', id = 'otto', still = false, pose = 'idle' } = Astro.props;
const uid = `${id}-${size}`;
---
<div class:list={['robot', `robot--${size}`]} data-robot={still ? undefined : ''} data-robot-still={still ? '' : undefined} data-state={pose} role={still ? undefined : 'img'} aria-label={still ? undefined : label} aria-hidden={still ? 'true' : undefined}>
  <svg class="robot__svg" viewBox="0 0 200 240" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${uid}-shell`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fbfcf8" />
        <stop offset=".5" stop-color="#e3e6de" />
        <stop offset="1" stop-color="#a9ada2" />
      </linearGradient>
      <linearGradient id={`${uid}-glass`} x1="0" y1="0" x2=".4" y2="1">
        <stop offset="0" stop-color="#1a1e17" />
        <stop offset="1" stop-color="#050605" />
      </linearGradient>
      <radialGradient id={`${uid}-sheen`} cx=".3" cy=".2" r=".8">
        <stop offset="0" stop-color="#ffffff" stop-opacity=".6" />
        <stop offset=".5" stop-color="#ffffff" stop-opacity=".08" />
        <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`${uid}-shadow`} cx=".5" cy=".5" r=".5">
        <stop offset="0" stop-color="#000000" stop-opacity=".6" />
        <stop offset="1" stop-color="#000000" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`${uid}-rim`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffffff" stop-opacity=".35" />
        <stop offset=".5" stop-color="#ffffff" stop-opacity=".06" />
        <stop offset="1" stop-color="#e8eef8" stop-opacity=".4" />
      </linearGradient>
      <pattern id={`${uid}-led`} width="3.2" height="3.2" patternUnits="userSpaceOnUse">
        <circle cx="1.6" cy="1.6" r="1.25" fill="#e8eef8" />
      </pattern>
      <filter id={`${uid}-glow`} x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="2.4" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <ellipse class="robot__shadow" cx="100" cy="230" rx="46" ry="6" fill={`url(#${uid}-shadow)`} />

    <g class="robot__body">
      <!-- left arm (viewer's left): shoulder cap, white upper arm and forearm, dark hand -->
      <g class="robot__arm robot__arm--l">
        <rect x="45" y="150" width="20" height="36" rx="10" fill={`url(#${uid}-shell)`} stroke={`url(#${uid}-rim)`} />
        <rect x="47" y="184" width="16" height="6" rx="3" fill="#1a1d18" />
        <rect x="46.5" y="188" width="17" height="22" rx="8.5" fill={`url(#${uid}-shell)`} stroke="#ffffff24" />
        <rect x="47.5" y="208" width="15" height="13" rx="6" fill="#1a1d18" stroke="#ffffff2e" />
      </g>
      <!-- mechanical spine and the white chest shell -->
      <rect x="82" y="196" width="36" height="30" rx="8" fill="#1a1d18" />
      <path d="M82 202 H118 M82 209 H118 M82 216 H118" stroke="#5d6063" stroke-width="2" />
      <path d="M58 150 C58 140 70 134 100 134 C130 134 142 140 142 150 L138 182 C134 196 120 202 100 202 C80 202 66 196 62 182 Z" fill={`url(#${uid}-shell)`} stroke={`url(#${uid}-rim)`} stroke-width="1.4" />
      <path d="M58 150 C58 140 70 134 100 134 C130 134 142 140 142 150 L138 182 C134 196 120 202 100 202 C80 202 66 196 62 182 Z" fill={`url(#${uid}-sheen)`} />
      <path d="M60 160 Q100 168 140 160" fill="none" stroke="#00000030" stroke-width="1.2" />
      <rect x="82" y="164" width="36" height="24" rx="8" fill={`url(#${uid}-glass)`} stroke="#00000080" />
      <circle cx="100" cy="176" r="2.6" fill="#e8eef8" class="robot__badge" filter={`url(#${uid}-glow)`} />
      <text x="100" y="180" text-anchor="middle" class="robot__badge-text" opacity="0">O</text>
      <!-- neck: graphite column, cables, a lime ring -->
      <rect x="91" y="118" width="18" height="20" rx="5" fill="#1a1d18" />
      <path d="M94 119 V137 M106 119 V137" stroke="#5d6063" stroke-width="2" />
      <ellipse cx="100" cy="130" rx="11" ry="2.6" fill="none" stroke="#8d939a" stroke-width="2" />

      <!-- head: a helmet, white shell with a glossy black faceplate and lime-ringed ear modules -->
      <g class="robot__head">
        <line x1="100" y1="38" x2="100" y2="31" stroke="#3a3f37" stroke-width="3" stroke-linecap="round" />
        <circle class="robot__bead" cx="100" cy="29" r="3" fill="#e8eef8" filter={`url(#${uid}-glow)`} />
        <ellipse cx="100" cy="80" rx="44" ry="46" fill={`url(#${uid}-shell)`} stroke={`url(#${uid}-rim)`} stroke-width="1.6" />
        <ellipse cx="100" cy="80" rx="44" ry="46" fill={`url(#${uid}-sheen)`} />
        <path d="M60 74 C60 52 78 40 100 40 C122 40 140 52 140 74 C140 96 128 112 100 112 C72 112 60 96 60 74 Z" fill={`url(#${uid}-glass)`} stroke="#3a3f37" stroke-width="1.6" />
        <path d="M70 58 Q84 46 102 46 L76 96 Q64 84 66 70 Z" fill="#ffffff" opacity=".08" />
        <rect x="50" y="68" width="10" height="24" rx="5" fill="#1a1d18" stroke="#8d939a" stroke-width="1.6" />
        <rect x="140" y="68" width="10" height="24" rx="5" fill="#1a1d18" stroke="#8d939a" stroke-width="1.6" />
        <g class="robot__face" filter={`url(#${uid}-glow)`}>
          <g class="robot__eyes">
            <rect class="robot__eye robot__eye--l" x="76" y="73" width="17" height="4.5" rx="2.25" fill="#e8eef8" />
            <rect class="robot__eye robot__eye--r" x="107" y="73" width="17" height="4.5" rx="2.25" fill="#e8eef8" />
            
            
          </g>
          <path class="robot__brow robot__brow--l" d="M76 62 L92 59" stroke="#8d939a" stroke-width="2.4" stroke-linecap="round" />
          <path class="robot__brow robot__brow--r" d="M108 59 L124 62" stroke="#8d939a" stroke-width="2.4" stroke-linecap="round" />
          <g class="robot__mouth" opacity="0">
            <rect x="91" y="92" width="4" height="4" rx="2" fill="#e8eef8" />
            <rect x="98" y="92" width="4" height="4" rx="2" fill="#e8eef8" />
            <rect x="105" y="92" width="4" height="4" rx="2" fill="#e8eef8" />
          </g>
        </g>
        <text class="robot__q" x="150" y="44">?</text>
      </g>
      <!-- shoulder caps over the arms' tops -->
      <ellipse cx="55.5" cy="152" rx="15" ry="13" fill={`url(#${uid}-shell)`} stroke={`url(#${uid}-rim)`} />
      <!-- right arm (viewer's right): waves, points and offers his hand -->
      <g class="robot__arm robot__arm--r">
        <rect x="135" y="150" width="20" height="36" rx="10" fill={`url(#${uid}-shell)`} stroke={`url(#${uid}-rim)`} />
        <rect x="137" y="184" width="16" height="6" rx="3" fill="#1a1d18" />
        <rect x="136.5" y="188" width="17" height="10" rx="5" fill={`url(#${uid}-shell)`} stroke="#ffffff24" />
        <rect class="robot__finger" x="141.5" y="206" width="6" height="16" rx="3" fill="#1a1d18" stroke="#8d939a" />
        <rect class="robot__fist" x="137.5" y="196" width="15" height="14" rx="6" fill="#1a1d18" stroke="#ffffff2e" />
        <g class="robot__hand">
          <rect class="robot__thumb" x="131" y="196" width="5" height="11" rx="2.5" fill="#1a1d18" stroke="#ffffff33" />
          <rect class="robot__digit" x="136.6" y="205" width="4.2" height="12" rx="2.1" fill="#1a1d18" stroke="#ffffff33" />
          <rect class="robot__digit" x="142.3" y="206" width="4.2" height="13" rx="2.1" fill="#1a1d18" stroke="#ffffff33" />
          <rect class="robot__digit" x="148" y="205" width="4.2" height="12" rx="2.1" fill="#1a1d18" stroke="#ffffff33" />
          <rect x="135" y="194" width="19" height="14" rx="6" fill="#1a1d18" stroke="#ffffff33" />
          <circle class="robot__palm" cx="144.5" cy="201" r="3.2" fill="#e8eef8" filter={`url(#${uid}-glow)`} />
        </g>
      </g>
      <ellipse cx="144.5" cy="152" rx="15" ry="13" fill={`url(#${uid}-shell)`} stroke={`url(#${uid}-rim)`} />
    </g>
  </svg>
  <span class="robot__beam" aria-hidden="true"></span>
</div>

<style>
  .robot { --ex: 0px; --ey: 0px; position: relative; display: inline-block; flex: none; line-height: 0; -webkit-tap-highlight-color: transparent; }
  .robot--xl { width: 260px; }
  .robot--lg { width: 150px; }
  .robot--sm { width: 92px; }
  .robot__svg { width: 100%; height: auto; overflow: visible; }
  .robot__badge-text { font: 600 13px var(--font-mono, monospace); fill: #d9ff3f; }
  .robot__q { font: 700 26px var(--font-sans, sans-serif); fill: #e8eef8; opacity: 0; }
  .robot__brow { opacity: 0; }
  .robot__finger { opacity: 0; }
  .robot__hand { opacity: 0; }
  .robot__body, .robot__head, .robot__arm, .robot__eyes, .robot__eye, .robot__mouth, .robot__mouth rect, .robot__brow, .robot__q, .robot__finger, .robot__digit, .robot__thumb, .robot__hand, .robot__fist { transform-box: view-box; }
  .robot__digit { transform-origin: center 205px; }
  .robot__thumb { transform-origin: 134px 197px; }
  .robot__hand { transform-origin: 144.5px 198px; }
  .robot__svg { transform-origin: 50% 90%; }
  .robot__head { transform-origin: 100px 124px; }
  .robot__arm--l { transform-origin: 55.5px 152px; }
  .robot__arm--r { transform-origin: 144.5px 152px; }
  .robot__eyes { transform: translate(var(--ex), var(--ey)); }
  .robot__eye--l { transform-origin: 84.5px 75.25px; }
  .robot__eye--r { transform-origin: 115.5px 75.25px; }
  .robot__mouth { transform-origin: 100px 94px; }
  .robot__mouth rect { transform-origin: center 94px; }
  .robot[data-blink] .robot__glint, .robot[data-state='cheeky'] .robot__glint, .robot[data-state='confused'] .robot__glint { opacity: 0; }
  .robot[data-blink] .robot__eye { transform: scaleY(.12); }

  /* Poses (apply with or without motion; transitions only when motion is on). */
  .robot[data-state='think'] { --ex: 4px; --ey: -5px; }
  .robot[data-state='think'] .robot__head { transform: rotate(-4deg); }
  .robot[data-state='confused'] .robot__head { transform: rotate(9deg); }
  .robot[data-state='confused'] .robot__eye--r { transform: scaleY(.45); }
  .robot[data-state='confused'] .robot__q { opacity: 1; }
  .robot[data-state='confused'] .robot__brow--l { opacity: 1; transform: translateY(-2px) rotate(-8deg); }
  .robot[data-state='cheeky'] .robot__head { transform: rotate(-6deg); }
  .robot[data-state='cheeky'] .robot__brow--r { opacity: 1; transform: translateY(-4px); }
  .robot[data-state='cheeky'] .robot__eye--l { transform: scaleY(.35); }
  .robot[data-state='cheeky'] .robot__mouth { transform: translate(5px, -1px) rotate(-8deg); }
  .robot[data-state='wave'] .robot__arm--r { transform: rotate(-160deg); }
  .robot[data-state='point'] .robot__arm--r, .robot[data-state='pew'] .robot__arm--r { transform: rotate(-98deg); }
  .robot[data-state='point'] .robot__finger, .robot[data-state='pew'] .robot__finger { opacity: 1; }
  .robot[data-state='point'] .robot__head, .robot[data-state='pew'] .robot__head { transform: rotate(-3deg); }
  .robot[data-state='point'], .robot[data-state='pew'] { --ex: 5px; --ey: 0px; }
  .robot[data-state='point'] .robot__arm--l { transform: rotate(12deg); }

  /* The hand-off: he reaches out with an open hand (down toward the tray on
     phones: data-reach="down"), grips (fingers curl), then pulls you in. */
  .robot:is([data-state='offer'], [data-state='grab'], [data-state='pull']) .robot__hand { opacity: 1; }
  .robot:is([data-state='offer'], [data-state='grab'], [data-state='pull']) .robot__fist { opacity: 0; }
  .robot[data-state='offer'] .robot__arm--r, .robot[data-state='grab'] .robot__arm--r { transform: rotate(-64deg); }
  .robot[data-reach='down'][data-state='offer'] .robot__arm--r, .robot[data-reach='down'][data-state='grab'] .robot__arm--r { transform: rotate(-26deg); }
  .robot:is([data-state='offer'], [data-state='grab']) .robot__arm--l { transform: rotate(10deg); }
  .robot:is([data-state='offer'], [data-state='grab']) .robot__head { transform: rotate(-4deg); }
  .robot:is([data-state='offer'], [data-state='grab'], [data-state='pull']) { --ex: 5px; --ey: 3px; }
  .robot[data-reach='down']:is([data-state='offer'], [data-state='grab'], [data-state='pull']) { --ex: 3px; --ey: 5px; }
  .robot:is([data-state='grab'], [data-state='pull']) .robot__digit { transform: scaleY(.42); }
  .robot:is([data-state='grab'], [data-state='pull']) .robot__thumb { transform: rotate(-38deg); }
  .robot[data-state='grab'] .robot__hand { transform: scale(.92); }
  .robot[data-state='pull'] .robot__arm--r { transform: rotate(-30deg); }
  .robot[data-reach='down'][data-state='pull'] .robot__arm--r { transform: rotate(-12deg); }
  .robot[data-state='pull'] .robot__arm--l { transform: rotate(-14deg); }
  .robot[data-state='pull'] .robot__head { transform: rotate(5deg); }
  .robot[data-state='pull'] .robot__svg { transform: rotate(-6deg) translate(-4px, -8px) scale(.96); }

  .robot__beam { position: absolute; left: 92%; top: 40%; width: min(70vw, 720px); height: 3px; border-radius: 3px; background: linear-gradient(90deg, #d9ff3f, #f4ffc2 40%, #d9ff3f00); box-shadow: 0 0 18px 4px #d9ff3f80; transform-origin: left center; transform: scaleX(0); opacity: 0; pointer-events: none; z-index: 5; }
  .robot--sm .robot__beam { top: 38%; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='off'])) .robot__body { animation: robot-float 3.2s ease-in-out infinite; }
    :global(html:not([data-motion='off'])) .robot__shadow { animation: robot-shadow 3.2s ease-in-out infinite; transform-origin: 100px 226px; transform-box: view-box; }
    :global(html:not([data-motion='off'])) .robot__bead { animation: robot-bead 2.4s ease-in-out infinite; }
    .robot__head, .robot__arm, .robot__brow, .robot__q, .robot__finger, .robot__mouth { transition: transform 420ms cubic-bezier(.34, 1.56, .64, 1), opacity 200ms ease-out; }
    .robot__hand, .robot__fist { transition: opacity 160ms ease-out, transform 160ms ease-out; }
    .robot__digit, .robot__thumb { transition: transform 150ms cubic-bezier(.3, 0, .2, 1); }
    .robot__svg { transition: transform 320ms cubic-bezier(.3, 0, .2, 1); }
    .robot[data-state='pull'] .robot__arm { transition-duration: 320ms; transition-timing-function: cubic-bezier(.5, 0, .2, 1); }
    /* Grip: his palm light flares as the fingers close. */
    :global(html:not([data-motion='off'])) .robot[data-state='grab'] .robot__palm { animation: robot-grip 260ms ease-out both; }
    /* Then he dives toward you, his chest badge (where the lime iris opens) held still. */
    :global(html:not([data-motion='off'])) .robot[data-dive] { transform-origin: 50% 73.3%; animation: robot-dive 560ms cubic-bezier(.45, 0, .8, .45) both; }
    /* The glow filters would be re-rasterised at up to 4.6x: drop them for the dive. */
    .robot[data-dive] :global([filter]) { filter: none; }
    .robot__eyes { transition: transform 160ms ease-out; }
    .robot__eye { transition: transform 90ms ease-out; }
    :global(html:not([data-motion='off'])) .robot[data-state='wave'] .robot__arm--r { animation: robot-wave 1.1s ease-in-out; }
    :global(html:not([data-motion='off'])) .robot[data-state='talk'] .robot__mouth rect { animation: robot-talk 360ms ease-in-out infinite; }
    :global(html:not([data-motion='off'])) .robot[data-state='talk'] .robot__mouth rect:nth-child(2) { animation-delay: 120ms; }
    :global(html:not([data-motion='off'])) .robot[data-state='talk'] .robot__mouth rect:nth-child(3) { animation-delay: 240ms; }
    :global(html:not([data-motion='off'])) .robot[data-state='talk'] .robot__head { animation: robot-nod 900ms ease-in-out infinite; }
    :global(html:not([data-motion='off'])) .robot[data-state='think'] .robot__bead { animation-duration: .6s; }
    :global(html:not([data-motion='off'])) .robot[data-state='pew'] .robot__beam { animation: robot-beam 520ms cubic-bezier(.2, .8, .2, 1) both; }
    :global(html:not([data-motion='off'])) .robot[data-state='pew'] .robot__body { animation: robot-recoil 300ms ease-out; }
  }
  @keyframes robot-float { 50% { transform: translateY(-6px); } }
  @keyframes robot-shadow { 50% { transform: scale(.82); opacity: .7; } }
  @keyframes robot-bead { 50% { opacity: .45; } }
  @keyframes robot-wave { 0%, 100% { transform: rotate(-160deg); } 20%, 60% { transform: rotate(-182deg); } 40%, 80% { transform: rotate(-138deg); } }
  @keyframes robot-talk { 50% { transform: scaleY(2.4); } }
  @keyframes robot-nod { 50% { transform: rotate(2deg) translateY(1px); } }
  @keyframes robot-beam { 0% { transform: scaleX(0); opacity: 1; } 55% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes robot-recoil { 30% { transform: translateX(-6px); } }
  @keyframes robot-grip { 40% { transform: scale(1.9); opacity: 1; } 100% { transform: scale(1); } }
  @keyframes robot-dive { to { transform: scale(4.6); } }
  .robot__palm { transform-box: fill-box; transform-origin: center; }
</style>

<script>import '../scripts/robot';</script>
