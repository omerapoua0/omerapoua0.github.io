---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { caseStudies, projects } from '../data/projects';
---
<Base title="Projects" description="Case studies from Omar Aboelella: KATANA network autonomy, NOOKBASE, INOS & OctiMind, Bitget prediction models and BP’s competitor intelligence pipeline.">
  <PageIntro section="Projects" meta={[`${caseStudies.length} case studies`, '2024 – present']}>
    <Fragment slot="title">From a hard question <em class="voice">to a working system.</em></Fragment>
    <p class="lede">AI product engineering, a learning product, market modelling and the quieter infrastructure that makes good decisions possible.</p>
    <p slot="aside" class="note">Every case study separates my contribution from the wider team’s work and states its current stage. Concept visuals are labelled as such; they are not product footage.</p>
  </PageIntro>

  <section class="section wrap" aria-labelledby="index-title">
    <h2 id="index-title" class="sr-only">Project index</h2>
    <ProjectIndex items={projects} filters label="All projects" />
  </section>

  <section class="wrap" aria-label="Case studies">
    {caseStudies.map((project, index) => <CaseStudy project={project} number={index + 1} />)}
  </section>

  <section class="section wrap">
    <div class="closing">
      <p class="label"><span class="section-mark">§</span> A conversation, not a pitch deck</p>
      <h2>Interested in the decisions <em class="voice">behind the work?</em></h2>
      <p class="muted">I’m happy to talk through the parts I can share.</p>
      <div class="actions"><a class="btn btn--accent" href="/contact.html?topic=Project">Discuss a project <span class="arrow" aria-hidden="true">↗</span></a><a class="btn btn--ghost" href="/cv.html">Experience & CV</a></div>
    </div>
  </section>
</Base>

<style>
  .closing { display: grid; gap: var(--s-5); padding-top: var(--section); border-top: 1px solid var(--line); }
  .closing h2 { max-width: 18ch; }
</style>
