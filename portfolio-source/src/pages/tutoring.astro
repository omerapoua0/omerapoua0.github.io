---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Marquee from '../components/Marquee.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionHead from '../components/SectionHead.astro';
import '../styles/forms.css';
import { site } from '../data/site';

const trust = [
  { title: 'Enhanced DBS checked', copy: 'For parents’ peace of mind.' },
  { title: 'Free 15-minute intro call', copy: 'Meet before you commit to anything.' },
  { title: 'Reply within one working day', copy: 'To every lesson enquiry.' },
  { title: 'Parents welcome to sit in', copy: 'Join any lesson, any time.' },
  { title: 'No payment taken online', copy: 'Pricing is agreed directly.' },
];
const levels = [
  { name: 'GCSE Foundation', copy: 'Build the foundations, one clear step at a time.' },
  { name: 'GCSE Higher', copy: 'Connect concepts and tackle unfamiliar problems.' },
  { name: 'A-level', copy: 'Go deeper into reasoning, proof and exam technique.' },
];
const process = [
  { title: 'Send an enquiry', copy: 'The form below prepares an email that you check and send yourself.' },
  { title: 'I reply within one working day', copy: 'With questions, availability and next steps.' },
  { title: 'Free 15-minute intro call', copy: 'With the student and, for under-18s, a parent or guardian.' },
  { title: 'Agree the details', copy: 'Lesson length, times and pricing, agreed directly by email.' },
  { title: 'First lesson', copy: 'We start from where you are, not from where the textbook is.' },
];
const relationships = [
  { value: 'A parent or guardian', hint: 'Enquiring for your child.' },
  { value: 'A student aged 18 or over', hint: 'Enquiring for yourself.' },
  { value: 'A student under 18', hint: 'We’ll include a parent or guardian.' },
];
const subjects = [
  { value: 'Maths', glyph: '∑', hint: 'Patterns, problems and a method that makes sense.' },
  { value: 'Science', glyph: 'ψ', hint: 'Physics, chemistry, biology or combined science.' },
  { value: 'Maths & science', glyph: '+', hint: 'We’ll find a useful balance.' },
];
const levelChoices = [
  { value: 'GCSE Foundation', glyph: 'i', hint: 'Build the foundations.' },
  { value: 'GCSE Higher', glyph: 'ii', hint: 'Connect concepts.' },
  { value: 'A-level', glyph: 'iii', hint: 'Reasoning and exam technique.' },
];
const stepNames = ['Who', 'Subject', 'Level', 'Goals', 'Details'];
const faqs = [
  { q: 'Which subjects and levels can I enquire about?', a: 'Maths and science at GCSE Foundation, GCSE Higher and A-level. Tell me your exam board and topics so we can confirm a good fit on the intro call.' },
  { q: 'How much do lessons cost?', a: 'Lesson length, pricing and availability are agreed directly once we’ve discussed what you need. No payment is taken on this website.' },
  { q: 'Is sending the form a booking?', a: 'No. The form prepares an email that you send yourself. I reply within one working day, we have a free 15-minute intro call, and then agree times together.' },
  { q: 'How do you keep under-18s safe?', a: 'I hold an enhanced DBS check. Lessons for under-18s are arranged with a parent or guardian, who is welcome to sit in on any lesson.' },
  { q: 'Who will be teaching?', a: 'Me. I’m a Mathematics & Physics Teaching Assistant at Southfields Academy, teaching GCSE Higher maths and physics, and I study Computer Science & Mathematics at Birkbeck.' },
];
---
<Base title="Maths & science lessons" description="Online maths and science lessons for GCSE Foundation, GCSE Higher and A-level with Omar Aboelella. Enhanced DBS checked, free 15-minute intro call, reply within one working day.">
  <PageHero
    index={5}
    section="Lessons"
    meta={['Online', 'GCSE & A-level', 'Maths · Science']}
    watermark="MATHS"
    lines={[{ text: 'Maths & science,' }, { text: 'made clear.', accent: true }]}
    chips={[
      { text: 'DBS', label: 'enhanced check · for parents’ peace of mind' },
      { value: 15, label: 'minute intro call · free' },
      { value: 1, label: 'working day · to reply to every enquiry' },
      { value: levels.length, label: 'levels · GCSE Foundation to A-level' },
    ]}
  >
    <p class="lede">Personal online lessons for GCSE Foundation, GCSE Higher and A-level. Build a method you understand, not just an answer you remember.</p>
    <div slot="aside" class="creds">
      <p class="creds__kicker"><span class="creds__dot" aria-hidden="true"></span>Your tutor</p>
      <div class="creds__who">
        <picture>
          <source srcset="/portrait-avatar.webp" type="image/webp" />
          <img src="/portrait-avatar.jpg" alt="" width="96" height="96" loading="eager" decoding="async" />
        </picture>
        <p><strong>Omar Aboelella</strong><span>Maths &amp; Physics TA · Southfields Academy</span></p>
      </div>
      <dl>
        <div><dt class="label">Teaching now</dt><dd>Mathematics &amp; Physics Teaching Assistant, Southfields Academy: GCSE Higher maths and physics for international and EAL students.</dd></div>
        <div><dt class="label">Studying</dt><dd>BSc Computer Science &amp; Mathematics, Birkbeck, University of London.</dd></div>
      </dl>
    </div>
    <Fragment slot="actions">
      <a class="btn btn--accent" href="#lesson-enquiry" data-magnetic>Start a lesson enquiry <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
      <a class="btn btn--ghost" href="#how">How it works</a>
    </Fragment>
  </PageHero>

  <section class="trust" aria-label="What you can expect">
    <ul class="wrap trust__list" data-reveal-stagger="scale">
      {trust.map(item => <li><span class="trust__mark" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12"><path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span><strong>{item.title}</strong><span>{item.copy}</span></span></li>)}
    </ul>
  </section>

  <Marquee rows={[['GCSE Foundation', 'GCSE Higher', 'A-level', 'Maths', 'Physics'], ['Chemistry', 'Biology', 'Combined science', 'Exam technique', 'Proof']]} size="md" tone="clear" />

  <section class="stage" aria-labelledby="levels-title">
    <div class="wrap">
      <SectionHead mark="01" label="Levels" id="levels-title">One path, <em class="voice">your pace.</em>
        <p slot="aside">Choose your current course, not the grade you hope to reach. We start from where you are.</p>
      </SectionHead>
      <ol class="levels">
        <li class="levels__path" aria-hidden="true"><i data-fx="grow-x"></i></li>
        {levels.map((level, index) => (
          <li class="level" data-reveal="scale" style={`--reveal-delay:${index * 120}ms`} data-glow data-tilt>
            <span class="level__step"><span class="idx">{['i', 'ii', 'iii'][index]}</span></span>
            <h3>{level.name}</h3>
            <p class="muted">{level.copy}</p>
            <a class="go" href="#lesson-enquiry">Enquire for {level.name} <span aria-hidden="true">↓</span></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="stage stage--white" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <SectionHead mark="02" label="How it starts" id="how-title">From enquiry <em class="voice">to first lesson.</em>
        <p slot="aside">Five steps, no payment online. Nothing is booked until we’ve talked and agreed the details by email.</p>
      </SectionHead>
      <ol class="process">
        <li class="process__line" aria-hidden="true"><i data-fx="grow-y"></i></li>
        {process.map((step, index) => (
          <li class="process__step" data-reveal="right" style={`--reveal-delay:${index * 80}ms`}>
            <span class="process__num num">{index + 1}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="stage stage--grey" id="lesson-enquiry" aria-labelledby="enquiry-title">
    <div class="wrap">
    <SectionHead mark="03" label="Lesson enquiry" id="enquiry-title">A little about you, <em class="voice">a better first call.</em>
      <p slot="aside">Five short steps. At the end you check your answers and send the email from your own app. Nothing is sent, stored or booked by this website.</p>
    </SectionHead>
    <div class="form-shell" data-form-shell>
      <aside class="form-shell__aside" aria-label="Your lesson brief">
        <div class="brief form-panel">
          <p class="label">Your lesson brief</p>
          <dl class="brief__list">
            <div><dt>Enquiring as</dt><dd data-brief="relationship" data-empty="—">—</dd></div>
            <div><dt>Subject</dt><dd data-brief="subject" data-empty="—">—</dd></div>
            <div><dt>Science</dt><dd data-brief="science" data-empty="—">—</dd></div>
            <div><dt>Level</dt><dd data-brief="level" data-empty="—">—</dd></div>
            <div><dt>Exam board</dt><dd data-brief="board" data-empty="—">—</dd></div>
            <div><dt>Main goal</dt><dd data-brief="goal" data-empty="—">—</dd></div>
            <div><dt>Timing</dt><dd data-brief="timing" data-empty="—">—</dd></div>
          </dl>
          <p class="brief__foot">Online · free 15-minute intro call · pricing and times agreed directly</p>
        </div>
        <p class="note">If the student is under 18, a parent or guardian arranges lessons and is included in emails. Please don’t include a school name, home address or other sensitive details.</p>
        <p class="muted small">Prefer a simple email? <a href={`mailto:${site.email}?subject=${encodeURIComponent('Lesson enquiry')}`}>{site.email}</a></p>
      </aside>

      <div class="form-shell__main form-panel">
        <noscript>
          <h3>Let’s talk about lessons.</h3>
          <p>Email your subject, level, exam board and what you’d like help with to <a href={`mailto:${site.email}`}>{site.email}</a>. The guided form needs JavaScript; email works without it.</p>
        </noscript>
        <form data-enquiry="lessons" hidden>
          <div class="form-progress" data-progress>
            <ol class="steps" aria-hidden="true">{stepNames.map(name => <li data-step-item title={name}></li>)}</ol>
            <p class="step-label" data-step-label>Step 1 of 5</p>
            <p class="brief-line" data-brief-line data-empty="Your brief builds as you answer."></p>
          </div>
          <div class="error-summary" data-errors tabindex="-1" role="alert" hidden><h3>Check this step</h3><ul></ul></div>

          <fieldset class="form-step" data-step data-title="Who is enquiring">
            <legend tabindex="-1">Who is enquiring?</legend>
            <div class="choices" data-label="Enquiring as">
              {relationships.map((item, index) => <label class="choice"><input type="radio" id={`rel-${index}`} name="relationship" value={item.value} required /><span class="choice__card"><span class="choice__title">{item.value}</span><span class="choice__hint">{item.hint}</span></span></label>)}
            </div>
            <div class="conditional" data-when="relationship=A student under 18" hidden>
              <p class="note">Lessons for under-18s are arranged with a parent or guardian. Add their email so they can be copied in.</p>
              <label class="field">Parent or guardian’s email<input id="guardian-email" name="guardian_email" type="email" autocomplete="off" maxlength="150" required data-label="Parent or guardian’s email" /></label>
            </div>
          </fieldset>

          <fieldset class="form-step" data-step data-title="Subject">
            <legend tabindex="-1">What are we tackling?</legend>
            <p>Pick a subject. We can explore the details on the intro call.</p>
            <div class="choices" data-label="Subject">
              {subjects.map((item, index) => <label class="choice"><input type="radio" id={`subject-${index}`} name="subject" value={item.value} required /><span class="choice__card"><span class="choice__glyph" aria-hidden="true">{item.glyph}</span><span class="choice__title">{item.value}</span><span class="choice__hint">{item.hint}</span></span></label>)}
            </div>
            <div class="conditional" data-when="subject=Science|Maths & science" hidden>
              <label class="field">Which science?<select id="science" name="science" required data-label="Science"><option value="">Choose a science</option><option>Physics</option><option>Chemistry</option><option>Biology</option><option>Combined science</option><option>Not sure yet</option></select></label>
            </div>
          </fieldset>

          <fieldset class="form-step" data-step data-title="Level">
            <legend tabindex="-1">Which course are you studying?</legend>
            <p>Your current course, not the grade you hope to reach.</p>
            <div class="choices" data-label="Level">
              {levelChoices.map((item, index) => <label class="choice"><input type="radio" id={`level-${index}`} name="level" value={item.value} required /><span class="choice__card"><span class="choice__glyph" aria-hidden="true">{item.glyph}</span><span class="choice__title">{item.value}</span><span class="choice__hint">{item.hint}</span></span></label>)}
            </div>
            <label class="field">Exam board<select id="board" name="board" required data-label="Exam board"><option value="">Choose an exam board</option><option>AQA</option><option>Edexcel (Pearson)</option><option>OCR</option><option>WJEC / Eduqas</option><option>Cambridge International</option><option>Not sure</option></select></label>
          </fieldset>

          <fieldset class="form-step" data-step data-title="Goals and timing">
            <legend tabindex="-1">What would help most?</legend>
            <div class="field-grid">
              <label class="field">Main goal<select id="goal" name="goal" required data-label="Main goal"><option value="">Choose your focus</option><option>Build confidence and understanding</option><option>Prepare for exams</option><option>Work towards a higher grade</option><option>Catch up on specific topics</option></select></label>
              <label class="field">Timing<select id="timing" name="timing" required data-label="Timing"><option value="">Choose a timeframe</option><option>Exam within 3 months</option><option>Exam later this academic year</option><option>No exam soon</option></select></label>
              <label class="field">Preferred days<select id="days" name="days" required data-label="Preferred days"><option value="">Choose a preference</option><option>Weekdays</option><option>Weekends</option><option>Flexible</option></select></label>
              <label class="field">Preferred time<select id="time" name="time" required data-label="Preferred time"><option value="">Choose a preference</option><option>Morning</option><option>Afternoon</option><option>Evening</option><option>Flexible</option></select></label>
            </div>
            <label class="field">Time zone<input id="timezone" name="timezone" value="Europe/London" maxlength="60" required data-label="Time zone" /></label>
            <label class="field">Anything else? <span class="optional">(optional)</span><textarea id="lesson-message" name="message" rows="3" maxlength="500" data-label="Notes" placeholder="A difficult topic, an upcoming mock, how you like to learn"></textarea></label>
            <label class="check"><input id="intro" type="checkbox" name="intro" value="Yes, please" checked data-label="Free 15-minute intro call" /><span>I’d like a free 15-minute introductory call first</span></label>
            <p class="form-hint">These are preferences, not reserved times. We agree lesson length, times and pricing by email.</p>
          </fieldset>

          <fieldset class="form-step" data-step data-title="Your details">
            <legend tabindex="-1">Who am I replying to?</legend>
            <div class="field-grid">
              <label class="field">Your name<input id="lesson-name" name="name" autocomplete="name" maxlength="80" required data-label="Name" /></label>
              <label class="field">Your email<input id="lesson-email" name="email" type="email" autocomplete="email" maxlength="150" required data-label="Email" /></label>
            </div>
            <p class="sent-note">This page prepares an email for you. Nothing is sent or stored until you send it from your own email app.</p>
          </fieldset>

          <div class="form-nav" data-navigation>
            <button class="btn btn--ghost" type="button" data-back><span aria-hidden="true">←</span> Back</button>
            <button class="btn btn--accent" type="submit" data-next>Continue <span aria-hidden="true">→</span></button>
          </div>

          <section class="review" data-review hidden aria-labelledby="lesson-review-title">
            <p class="label">Ready to send from your email</p>
            <h3 id="lesson-review-title" tabindex="-1" class="review__title">Check your answers</h3>
            <dl class="review__summary" data-summary></dl>
            <p class="sent-note"><strong>Nothing has been sent.</strong> Open the draft, check it, and press send in your email app. I’ll reply within one working day.</p>
            <p class="note" data-length-warning hidden>Your enquiry is long, so some email apps may cut it short. Copy it and paste it into a new email instead.</p>
            <div class="actions">
              <a class="btn btn--accent" data-email href={`mailto:${site.email}`}>Open email draft <span class="arrow" aria-hidden="true">↗</span></a>
              <button class="btn btn--ghost" type="button" data-copy>Copy enquiry</button>
              <a class="btn btn--ghost gmail-link" data-gmail href="https://mail.google.com/" target="_blank" rel="noopener">Open in Gmail <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
            <details><summary>Show the full email text</summary><label class="sr-only" for="lesson-draft">Prepared email text</label><textarea id="lesson-draft" data-draft rows="12" readonly></textarea></details>
            <p class="muted small">No email app? Copy the text into an email to <a href={`mailto:${site.email}`}>{site.email}</a>. <button class="text-btn" type="button" data-edit>Start again from step 1</button></p>
          </section>
          <p class="form-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
    </div>
    </div>
  </section>

  <section class="stage" aria-labelledby="faq-title">
    <div class="wrap faq-wrap">
      <SectionHead mark="04" label="Questions" id="faq-title">Before you <em class="voice">enquire.</em></SectionHead>
      <div class="faq" data-reveal-stagger>
        {faqs.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
      </div>
    </div>
  </section>

  <ContactBand
    title="Not about lessons?"
    accent="Write anyway."
    lede="Projects, roles or research: the general contact form prepares an email you check and send yourself. For lessons, the enquiry above is quickest."
    next={{ href: '/contact.html', label: 'Contact', note: 'Email, LinkedIn, GitHub, or a short guided message.' }}
  />

  <div class="sticky-cta" data-sticky-cta="#lesson-enquiry, #page-title, footer" hidden>
    <a class="btn btn--accent" href="#lesson-enquiry">Start a lesson enquiry <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
  </div>
  <script>import '../scripts/forms';</script>
</Base>

<style>
  .creds { display: grid; gap: var(--s-4); padding: clamp(22px, 2.6vw, 30px); border-radius: var(--radius-3); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-3); }
  .creds__kicker { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .creds__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px var(--accent-soft); }
  .creds__who { display: flex; align-items: center; gap: 14px; }
  .creds__who img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--accent), 0 0 14px #2f6bff80; }
  .creds__who p { display: grid; gap: 2px; }
  .creds__who span { font-size: var(--step-small); color: var(--muted); }
  .creds dl { display: grid; border-top: 1px solid var(--line); }
  .creds dl > div { display: grid; gap: 6px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .creds dd { margin: 0; font-size: var(--step-small); }

  .trust { padding-block: clamp(20px, 3vw, 36px); }
  .trust__list { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }
  .trust__list li { display: flex; gap: 12px; padding: 18px; border-radius: var(--radius-2); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); }
  .trust__list li > span:last-child { display: grid; gap: 2px; font-size: var(--step-small); }
  .trust__list li > span:last-child > span { color: var(--muted); font-size: 14px; }
  .trust__mark { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-fill); color: var(--accent-ink); }
  @media (min-width: 1100px) { .trust__list { grid-template-columns: repeat(5, 1fr); } }

  .levels { position: relative; display: grid; gap: 16px; }
  .levels__path { display: none; }
  .level { --gx: 50%; --gy: 50%; position: relative; display: grid; gap: var(--s-3); align-content: start; padding: 28px; border-radius: var(--radius-3); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-2); overflow: hidden; }
  .level::before { content: ''; position: absolute; inset: 0; background: radial-gradient(320px circle at var(--gx) var(--gy), #2f6bff17, transparent 60%); opacity: 0; transition: opacity 300ms; pointer-events: none; }
  .level:hover::before { opacity: 1; }
  .level__step { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 18px; background: var(--bg); }
  .level__step .idx { font-size: 15px; }
  .level h3 { font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.6rem); letter-spacing: -.05em; }
  .level:last-of-type { background: var(--accent-fill); color: #fff; border-color: var(--accent); }
  .level:last-of-type :is(.muted, .go) { color: #ffffff; }
  /* An opaque step badge (no translucent white over the blue) keeps the
     index at AA contrast. */
  .level:last-of-type :is(.idx, .idx span) { color: #ffffff; }
  .level:last-of-type .level__step { background: var(--accent-hover); }
  @media (min-width: 900px) {
    .levels { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
    .levels__path { display: block; position: absolute; left: 10%; right: 10%; top: 56px; height: 2px; background: var(--line); }
    .levels__path i { position: absolute; inset: 0; background: var(--accent-fill); transform-origin: 0 50%; }
    .level:nth-of-type(3) { translate: 0 28px; }
    .level:nth-of-type(4) { translate: 0 56px; }
    .levels { padding-bottom: 56px; }
  }

  .process { position: relative; display: grid; gap: 14px; padding-left: 64px; }
  .process__line { position: absolute; left: 23px; top: 24px; bottom: 24px; width: 2px; background: var(--line); }
  .process__line i { position: absolute; inset: 0; background: var(--accent-fill); transform-origin: 50% 0; }
  .process__step { position: relative; display: grid; gap: 4px; padding: 20px 22px; border-radius: var(--radius-2); background: var(--bg-2); border: 1px solid var(--line); }
  .process__num { position: absolute; left: -64px; top: 16px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--surface); border: 2px solid var(--accent); color: var(--accent); font-size: 14px; font-weight: 600; box-shadow: 0 0 0 6px var(--surface); }
  .process h3 { font-size: 1.2rem; }
  @media (min-width: 1100px) {
    .process { grid-template-columns: repeat(5, minmax(0, 1fr)); padding-left: 0; padding-top: 74px; gap: var(--gutter); }
    .process__line { left: 24px; right: 24px; top: 24px; bottom: auto; width: auto; height: 2px; }
    .process__line i { transform-origin: 0 50%; }
    .process__line i { animation-name: fx-grow-x !important; }
    .process__step { background: transparent; border: 0; padding: 0; }
    .process__num { left: 0; top: -74px; }
  }

  .brief__list { display: grid; margin-top: var(--s-3); }
  .brief__list > div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: var(--step-small); }
  .brief__list dt { color: var(--muted); }
  .brief__list dd { margin: 0; font-weight: 520; color: var(--muted); transition: color var(--d-3); }
  .brief__list dd[data-filled] { color: var(--accent); }
  .brief__foot { margin-top: var(--s-4); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .03em; text-transform: uppercase; color: var(--muted); }
  .brief-line { display: none; font-size: 14px; font-weight: 520; color: var(--accent); }
  .small { font-size: var(--step-small); }
  .text-btn { border: 0; padding: 0; background: none; color: var(--accent); text-decoration: underline; text-underline-offset: .2em; min-height: 24px; }
  .review__title { font-size: var(--step-h3); }
