---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import '../styles/forms.css';
import { site } from '../data/site';

const topics = [
  { value: 'Project', title: 'A project', hint: 'Build something useful together.' },
  { value: 'Automation', title: 'An automation', hint: 'Make a repeated process work better.' },
  { value: 'Research', title: 'Research', hint: 'Compare questions and ideas.' },
  { value: 'Opportunity', title: 'An opportunity', hint: 'A role, internship or collaboration.' },
  { value: 'Hello', title: 'Just saying hello', hint: 'That’s a good reason too.' },
];
---
<Base title="Contact" description="Talk to Omar Aboelella about an AI project, an automation, a research question or an opportunity. Prepares an email you send yourself.">
  <PageIntro section="Contact" meta={['London, UK', 'Prepares an email you send']}>
    <Fragment slot="title">What are you <em class="voice">working on?</em></Fragment>
    <p class="lede">A project, a question, a workflow that takes too long. Tell me where you are and what you’re trying to figure out.</p>
    <div slot="aside" class="contact-direct">
      <p class="label">Direct</p>
      <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
      <p class="muted">Looking for maths or science lessons? <a href="/tutoring.html#lesson-enquiry">Start a lesson enquiry instead ↗</a></p>
    </div>
  </PageIntro>

  <section class="section wrap" aria-labelledby="contact-form-title">
    <h2 id="contact-form-title" class="sr-only">Prepare a message</h2>
    <div class="form-shell" data-form-shell>
      <aside class="form-shell__aside" aria-label="What to include">
        <p class="label"><span class="section-mark">§</span> A useful first message</p>
        <p>You don’t need a polished brief. A little context and a clear question are enough.</p>
        <dl class="include">
          <div><dt>For projects</dt><dd>The problem, the current tools and what a useful outcome would look like.</dd></div>
          <div><dt>For research</dt><dd>The question, paper or opportunity you’d like to discuss.</dd></div>
          <div><dt>For opportunities</dt><dd>The role or collaboration, and the timing.</dd></div>
        </dl>
        <p class="note">Please leave out passwords, private records and other sensitive information.</p>
      </aside>
      <div class="form-shell__main form-panel">
        <noscript><h3>Email works without a form.</h3><p>Send your message to <a href={`mailto:${site.email}`}>{site.email}</a>.</p></noscript>
        <form data-enquiry="contact" hidden>
          <div class="form-progress" data-progress>
            <ol class="steps" aria-hidden="true"><li data-step-item></li><li data-step-item></li></ol>
            <p class="step-label" data-step-label>Step 1 of 2</p>
          </div>
          <div class="error-summary" data-errors tabindex="-1" role="alert" hidden><h3>Check this step</h3><ul></ul></div>

          <fieldset class="form-step" data-step data-title="Topic">
            <legend tabindex="-1">What brings you here?</legend>
            <p>Choose the closest fit. A good conversation can go somewhere unexpected.</p>
            <div class="choices" data-label="Conversation about">
              {topics.map((topic, index) => <label class="choice"><input type="radio" id={`topic-${index}`} name="topic" value={topic.value} required /><span class="choice__card"><span class="choice__title">{topic.title}</span><span class="choice__hint">{topic.hint}</span></span></label>)}
            </div>
          </fieldset>

          <fieldset class="form-step" data-step data-title="Your message">
            <legend tabindex="-1">Give me a little context.</legend>
            <div class="field-grid">
              <label class="field">Your name<input id="contact-name" name="name" autocomplete="name" maxlength="80" required data-label="Name" /></label>
              <label class="field">Your email<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="150" required data-label="Email" /></label>
            </div>
            <label class="field">Organisation <span class="optional">(optional)</span><input id="contact-org" name="organisation" autocomplete="organization" maxlength="100" data-label="Organisation" /></label>
            <label class="field">Your message<textarea id="contact-message" name="message" rows="6" maxlength="1200" required data-label="Message" placeholder="What are you working on, and how might I help?"></textarea></label>
            <p class="sent-note">This prepares an email draft for you to send. It is not a website submission.</p>
          </fieldset>

          <div class="form-nav" data-navigation>
            <button class="btn btn--ghost" type="button" data-back><span aria-hidden="true">←</span> Back</button>
            <button class="btn btn--accent" type="submit" data-next>Continue <span aria-hidden="true">→</span></button>
          </div>

          <section class="review" data-review hidden aria-labelledby="contact-review-title">
            <p class="label">Ready to send from your email</p>
            <h3 id="contact-review-title" tabindex="-1" class="review__title">Check your message</h3>
            <dl class="review__summary" data-summary></dl>
            <p class="sent-note"><strong>Nothing has been sent.</strong> Open the draft in your email app, check it and press send there.</p>
            <p class="note" data-length-warning hidden>Your message is long, so some email apps may cut it short. Copy it and paste it into a new email instead.</p>
            <div class="actions">
              <a class="btn btn--accent" data-email href={`mailto:${site.email}`}>Open email draft <span class="arrow" aria-hidden="true">↗</span></a>
              <button class="btn btn--ghost" type="button" data-copy>Copy message</button>
              <a class="btn btn--ghost gmail-link" data-gmail href="https://mail.google.com/" target="_blank" rel="noopener">Open in Gmail <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
            <details><summary>Show the full email text</summary><label class="sr-only" for="contact-draft">Prepared email text</label><textarea id="contact-draft" data-draft rows="10" readonly></textarea></details>
            <p class="muted small">If your email app doesn’t open, copy the message and send it to <a href={`mailto:${site.email}`}>{site.email}</a>. <button class="text-btn" type="button" data-edit>Start again</button></p>
          </section>
          <p class="form-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
    </div>
  </section>
  <script>import '../scripts/forms';</script>
</Base>

<style>
  .contact-direct { display: grid; gap: var(--s-3); }
  .contact-email { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); font-weight: 540; letter-spacing: -.03em; text-decoration: none; border-bottom: 1px solid var(--accent); width: fit-content; min-height: 44px; display: inline-flex; align-items: center; overflow-wrap: anywhere; }
  .contact-email:hover { color: var(--accent); }
  .include { display: grid; border-top: 1px solid var(--line-strong); }
  .include > div { padding: 14px 0; border-bottom: 1px solid var(--line); display: grid; gap: 4px; }
  .include dt { font-weight: 560; }
  .include dd { margin: 0; color: var(--muted); font-size: var(--step-small); }
  .small { font-size: var(--step-small); }
  .text-btn { border: 0; padding: 0; background: none; color: var(--accent); text-decoration: underline; text-underline-offset: .2em; min-height: 24px; }
  .review__title { font-size: var(--step-h3); }
  @media (max-width: 1023px) { .form-shell__aside { order: 2; } }
</style>
