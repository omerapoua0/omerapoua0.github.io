---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Marquee from '../components/Marquee.astro';
import '../styles/forms.css';
import { site } from '../data/site';

const topics = [
  { value: 'Project', title: 'A project', hint: 'Build something useful together.' },
  { value: 'Automation', title: 'An automation', hint: 'Make a repeated process work better.' },
  { value: 'Research', title: 'Research', hint: 'Compare questions and ideas.' },
  { value: 'Opportunity', title: 'An opportunity', hint: 'A role, internship or collaboration.' },
  { value: 'Hello', title: 'Just saying hello', hint: 'That’s a good reason too.' },
];
---
<Base title="Contact" description="Talk to Omar Aboelella about an AI project, an automation, a research question or an opportunity. Prepares an email you send yourself.">
  <PageHero
    index={7}
    section="Contact"
    meta={['London, UK', 'Prepares an email you send']}
    watermark="HELLO"
    lines={[{ text: 'What are you' }, { text: 'working on?', accent: true }]}
  >
    <p class="lede">A project, a question, a workflow that takes too long. Tell me where you are and what you’re trying to figure out.</p>
    <div slot="aside" class="direct">
      <p class="direct__kicker"><span aria-hidden="true"></span>Direct</p>
      <div class="direct__email">
        <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="copy-btn direct__copy" data-copy-email={site.email} hidden><svg class="copy-btn__tick" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path pathLength="1" d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span data-copy-label>Copy</span></button>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
      <ul class="direct__links">
        <li><a href={site.linkedin} target="_blank" rel="noopener"><span>LinkedIn</span><span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href={site.github} target="_blank" rel="noopener"><span>GitHub</span><span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
        <li><a href="/Omar-Aboelella-CV.pdf" target="_blank" rel="noopener"><span>CV (PDF)</span><span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
      </ul>
      <a class="direct__lessons" href="/tutoring.html#lesson-enquiry" data-open="Lessons"><span><b>Looking for maths or science lessons?</b> Start a lesson enquiry instead</span><span aria-hidden="true">↗</span></a>
    </div>
    <Fragment slot="actions">
      <a class="btn btn--accent" href="#write" data-magnetic>Write a message <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
      <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email directly</a>
    </Fragment>
  </PageHero>

  <nav class="quick wrap" aria-label="Jump straight to a topic">
    <p class="label">Skip a step: start with a topic</p>
    <ul class="quick__list" data-reveal-stagger="scale">
      {topics.map(topic => <li><a href={`/contact.html?topic=${encodeURIComponent(topic.value)}#write`} data-no-gate>{topic.title}<span aria-hidden="true">→</span></a></li>)}
      <li><a class="quick__lessons" href="/tutoring.html#lesson-enquiry" data-open="Lessons">Lessons<span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>

  <Marquee rows={[['Projects', 'Automations', 'Research', 'Opportunities', 'Lessons', 'Hello']]} size="md" tone="clear" />

  <section class="stage stage--grey" id="write" aria-labelledby="contact-form-title">
    <div class="wrap">
    <h2 id="contact-form-title" class="sr-only">Prepare a message</h2>
    <div class="form-shell" data-form-shell>
      <aside class="form-shell__aside" aria-label="What to include">
        <p class="eyebrow"><b>01</b>A useful first message</p>
        <p>You don’t need a polished brief. A little context and a clear question are enough.</p>
        <dl class="include">
          <div><dt>For projects</dt><dd>The problem, the current tools and what a useful outcome would look like.</dd></div>
          <div><dt>For research</dt><dd>The question, paper or opportunity you’d like to discuss.</dd></div>
          <div><dt>For opportunities</dt><dd>The role or collaboration, and the timing.</dd></div>
        </dl>
        <p class="note">Please leave out passwords, private records and other sensitive information.</p>
      </aside>
      <div class="form-shell__main form-panel">
        <noscript><h3>Email works without a form.</h3><p>Send your message to <a href={`mailto:${site.email}`}>{site.email}</a>.</p></noscript>
        <form data-enquiry="contact" hidden>
          <div class="form-progress" data-progress>
            <ol class="steps" aria-hidden="true"><li data-step-item></li><li data-step-item></li></ol>
            <p class="step-label" data-step-label>Step 1 of 2</p>
          </div>
          <div class="error-summary" data-errors tabindex="-1" role="alert" hidden><h3>Check this step</h3><ul></ul></div>

          <fieldset class="form-step" data-step data-title="Topic">
            <legend tabindex="-1">What brings you here?</legend>
            <p>Choose the closest fit. A good conversation can go somewhere unexpected.</p>
            <div class="choices" data-label="Conversation about">
              {topics.map((topic, index) => <label class="choice"><input type="radio" id={`topic-${index}`} name="topic" value={topic.value} required /><span class="choice__card"><span class="choice__title">{topic.title}</span><span class="choice__hint">{topic.hint}</span></span></label>)}
            </div>
          </fieldset>

          <fieldset class="form-step" data-step data-title="Your message">
            <legend tabindex="-1">Give me a little context.</legend>
            <div class="field-grid">
              <label class="field">Your name<input id="contact-name" name="name" autocomplete="name" maxlength="80" required data-label="Name" /></label>
              <label class="field">Your email<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="150" required data-label="Email" /></label>
            </div>
            <label class="field">Organisation <span class="optional">(optional)</span><input id="contact-org" name="organisation" autocomplete="organization" maxlength="100" data-label="Organisation" /></label>
            <label class="field">Your message<textarea id="contact-message" name="message" rows="6" maxlength="1200" required data-label="Message" placeholder="What are you working on, and how might I help?"></textarea></label>
            <p class="sent-note">This prepares an email draft for you to send. It is not a website submission.</p>
          </fieldset>

          <div class="form-nav" data-navigation>
            <button class="btn btn--ghost" type="button" data-back><span aria-hidden="true">←</span> Back</button>
            <button class="btn btn--accent" type="submit" data-next>Continue <span aria-hidden="true">→</span></button>
          </div>

          <section class="review" data-review hidden aria-labelledby="contact-review-title">
            <p class="label">Ready to send from your email</p>
            <h3 id="contact-review-title" tabindex="-1" class="review__title">Check your message</h3>
            <dl class="review__summary" data-summary></dl>
            <p class="sent-note"><strong>Nothing has been sent.</strong> Open the draft in your email app, check it and press send there.</p>
            <p class="note" data-length-warning hidden>Your message is long, so some email apps may cut it short. Copy it and paste it into a new email instead.</p>
            <div class="actions">
              <a class="btn btn--accent" data-email href={`mailto:${site.email}`}>Open email draft <span class="arrow" aria-hidden="true">↗</span></a>
              <button class="btn btn--ghost" type="button" data-copy>Copy message</button>
              <a class="btn btn--ghost gmail-link" data-gmail href="https://mail.google.com/" target="_blank" rel="noopener">Open in Gmail <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
            <details><summary>Show the full email text</summary><label class="sr-only" for="contact-draft">Prepared email text</label><textarea id="contact-draft" data-draft rows="10" readonly></textarea></details>
            <p class="muted small">If your email app doesn’t open, copy the message and send it to <a href={`mailto:${site.email}`}>{site.email}</a>. <button class="text-btn" type="button" data-edit>Start again</button></p>
          </section>
          <p class="form-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
    </div>
    </div>
  </section>
  <script>import '../scripts/forms';</script>
</Base>

<style>
  .direct { display: grid; gap: var(--s-4); padding: clamp(22px, 2.6vw, 32px); border-radius: var(--radius-3); background: var(--navy); color: #fff; box-shadow: var(--shadow-3); position: relative; overflow: hidden; isolation: isolate; }
  .direct::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(70% 60% at 90% 0%, #2f6bff99, transparent 70%); }
  .direct__kicker { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #9fb2ff; }
  .direct__kicker span { width: 8px; height: 8px; border-radius: 50%; background: #8ea6ff; box-shadow: 0 0 0 4px #8ea6ff33; }
  .direct__email { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .contact-email { font-family: var(--font-mono); font-size: clamp(1rem, .85rem + .7vw, 1.4rem); color: #fff; text-decoration: none; border-bottom: 1px solid #8ea6ff; min-height: 44px; display: inline-flex; align-items: center; overflow-wrap: anywhere; }
  .direct__links { display: grid; border-top: 1px solid var(--navy-line); }
  .direct__links a { display: flex; justify-content: space-between; align-items: center; min-height: 52px; border-bottom: 1px solid var(--navy-line); color: #fff; text-decoration: none; font-weight: 560; transition: padding var(--d-3) var(--ease-out), color var(--d-2); }
  .direct__links a:hover { padding-left: 8px; color: #b9c7ff; }
  .direct__lessons { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 14px 16px; border-radius: 16px; background: #ffffff12; border: 1px solid #ffffff26; color: var(--navy-muted); text-decoration: none; font-size: var(--step-small); }
  .direct__lessons b { color: #fff; display: block; }
  .direct__lessons:hover { background: var(--accent-fill); color: #fff; }
  .direct :focus-visible { outline-color: #fff; }

  .quick { display: grid; gap: var(--s-4); padding-block: clamp(28px, 4vw, 48px); }
  .quick__list { display: flex; flex-wrap: wrap; gap: 10px; }
  .quick__list a { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); text-decoration: none; font-weight: 580; transition: background-color var(--d-2), color var(--d-2), border-color var(--d-2), transform var(--d-3) var(--ease-spring), box-shadow var(--d-3); }
  .quick__list a span { color: var(--accent); transition: transform var(--d-3) var(--ease-out); }
  .quick__list a:hover { background: var(--accent-fill); border-color: var(--accent); color: #fff; transform: translateY(-3px); box-shadow: 0 14px 30px -14px var(--accent-glow); }
  .quick__list a:hover span { color: #fff; transform: translateX(3px); }
  .quick__lessons { background: var(--navy) !important; color: #fff; border-color: var(--navy) !important; }
  .quick__lessons span { color: #9fb2ff !important; }

  .include { display: grid; gap: 10px; }
  .include > div { padding: 16px 18px; border-radius: var(--radius-2); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-1); display: grid; gap: 4px; }
  .include dt { font-weight: 600; }
  .include dd { margin: 0; color: var(--muted); font-size: var(--step-small); }
  .small { font-size: var(--step-small); }
  .text-btn { border: 0; padding: 0; background: none; color: var(--accent); text-decoration: underline; text-underline-offset: .2em; min-height: 24px; }
  .review__title { font-size: var(--step-h3); }
  @media (max-width: 1023px) { .form-shell__aside { order: 2; } }
</style>
