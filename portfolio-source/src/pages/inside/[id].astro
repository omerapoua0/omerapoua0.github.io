---
/* Project tour: one project, five short chapters, light studio styling.
   Reached from the homepage cards, the doors and the command menu through
   the light gate. Every fact comes from src/data/projects.ts. The chapter
   rail is plain anchor links; nothing here needs JavaScript. */
import Base from '../../layouts/Base.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Figure from '../../components/Figure.astro';
import { projects, type Project } from '../../data/projects';
import { statusLabel } from '../../data/site';

export function getStaticPaths() {
  const ids = ['katana', 'nookbase', 'inos', 'bitget', 'bp'];
  const list = ids.map(id => projects.find(project => project.id === id)!).filter(Boolean);
  return list.map((project, index) => ({ params: { id: project.id }, props: { project, index, total: list.length, prev: list[(index + list.length - 1) % list.length], next: list[(index + 1) % list.length] } }));
}
interface Props { project: Project; index: number; total: number; prev: Project; next: Project }
const { project, index, total, prev, next } = Astro.props;

const pad = (value: number) => String(value).padStart(2, '0');
const schematic = project.id === 'bitget' || project.id === 'bp' ? project.id : undefined;
const meta = [project.role, ...(project.role.includes(project.org) ? [] : [project.org]), project.period];
const chapters = [
  { id: 'problem', title: 'The problem' },
  { id: 'contribution', title: 'What Omar did' },
  { id: 'toolkit', title: 'How it works' },
  { id: 'stage', title: 'Where it stands' },
  { id: 'next', title: 'Next' },
];
---
<Base title={`${project.name} tour`} description={`A short tour of ${project.name}: the problem, what Omar Aboelella did, how it works and where it stands.`}>
  <section class="tour-hero" aria-labelledby="tour-title">
    <div class="tour-hero__bg" aria-hidden="true"><span></span></div>
    <div class="wrap tour-hero__inner">
      <div class="tour-hero__copy">
        <p class="tour-hero__eyebrow"><a href="/index.html#work">Selected work</a><span aria-hidden="true">/</span><span>Tour {pad(index + 1)} of {pad(total)}</span></p>
        <h1 id="tour-title">{project.name}</h1>
        <p class="tour-hero__meta">{meta.join(' · ')}</p>
        <p class="lede">{project.summary}</p>
        <div class="tour-hero__chips">
          <span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span>
          <span class="tour-hero__note">{project.statusNote}</span>
        </div>
      </div>
      <div class="tour-hero__media">
        <ProjectMedia project={project} eager />
      </div>
    </div>
  </section>

  <div class="wrap tour">
    <nav class="rail" aria-label="Tour chapters">
      <ol>
        {chapters.map((item, at) => <li><a href={`#${item.id}`}><span aria-hidden="true">{pad(at + 1)}</span>{item.title}</a></li>)}
      </ol>
    </nav>

    <div class="chapters">
      <section id="problem" class="chapter" aria-labelledby="problem-title" data-reveal>
        <p class="chapter__num">01 <span>/ 05</span></p>
        <h2 id="problem-title">The problem</h2>
        <p class="statement">{project.context}</p>
      </section>

      <section id="contribution" class="chapter" aria-labelledby="contribution-title" data-reveal>
        <p class="chapter__num">02 <span>/ 05</span></p>
        <h2 id="contribution-title">What Omar did</h2>
        <ol class="steps" data-reveal-stagger>
          {project.contribution.map((line, at) => <li><span class="steps__num" aria-hidden="true">{pad(at + 1)}</span><p>{line}</p></li>)}
        </ol>
      </section>

      <section id="toolkit" class="chapter" aria-labelledby="toolkit-title" data-reveal>
        <p class="chapter__num">03 <span>/ 05</span></p>
        <h2 id="toolkit-title">How it works</h2>
        <ul class="toolkit" aria-label={`${project.name} stack`}>
          {project.stack.map(item => <li>{item}</li>)}
        </ul>
        {schematic && <div class="schematic"><Figure kind={schematic} /></div>}
      </section>

      <section id="stage" class="chapter" aria-labelledby="stage-title" data-reveal>
        <p class="chapter__num">04 <span>/ 05</span></p>
        <h2 id="stage-title">Where it stands</h2>
        <div class="verdict">
          <span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span>
          <p class="verdict__stage">{project.stage}</p>
          <p class="verdict__note">{project.statusNote}</p>
        </div>
      </section>

      <section id="next" class="chapter" aria-labelledby="next-title" data-reveal>
        <p class="chapter__num">05 <span>/ 05</span></p>
        <h2 id="next-title">Next</h2>
        <div class="actions">
          <a class="btn" href={project.href} data-open="Work">Full case study <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="btn btn--accent" href="/contact.html?topic=Project" data-open="Contact">Talk to Omar about it</a>
          {project.external && <a class="btn btn--ghost" href={project.external.href} target="_blank" rel="noopener">{project.external.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
        </div>
        <nav class="tours" aria-label="More tours">
          {[{ item: prev, rel: 'prev', label: 'Previous tour' }, { item: next, rel: 'next', label: 'Next tour' }].map(({ item, rel, label }) => (
            <a class="tours__card" href={`/inside/${item.id}.html`} rel={rel} data-open={item.name} data-glow>
              <span class="tours__label">{rel === 'prev' && <span aria-hidden="true">← </span>}{label}{rel === 'next' && <span aria-hidden="true"> →</span>}</span>
              <span class="tours__name">{item.name}</span>
              <span class="tours__org">{item.org}</span>
            </a>
          ))}
        </nav>
      </section>
    </div>
  </div>
</Base>

<style>
  .tour-hero { position: relative; isolation: isolate; overflow: clip; background: linear-gradient(180deg, var(--bg-2), var(--bg)); border-bottom: 1px solid var(--line); }
  .tour-hero__bg span { position: absolute; z-index: -1; right: -10vw; top: -16vw; width: 50vw; height: 50vw; border-radius: 50%; background: radial-gradient(closest-side, #1f4bff2e, transparent); filter: blur(50px); }
  .tour-hero__inner { display: grid; gap: clamp(28px, 4vw, 64px); align-items: center; padding-block: clamp(40px, 7vw, 112px); }
  .tour-hero__eyebrow { display: flex; gap: 10px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .tour-hero__eyebrow a { color: var(--accent); text-decoration: none; min-height: 24px; }
  .tour-hero h1 { margin-top: 18px; font-size: clamp(3rem, 1.4rem + 6vw, 7.5rem); font-weight: 680; letter-spacing: -.06em; line-height: .9; overflow-wrap: anywhere; }
  .tour-hero__meta { margin-top: 18px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); }
  .tour-hero .lede { margin-top: 18px; max-width: 44ch; }
  .tour-hero__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 24px; }
  .tour-hero__note { font-size: var(--step-small); color: var(--muted); max-width: 46ch; }
  .tour-hero__media :global(.plate) { border-radius: var(--radius-3); box-shadow: var(--shadow-3); }
  @media (min-width: 1000px) { .tour-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }

  .tour { display: grid; gap: var(--s-6); padding-block: clamp(48px, 7vw, 112px); }
  .rail ol { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  .rail a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 14px; font-weight: 540; text-decoration: none; white-space: nowrap; }
  .rail a span { font-family: var(--font-mono); font-size: 11px; color: var(--accent); }
  .rail a:hover { border-color: var(--accent); color: var(--accent); }
  @media (min-width: 1000px) {
    .tour { grid-template-columns: 240px minmax(0, 1fr); column-gap: clamp(32px, 5vw, 96px); align-items: start; }
    .rail { position: sticky; top: calc(var(--header) + 32px); }
    .rail ol { flex-direction: column; overflow: visible; }
    .rail a { width: 100%; }
  }
  .chapters { display: grid; gap: 16px; }
  .chapter { display: grid; gap: var(--s-5); padding: clamp(24px, 4vw, 56px); border-radius: var(--radius-3); background: var(--surface); border: 1px solid #ffffff; box-shadow: var(--shadow-2); scroll-margin-top: calc(var(--header) + 24px); }
  .chapter__num { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: .06em; color: var(--accent); }
  .chapter__num span { color: var(--muted); font-weight: 400; }
  .chapter h2 { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  .statement { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); line-height: 1.35; letter-spacing: -.02em; max-width: 36ch; }
  .steps { display: grid; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .steps__num { font-family: var(--font-mono); font-size: 13px; color: var(--accent); padding-top: 3px; }
  .toolkit { display: flex; flex-wrap: wrap; gap: 10px; }
  .toolkit li { padding: 10px 16px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); font-weight: 540; overflow-wrap: anywhere; }
  .schematic { padding: 20px; border-radius: var(--radius-2); background: var(--navy); color: var(--navy-ink); }
  .verdict { display: grid; gap: var(--s-4); justify-items: start; }
  .verdict__stage { font-size: var(--step-lede); line-height: 1.45; max-width: 52ch; }
  .verdict__note { padding-left: 14px; border-left: 2px solid var(--accent); color: var(--muted); max-width: 56ch; }
  .tours { display: grid; gap: 12px; margin-top: var(--s-4); }
  .tours__card { --gx: 50%; --gy: 50%; position: relative; display: grid; gap: 4px; padding: 20px 22px; border-radius: var(--radius-2); background: var(--bg-2); border: 1px solid var(--line); text-decoration: none; overflow: hidden; transition: border-color 300ms, box-shadow 400ms; }
  .tours__card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(280px circle at var(--gx) var(--gy), #1f4bff14, transparent 60%); opacity: 0; transition: opacity 300ms; pointer-events: none; }
  .tours__card:hover { border-color: var(--accent); box-shadow: var(--shadow-2); }
  .tours__card:hover::before { opacity: 1; }
  .tours__label { font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .tours__name { font-size: var(--step-h3); font-weight: 650; letter-spacing: -.03em; }
  .tours__org { font-size: var(--step-small); color: var(--muted); }
  @media (min-width: 640px) { .tours { grid-template-columns: 1fr 1fr; } .tours__card[rel='next'] { text-align: right; } }
</style>
