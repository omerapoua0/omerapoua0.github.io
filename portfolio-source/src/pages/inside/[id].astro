    :global(html[data-tour-ready]:not([data-motion='off'])) .chapter:not(.chapter--arrival) :is(.chapter__head, .chapter__body) { transition: opacity 760ms var(--ease-out), transform 760ms var(--ease-out); transition-delay: var(--rise-delay, 0ms); }
    .chapter__body { --rise-delay: 120ms; }
    :global(html[data-tour-ready]:not([data-motion='off'])) .chapter:not(.chapter--arrival):not(.is-in) :is(.chapter__head, .chapter__body) { opacity: 0; transform: translateY(28px); }
    :global(html[data-tour-ready]:not([data-motion='off'])) .steps li, :global(html[data-tour-ready]:not([data-motion='off'])) .toolkit li { transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out); transition-delay: calc(200ms + var(--i, 0) * 80ms); }
    :global(html[data-tour-ready]:not([data-motion='off'])) .chapter:not(.is-in) :is(.steps li, .toolkit li) { opacity: 0; transform: translateY(14px); }

