---
/* "Inside the computer": Otto's tour of one project, reached when Otto
   teleports from the homepage chat. Same facts as the case study
   (src/data/projects.ts), presented as a system view. Works without JS. */
import Base from '../../layouts/Base.astro';
import Robot from '../../components/Robot.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { projects, type Project } from '../../data/projects';
import { statusLabel } from '../../data/site';

export function getStaticPaths() {
  const ids = ['katana', 'nookbase', 'inos', 'bitget', 'bp'];
  const list = ids.map(id => projects.find(project => project.id === id)!).filter(Boolean);
  return list.map((project, index) => ({ params: { id: project.id }, props: { project, prev: list[(index + list.length - 1) % list.length], next: list[(index + 1) % list.length] } }));
}
interface Props { project: Project; prev: Project; next: Project }
const { project, prev, next } = Astro.props;
const boot = [
  `$ mount /work/${project.id}`,
  `reading contribution … ${project.contribution.length} ${project.contribution.length === 1 ? 'entry' : 'entries'}`,
  `checking sources … ${project.href.replace('/', '')}`,
  'ready.',
];
---
<Base title={`Inside ${project.name}`} description={`Otto’s tour of ${project.name}: what Omar Aboelella did, with whom, and what stage it’s at.`}>
  <section class="inside" aria-labelledby="inside-title" data-inside={project.id}>
    <div class="inside__bar">
      <a class="inside__back" href="/index.html" data-inside-back>← Back to Otto</a>
      <p class="inside__crumb" aria-hidden="true">otto://inside/{project.id}</p>
    </div>

    <div class="inside__host">
      <div class="inside__robot"><Robot size="sm" id="otto-inside" /></div>
      <p class="inside__speech">This is what Omar does on {project.name}. Have a look around.</p>
    </div>

    <div class="monitor">
      <div class="monitor__top" aria-hidden="true"><i></i><i></i><i></i><span>{project.id} — {project.org}</span></div>
      <div class="monitor__screen">
        <ol class="boot" aria-label="System log">
          {boot.map((line, index) => <li style={`--i:${index}`}>{line}</li>)}
        </ol>

        <div class="inside__grid">
          <div class="panel panel--process">
            <p class="label">Process</p>
            <h1 id="inside-title">{project.name}</h1>
            <dl>
              <div><dt>Role</dt><dd>{project.role}</dd></div>
              <div><dt>Where</dt><dd>{project.org}</dd></div>
              <div><dt>When</dt><dd>{project.period}</dd></div>
              <div><dt>Status</dt><dd><span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span></dd></div>
            </dl>
            <ul class="stack" aria-label="Stack">{project.stack.map(item => <li>{item}</li>)}</ul>
          </div>

          <div class="panel panel--media"><ProjectMedia project={project} eager /></div>

          <div class="panel panel--log">
            <p class="label">The problem</p>
            <p class="context">{project.context}</p>
            <p class="label">What Omar did</p>
            <ol class="log">
              {project.contribution.map((line, index) => <li><span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{line}</li>)}
            </ol>
            <p class="notice"><strong>Stage.</strong> {project.stage}</p>
            <p class="notice notice--soft">{project.statusNote}</p>
            <p class="links">
              <a href={project.href}>Full case study ↗</a>
              {project.external && <a href={project.external.href} target="_blank" rel="noopener">{project.external.label} ↗</a>}
            </p>
          </div>
        </div>
      </div>
    </div>

    <nav class="inside__nav" aria-label="More tours">
      <a href={`/inside/${prev.id}.html`}>← {prev.name}</a>
      <a href={`/inside/${next.id}.html`}>{next.name} →</a>
    </nav>
  </section>
</Base>

<style>
  .inside { --lime: #d9ff3f; position: relative; min-height: 100svh; padding: calc(var(--header) + 20px) var(--margin) 48px; color: #f2f3ee; background: #070807; overflow: hidden; isolation: isolate; }
  .inside::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(#ffffff08 1px, transparent 1px) 0 0 / 100% 4px, radial-gradient(60% 50% at 70% 20%, #d9ff3f14, transparent 70%), radial-gradient(50% 50% at 0% 100%, #3f5bff12, transparent 70%); pointer-events: none; }
  .inside > * { max-width: var(--max); margin-inline: auto; }
  .inside__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 18px; }
  .inside__back { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1px solid #ffffff2e; border-radius: 999px; color: #f2f3ee; text-decoration: none; font-weight: 520; }
  .inside__back:hover { border-color: var(--lime); color: var(--lime); }
  .inside__crumb { font-family: var(--font-mono); font-size: 11.5px; color: #7d8277; }
  .inside__host { display: flex; align-items: flex-end; gap: 14px; margin-bottom: -18px; position: relative; z-index: 2; }
  .inside__robot { view-transition-name: otto; }
  .inside__speech { margin-bottom: 34px; padding: 11px 14px; border-radius: 16px 16px 16px 5px; background: #1a1c18; max-width: 34ch; font-size: 15px; line-height: 1.5; }
  .monitor { border: 1px solid #ffffff24; border-radius: 22px; background: #0e0f0d; box-shadow: 0 50px 120px -40px #000, 0 0 0 6px #ffffff06; overflow: hidden; }
  .monitor__top { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid #ffffff17; font-family: var(--font-mono); font-size: 11px; color: #7d8277; }
  .monitor__top i { width: 10px; height: 10px; border-radius: 50%; background: #ffffff26; }
  .monitor__top i:first-child { background: var(--lime); }
  .monitor__top span { margin-left: 8px; }
  .monitor__screen { padding: clamp(16px, 3vw, 32px); }
  .boot { font-family: var(--font-mono); font-size: 12.5px; color: #a7aca0; margin-bottom: 22px; display: grid; gap: 4px; }
  .boot li:last-child { color: var(--lime); }
  .inside__grid { display: grid; gap: 18px; }
  .panel { border: 1px solid #ffffff17; border-radius: 16px; padding: 18px; background: #121411; min-width: 0; }
  .panel .label { color: #7d8277; margin-bottom: 8px; }
  .panel h1 { font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem); letter-spacing: -.05em; line-height: .95; margin-bottom: 16px; }
  .panel dl { display: grid; gap: 10px; margin-bottom: 16px; }
  .panel dl div { display: grid; grid-template-columns: 70px 1fr; gap: 10px; font-size: 14.5px; }
  .panel dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: #7d8277; padding-top: 2px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .stack li { padding: 4px 9px; border: 1px solid #d9ff3f4d; border-radius: 999px; font-family: var(--font-mono); font-size: 11px; color: var(--lime); }
  .panel--media { padding: 0; overflow: hidden; }
  .panel--media :global(.plate) { height: 100%; min-height: 240px; aspect-ratio: auto; }
  .context { font-size: 1.05rem; line-height: 1.55; margin-bottom: 18px; }
  .log { display: grid; gap: 10px; margin-bottom: 18px; }
  .log li { display: grid; grid-template-columns: 30px 1fr; gap: 8px; line-height: 1.5; }
  .log .num { font-size: 12px; color: var(--lime); padding-top: 3px; }
  .notice { padding: 10px 12px; border-left: 2px solid var(--lime); background: #d9ff3f0d; font-size: 14px; line-height: 1.5; margin-bottom: 10px; }
  .notice--soft { border-color: #a7aca0; background: #ffffff08; color: #a7aca0; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px; }
  .links a { color: var(--lime); min-height: 44px; display: inline-flex; align-items: center; }
  .inside__nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 22px; }
  .inside__nav a { min-height: 44px; display: inline-flex; align-items: center; color: #a7aca0; }
  .inside__nav a:hover { color: var(--lime); }
  .inside :focus-visible { outline-color: var(--lime); }
  @media (min-width: 1000px) {
    .inside__grid { grid-template-columns: 4fr 5fr; }
    .panel--process { grid-row: span 1; }
    .panel--log { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
    .panel--log > :nth-child(-n+2) { grid-column: 1; }
    .panel--log .label:nth-of-type(2), .panel--log .log { grid-column: 2; }
    .panel--log .label:nth-of-type(2) { grid-row: 1; }
    .panel--log .log { grid-row: 2 / span 3; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='off'])) .boot li { overflow: hidden; white-space: nowrap; animation: boot-type 420ms steps(28) both; animation-delay: calc(var(--i) * 260ms + 250ms); }
    :global(html:not([data-motion='off'])) .monitor { animation: monitor-in 700ms cubic-bezier(.23, 1, .32, 1) both; }
    :global(html:not([data-motion='off'])) .inside__grid > * { animation: monitor-in 700ms cubic-bezier(.23, 1, .32, 1) both; animation-delay: calc(450ms + var(--d, 0ms)); }
    .inside__grid > :nth-child(2) { --d: 90ms; }
    .inside__grid > :nth-child(3) { --d: 180ms; }
    :global(html:not([data-motion='off'])) .inside__speech { animation: monitor-in 500ms ease-out 400ms both; }
  }
  @keyframes boot-type { from { max-width: 0; } to { max-width: 60ch; } }
  @keyframes monitor-in { from { opacity: 0; transform: translateY(18px) scale(.985); } to { opacity: 1; transform: none; } }
</style>

<script>import '../../scripts/inside';</script>
