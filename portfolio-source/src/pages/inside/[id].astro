    :global(html.arrive-css:not([data-motion='off']):not([data-tour-entered])) .monitor__power::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #d9ff3f00, #d9ff3f66 30%, #f4ffc2 50%, #d9ff3f66 70%, #d9ff3f00); box-shadow: 0 0 40px #d9ff3f99; transform: scaleY(.004); animation: tour-power-line 520ms cubic-bezier(.7, 0, .3, 1) both; }
    :global(html.arrive-css:not([data-motion='off']):not([data-tour-entered])) .monitor__media, :global(html.arrive-css:not([data-motion='off']):not([data-tour-entered])) .titlecard { animation: tour-fade 420ms ease-out 480ms both; }

