---
/* "Inside" v2: Otto's guided tour of one project, reached when Otto hands
   the visitor off from the homepage chat. Six chapters (#ch-0..5), each with
   Otto's line printed as a visible kicker, so the tour reads without
   JavaScript. Every fact comes from src/data/projects.ts; Otto's lines are
   fact-free framing or templated from those fields. inside.ts narrates the
   chapters, drives the dock and handles Back/Esc and Pause. */
import Base from '../../layouts/Base.astro';
import Robot from '../../components/Robot.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Figure from '../../components/Figure.astro';
import { projects, type Project } from '../../data/projects';
import { statusLabel } from '../../data/site';

export function getStaticPaths() {
  const ids = ['katana', 'nookbase', 'inos', 'bitget', 'bp'];
  const list = ids.map(id => projects.find(project => project.id === id)!).filter(Boolean);
  return list.map((project, index) => ({ params: { id: project.id }, props: { project, prev: list[(index + list.length - 1) % list.length], next: list[(index + 1) % list.length] } }));
}
interface Props { project: Project; prev: Project; next: Project }
const { project, prev, next } = Astro.props;

const pad = (value: number) => String(value).padStart(2, '0');
const words = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const steps = project.contribution.length;
const stepWord = `${words[steps] ?? steps} ${steps === 1 ? 'step' : 'steps'}`;
const schematic = project.id === 'bitget' || project.id === 'bp' ? project.id : undefined;
/* role · org · period, without repeating the org when the role already names it. */
const meta = [project.role, ...(project.role.includes(project.org) ? [] : [project.org]), project.period];

/* Chapter titles, Otto's poses and lines. Lines are framing or field templates only. */
const tour = [
  { id: 'ch-0', title: 'Arrival', pose: 'wave', line: `Welcome to the ${project.name} tour. Scroll and I’ll walk you through it.` },
  { id: 'ch-1', title: 'The problem', pose: 'think', line: 'First, the problem.' },
  { id: 'ch-2', title: 'What Omar did', pose: 'talk', line: `Here’s what Omar did: ${stepWord}.` },
  { id: 'ch-3', title: 'How it works', pose: 'point', line: 'Here’s the toolkit.' },
  { id: 'ch-4', title: 'Where it stands', pose: 'talk', line: 'Straight answer on where it stands.' },
  { id: 'ch-5', title: 'Next stop', pose: 'wave', line: 'That’s the tour. Where next?' },
];
const [arrival, ...chapters] = tour;
const total = pad(chapters.length);
const chapter = (index: number) => tour[index];
---
<Base title={`Inside ${project.name}`} description={`Otto’s guided tour of ${project.name}: the problem, what Omar Aboelella did, how it works and where it stands.`}>
  <div class="tour" data-tour data-inside={project.id}>
    <div class="tour__inner">
      <div class="tour__bar">
        <a class="tour__back" href="/index.html" data-inside-back><span aria-hidden="true">←</span> Back to Otto</a>
        <button class="tour__pause" type="button" data-inside-motion hidden>
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path data-inside-motion-icon d="M4 3h3v10H4zm5 0h3v10H9z" fill="currentColor" /></svg>
          <span data-inside-motion-label>Pause motion</span>
        </button>
      </div>

      <div class="tour__layout">
        <div class="tour__chapters">
          <section id={arrival.id} class="chapter chapter--arrival" data-chapter="0" data-otto-line={arrival.line} data-otto-line-arrive={`We’re in. ${arrival.line}`} data-otto-pose={arrival.pose}>
            <div class="monitor">
              <div class="monitor__top" aria-hidden="true">
                <span class="monitor__lights"><i></i><i></i><i></i></span>
                <span class="monitor__path">otto://inside/{project.id}</span>
                <span class="monitor__ch">CH <b data-tour-counter>00</b> / {total}</span>
              </div>
              <div class="monitor__screen">
                {project.media ? (
                  <div class="monitor__media" data-pane-item data-tour-media><ProjectMedia project={project} eager /></div>
                ) : (
                  <div class="titlecard" aria-hidden="true">
                    <span class="titlecard__path">$ mount /work/{project.id}</span>
                    <span class="titlecard__name">{project.name}<i class="titlecard__cursor"></i></span>
                    <span class="titlecard__org">{project.org}</span>
                  </div>
                )}
                <span class="monitor__scan" aria-hidden="true"></span>
                <span class="monitor__power" aria-hidden="true"></span>
              </div>
            </div>

            <div class="arrival">
              <p class="arrival__eyebrow">Otto’s tour · {chapters.length} stops</p>
              <h1 id="tour-title" tabindex="-1">{project.name}</h1>
              <div class="arrival__row">
                <p class="arrival__meta">{meta.map((part, at) => <>{at > 0 && <span class="dot" aria-hidden="true">·</span>}<span>{part}</span></>)}</p>
                <span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span>
              </div>
              <a class="arrival__start" href={`#${chapter(1).id}`}>Start the tour <span aria-hidden="true">↓</span></a>
            </div>
          </section>

          <section id={chapter(1).id} class="chapter" data-chapter="1" data-otto-line={chapter(1).line} data-otto-pose={chapter(1).pose}>
            <div class="chapter__head">
              <p class="chapter__num" aria-hidden="true">{pad(1)} <span>/ {total}</span></p>
              <p class="kicker"><span class="kicker__who">Otto<span class="sr-only">:</span><span class="kicker__chev" aria-hidden="true">›</span></span> <span class="kicker__line">{chapter(1).line}</span></p>
              <h2>{chapter(1).title}</h2>
            </div>
            <div class="chapter__body">
              <p class="statement">{project.context}</p>
            </div>
          </section>

          <section id={chapter(2).id} class="chapter" data-chapter="2" data-otto-line={chapter(2).line} data-otto-pose={chapter(2).pose}>
            <div class="chapter__head">
              <p class="chapter__num" aria-hidden="true">{pad(2)} <span>/ {total}</span></p>
              <p class="kicker"><span class="kicker__who">Otto<span class="sr-only">:</span><span class="kicker__chev" aria-hidden="true">›</span></span> <span class="kicker__line">{chapter(2).line}</span></p>
              <h2>{chapter(2).title}</h2>
            </div>
            <ol class="chapter__body steps">
              {project.contribution.map((line, index) => (
                <li style={`--i:${index}`}><span class="steps__num" aria-hidden="true">{pad(index + 1)}</span><p>{line}</p></li>
              ))}
            </ol>
          </section>

          <section id={chapter(3).id} class="chapter" data-chapter="3" data-otto-line={chapter(3).line} data-otto-pose={chapter(3).pose}>
            <div class="chapter__head">
              <p class="chapter__num" aria-hidden="true">{pad(3)} <span>/ {total}</span></p>
              <p class="kicker"><span class="kicker__who">Otto<span class="sr-only">:</span><span class="kicker__chev" aria-hidden="true">›</span></span> <span class="kicker__line">{chapter(3).line}</span></p>
              <h2>{chapter(3).title}</h2>
            </div>
            <div class="chapter__body">
              <ul class="toolkit" aria-label={`${project.name} stack`}>
                {project.stack.map((item, index) => (
                  <li style={`--i:${index}`}><span class="toolkit__i" aria-hidden="true">{pad(index + 1)}</span><span class="toolkit__name">{item.split('/').map((part, at) => <>{at > 0 && <>/<wbr /></>}{part}</>)}</span></li>
                ))}
              </ul>
              {schematic && (
                <div class="schematic"><Figure kind={schematic} /></div>
              )}
            </div>
          </section>

          <section id={chapter(4).id} class="chapter" data-chapter="4" data-otto-line={chapter(4).line} data-otto-pose={chapter(4).pose}>
            <div class="chapter__head">
              <p class="chapter__num" aria-hidden="true">{pad(4)} <span>/ {total}</span></p>
              <p class="kicker"><span class="kicker__who">Otto<span class="sr-only">:</span><span class="kicker__chev" aria-hidden="true">›</span></span> <span class="kicker__line">{chapter(4).line}</span></p>
              <h2>{chapter(4).title}</h2>
            </div>
            <div class="chapter__body verdict">
              <span class:list={['chip', `chip--${project.status}`]}>{statusLabel[project.status]}</span>
              <p class="verdict__stage">{project.stage}</p>
              <p class="verdict__note"><span class="verdict__mark" aria-hidden="true">!</span><span>{project.statusNote}</span></p>
            </div>
          </section>

          <section id={chapter(5).id} class="chapter chapter--next" data-chapter="5" data-otto-line={chapter(5).line} data-otto-pose={chapter(5).pose}>
            <div class="chapter__head">
              <p class="chapter__num" aria-hidden="true">{pad(5)} <span>/ {total}</span></p>
              <p class="kicker"><span class="kicker__who">Otto<span class="sr-only">:</span><span class="kicker__chev" aria-hidden="true">›</span></span> <span class="kicker__line">{chapter(5).line}</span></p>
              <h2>{chapter(5).title}</h2>
            </div>
            <div class="chapter__body">
              <div class="exits">
                <a class="exits__primary" href={project.href}>Full {project.name} case study <span aria-hidden="true">↗</span></a>
                {project.external && <a class="exits__ghost" href={project.external.href} target="_blank" rel="noopener">{project.external.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
                <a class="exits__ghost" href="/index.html" data-inside-back><span aria-hidden="true">←</span> Back to Otto</a>
              </div>
              <nav class="tours" aria-label="More tours">
                {[{ item: prev, rel: 'prev', label: 'Previous tour' }, { item: next, rel: 'next', label: 'Next tour' }].map(({ item, rel, label }) => (
                  <a class:list={['tours__card', `tours__card--${rel}`]} href={`/inside/${item.id}.html`} rel={rel}>
                    <span class="tours__thumb" aria-hidden="true">
                      {item.media ? <img src={item.media.image} alt="" width="160" height="100" loading="lazy" decoding="async" /> : <span class="tours__mono">{item.org}</span>}
                    </span>
                    <span class="tours__text">
                      <span class="tours__label">{rel === 'prev' && <span aria-hidden="true">← </span>}{label}{rel === 'next' && <span aria-hidden="true"> →</span>}</span>
                      <span class="tours__name">{item.name}</span>
                      <span class="tours__org">{item.org}</span>
                    </span>
                  </a>
                ))}
              </nav>
            </div>
          </section>
        </div>

        {/* After the chapters in the DOM, so focus and reading order follow the
            visual order; desktop places it in the right-hand column. */}
        <div class="tour__aside">
          <div class="tour__sticky">
            <div class="otto-dock" data-otto-stage data-mode="svg" data-stage-mode="dock" data-bubble-owner="page">
              <canvas class="otto-dock__canvas" data-otto-canvas aria-hidden="true"></canvas>
              <Robot size="sm" id="otto-dock" label="Otto, your tour guide" />
              <p class="otto-dock__bubble" data-otto-bubble aria-hidden="true"></p>
            </div>
            <nav class="rail" aria-label="Tour chapters" data-rail>
              <ol>
                {chapters.map((item, index) => (
                  <li><a href={`#${item.id}`}><span class="rail__dot" aria-hidden="true"></span><span class="rail__num" aria-hidden="true">{pad(index + 1)}</span>{item.title}</a></li>
                ))}
              </ol>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Dark tour palette. Shared components (chips, plates) get dark-safe tokens. */
  .tour {
    --lime: #d9ff3f;
    --t-ink: #f2f3ee;
    --t-soft: #d3d7cc;
    --t-muted: #a7aca0;
    --t-dim: #8c9186;
    --t-line: #ffffff1a;
    --t-panel: #0d0f0c;
    --ok: #6fd3a3;
    --accent: #8e98ff;
    --signal: #ffb45c;
    --muted: var(--t-muted);
    --line-strong: #4b5047;
    --plate-muted: #c9cfd8;
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--t-ink);
    background: #070807;
    padding: 18px var(--margin) clamp(72px, 10vw, 128px);
  }
  .tour::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(#ffffff05 1px, transparent 1px) 0 0 / 100% 4px,
      radial-gradient(55% 40% at 78% 6%, #d9ff3f17, transparent 70%),
      radial-gradient(45% 35% at 0% 60%, #3f5bff12, transparent 70%);
  }
  .tour__inner { max-width: var(--max); margin-inline: auto; }
  .tour :focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }

  /* The site header goes dark to match the tour (this page only). */
  :global(body:has([data-tour]) .header:not([data-open])) { --accent: #8e98ff; --accent-ink: #0b0d11; background: #070807e8; border-color: #ffffff17; color: #f2f3ee; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  :global(body:has([data-tour]) .header :focus-visible) { outline-color: #d9ff3f; }

  /* Bar: Back to Otto + Pause. */
  .tour__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .tour__back, .tour__pause { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 1px solid #ffffff2e; border-radius: 999px; background: #0d0f0cb3; color: var(--t-ink); text-decoration: none; transition: border-color var(--d-2) var(--ease-out), color var(--d-2) var(--ease-out); }
  .tour__back { font-weight: 540; font-size: 15px; }
  .tour__pause { font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; }
  .tour__back:hover, .tour__pause:hover { border-color: var(--lime); color: var(--lime); }

  /* Layout: chapters + Otto's dock. Desktop puts the dock in a sticky column. */
  .tour__layout { display: grid; }
  .tour__chapters { min-width: 0; }

  /* Dock: the SVG Otto, the canvas otto-stage.ts may draw a 3D Otto into
     (data-mode="3d"), and the speech bubble. The bubble never takes taps. */
  .otto-dock { position: relative; }
  .otto-dock__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; transition: opacity 400ms ease-out; }
  .otto-dock[data-mode='3d'] .otto-dock__canvas { opacity: 1; }
  .otto-dock :global(.robot.robot--sm) { width: 100%; transition: opacity 300ms ease-out, visibility 0s linear 0s; }
  .otto-dock[data-mode='3d'] :global(.robot) { opacity: 0; visibility: hidden; transition: opacity 300ms ease-out, visibility 0s linear 300ms; }
  .otto-dock__bubble {
    position: absolute; z-index: 2; width: max-content; max-width: 32ch; padding: 10px 14px; pointer-events: none;
    border: 1px solid #ffffff24; background: #161914; color: var(--t-ink);
    font-size: 14.5px; line-height: 1.45; letter-spacing: -.005em; box-shadow: 0 18px 40px -18px #000;
  }
  .otto-dock__bubble:empty { display: none; }
  .otto-dock__bubble::after { content: ''; position: absolute; width: 10px; height: 10px; background: inherit; border: inherit; border-width: 0 1px 1px 0; }

  /* Chapter rail. */
  .rail ol { position: relative; display: grid; gap: 2px; }
  .rail ol::before, .rail ol::after { content: ''; position: absolute; left: 11.5px; top: 20px; width: 1px; pointer-events: none; }
  .rail ol::before { bottom: 20px; background: #ffffff1f; }
  .rail ol::after { height: calc((100% - 40px) * var(--progress, 0)); background: var(--lime); }
  .rail a { display: flex; align-items: center; gap: 10px; min-height: 38px; padding-right: 8px; color: var(--t-muted); font-size: 14.5px; text-decoration: none; }
  .rail a:hover { color: var(--t-ink); }
  .rail__dot { position: relative; z-index: 1; display: grid; place-items: center; width: 24px; height: 24px; flex: none; }
  .rail__dot::before { content: ''; width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid #ffffff66; background: #070807; transition: background-color var(--d-2), border-color var(--d-2), box-shadow var(--d-2); }
  .rail__num { font-family: var(--font-mono); font-size: 11px; color: var(--t-dim); }
  .rail a[data-done] .rail__dot::before { background: #d9ff3f99; border-color: transparent; }
  .rail a[aria-current] { color: var(--t-ink); }
  .rail a[aria-current] .rail__num { color: var(--lime); }
  .rail a[aria-current] .rail__dot::before { background: var(--lime); border-color: var(--lime); box-shadow: 0 0 0 5px #d9ff3f26; }

  @media (min-width: 1024px) {
    .tour__layout { grid-template-columns: minmax(0, 1fr) 248px; column-gap: clamp(40px, 5vw, 96px); }
    .tour__chapters { grid-column: 1; grid-row: 1; }
    .tour__aside { grid-column: 2; grid-row: 1; }
    .tour__sticky { position: sticky; top: calc(var(--header) + 16px); padding-top: 112px; }
    .otto-dock { width: 200px; height: 240px; margin-inline: auto; }
    .otto-dock__bubble { left: -24px; right: -24px; bottom: calc(100% - 6px); margin-inline: auto; max-width: 248px; border-radius: 16px; }
    .otto-dock__bubble::after { left: calc(50% - 5px); bottom: -6px; transform: rotate(45deg); }
    .rail { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--t-line); }
    /* Room for the sticky dock beside the last chapter. */
    .chapter--next { min-height: min(620px, 72svh); }
  }
  @media (max-width: 1023px) {
    /* Room for the fixed dock (without JS Otto sits in the flow instead). */
    :global(html.js) .tour { padding-bottom: 140px; }
    .rail { display: none; }
    /* Without JS Otto can't step aside for the footer, so he stays in the flow. */
    :global(html:not(.js)) .otto-dock { position: relative; right: auto; bottom: auto; margin: 8px 0 0 auto; }
    :global(html:not(.js)) .otto-dock::before { display: none; }
    .otto-dock { position: fixed; z-index: 40; right: calc(10px + env(safe-area-inset-right)); bottom: calc(10px + env(safe-area-inset-bottom)); width: 96px; height: 118px; transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out), visibility 0s linear 0s; }
    .otto-dock::before { content: ''; position: absolute; inset: 18% -8% -6%; z-index: -1; border-radius: 50%; background: radial-gradient(closest-side, #070807e6, #07080700); pointer-events: none; }
    .otto-dock[data-away] { opacity: 0; visibility: hidden; transform: translateY(16px); transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out), visibility 0s linear var(--d-3); }
    .otto-dock__bubble { right: calc(100% - 4px); bottom: 66%; max-width: min(32ch, calc(100vw - 132px)); border-radius: 16px 16px 4px 16px; font-size: 14px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out), visibility 0s linear var(--d-3); }
    .otto-dock__bubble[data-show] { opacity: 1; visibility: visible; transform: none; transition: opacity var(--d-3) var(--ease-out), transform var(--d-3) var(--ease-out); }
    .otto-dock__bubble::after { right: -6px; bottom: 12px; transform: rotate(-45deg); }
    :global(html:not(.js)) .otto-dock__bubble { display: none; }
  }

  /* Chapters */
  .chapter { position: relative; padding-block: clamp(64px, 11vh, 128px); border-top: 1px solid var(--t-line); }
  .chapter__num { font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; color: var(--lime); font-variant-numeric: tabular-nums; }
  .chapter__num span { color: var(--t-dim); }
  .kicker { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin-top: 18px; }
  .kicker__who { display: inline-flex; align-items: center; padding: 3px 9px; border: 1px solid #d9ff3f4d; border-radius: 999px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--lime); line-height: 1.5; }
  .kicker__chev { margin-left: .45em; font-size: 13px; line-height: 1; }
  .kicker__line { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.1rem, 1rem + .4vw, 1.3rem); color: var(--t-soft); letter-spacing: -.01em; }
  .chapter h2 { margin-top: 14px; font-size: clamp(2.1rem, 1.35rem + 2.5vw, 3.75rem); color: var(--t-ink); }
  .chapter__body { margin-top: clamp(28px, 4.5vh, 48px); }

  /* 0 · Arrival */
  .chapter--arrival { border-top: 0; padding-top: 4px; padding-bottom: clamp(48px, 8vh, 88px); }
  .monitor { position: relative; padding: 0 10px 10px; border: 1px solid #ffffff21; border-radius: 20px; background: linear-gradient(180deg, #161814, #0c0d0b); box-shadow: 0 0 0 1px #000, 0 60px 120px -60px #000, 0 0 140px -50px #d9ff3f40; }
  .monitor__top { display: flex; align-items: center; gap: 12px; height: 38px; padding: 0 6px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; color: var(--t-dim); }
  .monitor__lights { display: flex; gap: 6px; }
  .monitor__lights i { width: 9px; height: 9px; border-radius: 50%; background: #ffffff26; }
  .monitor__lights i:first-child { background: var(--lime); box-shadow: 0 0 10px #d9ff3f99; }
  .monitor__path { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .monitor__ch { margin-left: auto; white-space: nowrap; }
  .monitor__ch b { font-weight: 500; color: var(--lime); }
  .monitor__screen { position: relative; overflow: hidden; width: 100%; aspect-ratio: 16 / 9; max-height: 50svh; border-radius: 12px; background: #070807; isolation: isolate; }
  :global(html[data-arrive='portal']) .monitor__screen { view-transition-name: portal; }
  .monitor__media { position: absolute; inset: 0; }
  .monitor__media :global(.plate) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
  .monitor__media :global(.plate)::after { background: linear-gradient(160deg, #d9ff3f, #2a3a00); opacity: .34; }
  .monitor__media :global(.plate__caption) { left: 14px; bottom: 12px; padding: 3px 7px; background: #070807b3; color: #d3d7cc; }
  :global(html[data-motion='off']) .monitor__media :global(video) { display: none; }
  .monitor__scan { position: absolute; inset: 0; z-index: 3; pointer-events: none; background: repeating-linear-gradient(180deg, #d9ff3f0f 0 1px, transparent 1px 3px), radial-gradient(120% 100% at 50% 50%, transparent 55%, #000000a6); }
  .monitor__power { display: none; }

  .titlecard { position: absolute; inset: 0; display: grid; align-content: center; justify-items: start; gap: 10px; padding: clamp(20px, 5vw, 56px); background: linear-gradient(#d9ff3f14 1px, transparent 1px) 0 0 / 28px 28px, linear-gradient(90deg, #d9ff3f14 1px, transparent 1px) 0 0 / 28px 28px, radial-gradient(70% 70% at 30% 40%, #d9ff3f1f, transparent 70%), #080a07; font-family: var(--font-mono); }
  .titlecard__path { font-size: clamp(11px, 1vw, 13px); color: var(--t-muted); }
