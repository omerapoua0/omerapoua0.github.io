---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHead from '../components/SectionHead.astro';
import Timeline from '../components/Timeline.astro';
import { certifications, education, languages, researchAndTeaching, skillGroups, technicalExperience } from '../data/experience';
---
<Base title="About & CV" description="About Omar Aboelella: AI Product Engineer at Digis Squared, BSc Computer Science & Mathematics student at Birkbeck, Maths & Physics Teaching Assistant. Experience, education, certifications and CV.">
  <PageIntro section="About & CV" meta={['London, UK', 'Arabic · English']}>
    <Fragment slot="title">I like making difficult things <em class="voice">make sense.</em></Fragment>
    <p class="lede">I’m Omar Aboelella: AI product engineer, Computer Science &amp; Mathematics student and tutor, based in London.</p>
    <div class="actions cv-actions"><a class="btn btn--accent" href="/Omar-Aboelella-CV.pdf" download>Download CV <span class="arrow arrow--down" aria-hidden="true">↓</span></a><a class="btn btn--ghost" href="/Omar-Aboelella-CV.pdf" target="_blank" rel="noopener">Open PDF <span class="arrow" aria-hidden="true">↗</span></a></div>
    <figure slot="aside" class="portrait">
      <img src="/omar-aboelella.jpg" alt="Portrait of Omar Aboelella" width="900" height="1200" loading="eager" decoding="async" />
      <figcaption class="label">Omar Aboelella · London</figcaption>
    </figure>
  </PageIntro>

  <section class="section wrap" aria-labelledby="profile-title">
    <div class="profile">
      <div>
        <p class="label"><span class="section-mark">§1</span> Profile</p>
        <h2 id="profile-title">Understand it. Build it. <em class="voice">Explain it.</em></h2>
      </div>
      <div class="profile__copy">
        <p class="lede">I build machine-learning and optimisation systems from the mathematics through to production code.</p>
        <p>I’m strong in Python, SQL and statistical modelling, with practical experience in Bayesian inference, predictive modelling and data pipelines. My work spans network autonomy, predictive modelling, market intelligence and learning products.</p>
        <p>Engineering and teaching ask me to do something similar: find the structure inside a difficult problem and make the next step clearer. Longer term, I want to pursue deeper research in optimisation and intelligent systems.</p>
        <dl class="facts profile__facts">
          <div><dt class="label">Studying</dt><dd>BSc (Hons) Computer Science &amp; Mathematics, Birkbeck · targeting First Class Honours</dd></div>
          <div><dt class="label">Looking for</dt><dd>A Sales &amp; Trading or quantitative internship, applying mathematics and programming to markets and systematic decision-making</dd></div>
          <div><dt class="label">Languages</dt><dd>{languages.map(item => `${item.name} (${item.level.toLowerCase()})`).join(', ')}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--rule wrap" id="experience" aria-labelledby="experience-title">
    <SectionHead mark="2" label="Experience" id="experience-title">The work <em class="voice">so far.</em></SectionHead>
    <h3 class="group-title label">Technical experience</h3>
    <Timeline roles={technicalExperience} />
    <h3 class="group-title label">Research &amp; teaching</h3>
    <Timeline roles={researchAndTeaching} />
    <p class="muted fine">My wider work experience also includes Rapport.</p>
  </section>

  <section class="section section--rule wrap" id="education" aria-labelledby="education-title">
    <SectionHead mark="3" label="Education" id="education-title">Always <em class="voice">a student.</em></SectionHead>
    <ol class="timeline-lite">
      {education.map(item => (
        <li><p class="num">{item.period}</p><div><p class="label">{item.org}</p><h3>{item.title}</h3><p class="muted">{item.text}</p></div></li>
      ))}
      <li><p class="num">Certifications</p><div><p class="label">Professional learning</p><ul class="certs">{certifications.map(name => <li>{name}</li>)}</ul></div></li>
    </ol>
  </section>

  <section class="section section--rule wrap" id="skills" aria-labelledby="skills-title">
    <SectionHead mark="4" label="Skills" id="skills-title">Ideas <em class="voice">into systems.</em>
      <p slot="aside">As listed on my CV. For where each skill was used, see the <a href="/index.html#skills-title">capability matrix</a>.</p>
    </SectionHead>
    <dl class="skills">
      {skillGroups.map(group => <div><dt class="label">{group.title}</dt><dd>{group.items}</dd></div>)}
    </dl>
  </section>
</Base>

<style>
  .cv-actions { margin-top: var(--s-6); }
  .portrait { position: relative; max-width: 420px; justify-self: end; width: 100%; }
  .portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; background: var(--raised); }
  .portrait figcaption { margin-top: var(--s-3); }
  .profile { display: grid; gap: var(--s-6); }
  .profile__copy { display: grid; gap: var(--s-5); }
  .profile__copy > p:not(.lede) { max-width: 62ch; }
  .profile__facts { margin-top: var(--s-4); }
  .profile__facts dd { margin: 0; }
  @media (min-width: 1024px) {
    .profile { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .profile > div:first-child { grid-column: 1 / span 5; }
    .profile__copy { grid-column: 7 / span 6; }
  }
  .group-title { margin: var(--s-7) 0 var(--s-3); }
  .group-title:first-of-type { margin-top: 0; }
  .fine { margin-top: var(--s-5); font-size: var(--step-small); }
  .timeline-lite { border-top: 1px solid var(--line-strong); }
  .timeline-lite > li { display: grid; gap: var(--s-2); padding: var(--s-5) 0; border-bottom: 1px solid var(--line); }
  .timeline-lite > li > p.num { font-size: 12.5px; color: var(--muted); padding-top: .3em; }
  .timeline-lite > li > div { display: grid; gap: var(--s-2); }
  .certs { display: grid; gap: 6px; }
  .certs li { font-weight: 500; }
  .certs li::before { content: '— '; color: var(--accent); }
  @media (min-width: 768px) { .timeline-lite > li { grid-template-columns: 200px minmax(0, 1fr); gap: var(--gutter); } }
  .skills { display: grid; border-top: 1px solid var(--line-strong); }
  .skills > div { display: grid; gap: var(--s-2); padding: var(--s-5) 0; border-bottom: 1px solid var(--line); }
  .skills dd { margin: 0; max-width: 70ch; }
  @media (min-width: 768px) { .skills > div { grid-template-columns: 200px minmax(0, 1fr); gap: var(--gutter); } }
</style>
