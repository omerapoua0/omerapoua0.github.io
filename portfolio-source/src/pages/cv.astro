import OmarLayout from '../layouts/OmarLayout.astro';
const roles = [
  { date: 'Jan 2026 to present', company: 'Digis Squared', title: 'AI Product Engineer', text: 'Technical strategy for KATANA, closed-loop MAPE-K reasoning using Bayesian inference, LangGraph workflows, TCO modelling, security auditing and sprint planning.', href: '/work.html#katana' },
  { date: 'Mar 2026 to present', company: 'Southfields Academy', title: 'Mathematics & Physics Teaching Assistant', text: 'Teaching GCSE Higher maths and physics to international and EAL students, with clear explanations of quantitative concepts.', href: '/tutoring.html' },
  { date: 'Feb to May 2026', company: 'Bitget', title: 'AI Product Intern', text: 'Analysed exchange telemetry and developed predictive models using historical and live market data in Platform & Operations.', href: '/work.html#project-2' },
  { date: 'Sep 2024 to Mar 2025', company: 'Digis Squared', title: 'R&D Engineering Trainee', text: 'Researched network systems and the integration of hardware and software.' },
  { date: 'Jun to Sep 2024', company: 'BP', title: 'Market Intelligence Research Intern', text: 'Localised offshore-wind market intelligence models and automated competitor-research reporting.', href: '/work.html#project-3' },
];
---
<OmarLayout title="About & experience" description="AI product engineer, Computer Science and Mathematics student, and maths and science tutor based in London.">
  <section class="page-intro"><p class="eyebrow">About / 04</p><h1>I like making<br />difficult things make sense.</h1><p class="lede">I’m Omar Aboelella. AI product engineer, Computer Science & Mathematics student, and a tutor based in London.</p><div class="form-actions"><a class="button" href="/Omar-Aboelella-CV.pdf" download>Download CV ↓</a><a class="button button-secondary" href="/Omar-Aboelella-CV.pdf" target="_blank" rel="noopener">Open PDF ↗</a></div></section>
  <section class="section grid-2"><div><p class="eyebrow">The common thread</p><h2>Understand it.<br />Build it. Explain it.</h2><p class="lede">Engineering and teaching ask me to do something similar: find the structure inside a difficult problem and make the next step clearer.</p><p>My work spans network autonomy, predictive modelling, market intelligence and learning products. Mathematics is the thread running through it; building is how I test what I understand.</p><p>I speak Arabic natively and English fluently. Longer term, I want to pursue deeper research in optimisation and intelligent systems.</p></div><figure class="portrait-card"><img src="/omar-aboelella.jpg" alt="Omar Aboelella" width="900" height="1200" loading="lazy" /><figcaption>Omar Aboelella / London</figcaption></figure></section>
  <section class="section" id="experience"><div class="section-heading"><p class="eyebrow">Experience</p><h2>The work so far.</h2></div><div class="timeline">{roles.map(role => <article class="timeline-row"><p class="eyebrow">{role.date}</p><div><p class="eyebrow">{role.company}</p><h3>{role.title}</h3><p>{role.text}</p>{role.href && <a href={role.href}>Related work ↗</a>}</div></article>)}<article class="timeline-row"><p class="eyebrow">Incoming / Summer 2027</p><div><p class="eyebrow">Santander</p><h3>Fintech Research Placement</h3><p>Selected for a placement applying mathematical optimisation and machine learning to credit-scoring models. This is upcoming, not completed experience.</p></div></article></div><p class="fine-print">My wider work experience also includes Rapport.</p></section>
  <section class="section grid-2"><div><p class="eyebrow">Education</p><h2>Always a student.</h2><div class="detail-list"><div><p class="eyebrow">Birkbeck, University of London / Expected 2028</p><h3>BSc (Hons) Computer Science & Mathematics</h3><p>Linear algebra, calculus, discrete mathematics, data modelling and analysis, and systems analysis.</p></div><div><p class="eyebrow">Westminster Kingsway / 2025</p><h3>Access to HE Engineering</h3><p>Distinction. Additional qualifications include seven GCSEs, with an A in Mathematics.</p></div></div></div><div class="panel" id="skills"><p class="eyebrow">Toolkit</p><h2>Ideas into systems.</h2><div class="skill-groups"><div class="skill-group"><h3>AI & reasoning</h3><p>LangGraph, multi-agent orchestration, RAG, MAPE-K, Bayesian inference, predictive modelling.</p></div><div class="skill-group"><h3>Software & data</h3><p>Python, NumPy, Pandas, SciPy, FastAPI, Docker, SQL, PostgreSQL, APIs, Git and CI/CD.</p></div><div class="skill-group"><h3>Product & delivery</h3><p>Technical strategy, workflow design, TCO modelling, security auditing, test planning and Jira.</p></div><div class="skill-group"><h3>Mathematics & communication</h3><p>Linear algebra, calculus, probability, optimisation, Excel and LaTeX. Independent study in stochastic processes and Qiskit.</p></div></div></div></section>
</OmarLayout>
